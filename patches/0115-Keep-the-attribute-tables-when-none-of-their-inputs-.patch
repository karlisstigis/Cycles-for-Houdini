+  if (objects) {
+    /* Only these objects: copy the entries that changed. */
+    vector<uint8_t> updated(objects->size());
+    parallel_for(blocked_range<size_t>(0, objects->size(), 1024),
+                 [&](const blocked_range<size_t> &r) {
+                   for (size_t i = r.begin(); i != r.end(); i++) {
+                     updated[i] = update_object((*objects)[i]) ? 1 : 0;
+                   }
+                 });
+    vector<size_t> indices;
+    for (size_t i = 0; i < objects->size(); i++) {
+      if (updated[i]) {
+        indices.push_back(size_t((*objects)[i]->index));
+      }
+    }
+    std::sort(indices.begin(), indices.end());
+    vector<DeviceMemoryRange> ranges;
+    for (const size_t index : indices) {
+      const size_t offset = index * sizeof(KernelObject);
+      if (!ranges.empty() && ranges.back().offset + ranges.back().size == offset) {
+        ranges.back().size += sizeof(KernelObject);
+      }
+      else if (ranges.empty() || ranges.back().offset + ranges.back().size < offset) {
+        ranges.push_back({offset, sizeof(KernelObject)});
+      }
+    }
+    if (!ranges.empty() && !dscene->objects.copy_to_device_ranges(ranges)) {
+      dscene->objects.copy_to_device();
+    }
+    return;
+  }
+
   std::atomic<bool> update = false;
   parallel_for(blocked_range<size_t>(0, scene->objects.size(), 1024),
                [&](const blocked_range<size_t> &r) {

 /* One stored object attribute: where its steps go in the packed tables and
  * where their source values are. */
 struct ObjectAttributeValues {
@@ -1119,11 +1162,202 @@ static bool prepare_object_attribute_requests(
   return true;
 }
 
+/* Attribute tables, maps and requests of the last completed attribute update stay valid when none
+ * of their inputs changed: no geometry other than lights modified (sockets or attributes), no
+ * shader updated in this scene update, no object added, removed, reordered or given another
+ * geometry (the object update's change list is valid, which also requires that every earlier
+ * object update reached a completed geometry update), the same global attribute requests, OSL
+ * mode and geometry count, no attribute or primitive buffer to reallocate, and every changed
+ * object still requesting the same attributes. Then only the changed objects' attribute values
+ * and kernel object offsets are written. Returns false when the full update is needed.
+ * CYCLES_FULL_ATTRIBUTE_TABLES always takes the full update, as a reference. */
+bool GeometryManager::update_attributes_kept(Device *device,
+                                             DeviceScene *dscene,
+                                             Scene *scene,
+                                             Progress &progress)
+{
+  static const bool full_tables = getenv("CYCLES_FULL_ATTRIBUTE_TABLES") != nullptr;
+  ObjectManager *object_manager = scene->object_manager.get();
+  if (full_tables || !attribute_layout_valid || !object_manager->top_level_changed_valid ||
+      scene->shaders_updated_this_update || kept_num_geometry != scene->geometry.size() ||
+      object_attribute_requests.size() != scene->objects.size() ||
+      kept_use_osl != scene->shader_manager->use_osl() ||
+      kept_object_names.size() != scene->geometry.size())
+  {
+    return false;
+  }
+  if (dscene->attributes_map.need_realloc() || dscene->attributes_float.need_realloc() ||
+      dscene->attributes_float2.need_realloc() || dscene->attributes_float3.need_realloc() ||
+      dscene->attributes_float4.need_realloc() || dscene->attributes_uchar4.need_realloc() ||
+      dscene->attributes_normal.need_realloc() || dscene->attributes_quaternion.need_realloc() ||
+      dscene->attributes_spherical_harmonics_rest.need_realloc() ||
+      dscene->tri_verts.need_realloc() || dscene->curve_keys.need_realloc() ||
+      dscene->points.need_realloc())
+  {
+    return false;
+  }
+  for (size_t i = 0; i < scene->geometry.size(); i++) {
+    const Geometry *geom = scene->geometry[i];
+    /* A light edit modifies its light geometry, whose attribute requests depend only on its
+     * shaders. */
+    bool attributes_modified = false;
+    for (int type = 0; type < int(AttrKernelDataType::NUM); type++) {
+      attributes_modified |= geom->attributes.modified(AttrKernelDataType(type));
+    }
+    if (geom->index != i || attributes_modified ||
+        (geom->is_light() ? geom->used_shaders_is_modified() : geom->is_modified()))
+    {
+      return false;
+    }
+  }
+  AttributeRequestSet global_attributes;
+  scene->need_global_attributes(global_attributes);
+  if (global_attributes.modified(kept_global_attributes)) {
+    return false;
+  }
+  const vector<Object *> &changed = object_manager->top_level_changed_objects;
+  size_t table_sizes[int(AttrKernelDataType::NUM)];
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    table_sizes[table] = kept_table_sizes[table];
+    if (object_attribute_table_size(dscene, table) != kept_table_sizes[table]) {
+      return false;
+    }
+  }
+  /* Every changed object still requests the same attributes; then write its values where they
+   * differ. Each object writes only its own table entries, so both run on all cores. */
+  std::atomic<bool> matched = true;
+  parallel_for(blocked_range<size_t>(0, changed.size(), 1024), [&](const blocked_range<size_t> &r) {
+    for (size_t i = r.begin(); i != r.end() && matched.load(std::memory_order_relaxed); i++) {
+      const Object *object = changed[i];
+      if (size_t(object->index) >= scene->objects.size() ||
+          scene->objects[object->index] != object ||
+          !match_object_attributes(scene,
+                                   *object,
+                                   kept_object_names,
+                                   object_attribute_requests[object->index],
+                                   table_sizes,
+                                   [](const ObjectAttributeValues &) {}))
+      {
+        matched = false;
+      }
+    }
+  });
+  if (!matched) {
+    return false;
+  }
+
+  char *tables[int(AttrKernelDataType::NUM)];
+  std::atomic<bool> table_modified[int(AttrKernelDataType::NUM)];
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    tables[table] = object_attribute_table_data(dscene, table);
+    table_modified[table] = false;
+  }
+  parallel_for(blocked_range<size_t>(0, changed.size(), 1024), [&](const blocked_range<size_t> &r) {
+    for (size_t i = r.begin(); i != r.end(); i++) {
+      const Object *object = changed[i];
+      match_object_attributes(
+          scene,
+          *object,
+          kept_object_names,
+          object_attribute_requests[object->index],
+          table_sizes,
+          [&](const ObjectAttributeValues &values) {
+            char *dst = tables[values.table] + values.offset_bytes;
+            for (int step = 0; step <= values.steps; step++) {
+              const char *src = step == 0 ? static_cast<const char *>(values.param->data()) :
+                                            static_cast<const char *>(values.sampled->data()) +
+                                                (step - 1) * values.step_bytes;
+              char *step_dst = dst + step * values.step_bytes;
+              if (memcmp(step_dst, src, values.step_bytes) != 0) {
+                memcpy(step_dst, src, values.step_bytes);
+                table_modified[values.table] = true;
+              }
+            }
+          });
+    }
+  });
+  bool modified[int(AttrKernelDataType::NUM)];
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    modified[table] = table_modified[table];
+  }
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    if (modified[table]) {
+      copy_object_attribute_table(dscene, table);
+    }
+  }
+  if (progress.get_cancel()) {
+    return true;
+  }
+
+  /* Kernel object offsets: the transforms step rewrote the entries of the objects it wrote. */
+  if (object_manager->object_table_written == ObjectManager::OBJECT_TABLE_FULL) {
+    object_manager->device_update_geom_offsets(device, dscene, scene);
+  }
+  else if (object_manager->object_table_written == ObjectManager::OBJECT_TABLE_PARTIAL) {
+    object_manager->device_update_geom_offsets(device, dscene, scene, &changed);
+  }
+  if (scene->update_stats) {
+    /* Counts, not times. */
+    scene->update_stats->geometry.times.add_entry({"kept attribute tables updates", 1.0});
+  }
+  return true;
+}
+
 void GeometryManager::device_update_attributes(Device *device,
                                                DeviceScene *dscene,
                                                Scene *scene,
                                                Progress &progress)
 {
+  {
+    /* CYCLES_VERIFY_ATTRIBUTE_TABLES: after keeping the tables, run the full update and compare
+     * the host tables, map and kernel objects with the kept ones, then every device copy with the
+     * host; any difference is a scene update error. */
+    static const bool verify_tables = getenv("CYCLES_VERIFY_ATTRIBUTE_TABLES") != nullptr;
+    if (update_attributes_kept(device, dscene, scene, progress)) {
+      if (!verify_tables || progress.get_cancel()) {
+        return;
+      }
+      const auto snapshot = [](device_memory &mem) {
+        const char *data = static_cast<const char *>(mem.host_pointer);
+        return vector<char>(data, data + (data ? mem.memory_size() : 0));
+      };
+      device_memory *mems[] = {&dscene->attributes_map,
+                               &dscene->attributes_float,
+                               &dscene->attributes_float2,
+                               &dscene->attributes_float3,
+                               &dscene->attributes_float4,
+                               &dscene->attributes_uchar4,
+                               &dscene->attributes_normal,
+                               &dscene->attributes_quaternion,
+                               &dscene->attributes_spherical_harmonics_rest,
+                               &dscene->objects};
+      vector<vector<char>> kept;
+      for (device_memory *mem : mems) {
+        kept.push_back(snapshot(*mem));
+      }
+      string difference;
+      for (device_memory *mem : mems) {
+        if (mem->host_pointer && mem->device_pointer &&
+            !device->verify_device_copy(*mem, difference))
+        {
+          progress.set_error("Attribute table verification failed: " + difference);
+          return;
+        }
+      }
+      attribute_layout_valid = false; /* Force the full update below. */
+      device_update_attributes(device, dscene, scene, progress);
+      for (size_t i = 0; i < kept.size() && !progress.get_error(); i++) {
+        if (kept[i] != snapshot(*mems[i])) {
+          progress.set_error(string("Attribute table verification failed: ") +
+                             mems[i]->global_name() + " differs from the full update");
+        }
+      }
+      if (scene->update_stats) {
+        scene->update_stats->geometry.times.add_entry({"attribute table verifications", 1.0});
+      }
+      return;
+    }
+  }
   progress.set_status("Updating Mesh", "Computing attributes");
 
   /* gather per mesh requested attributes. as meshes may have multiple
@@ -1552,6 +1786,22 @@ void GeometryManager::device_update_attributes(Device *device,
     }
     object_attribute_requests = std::move(object_attributes);
   }
+  /* Inputs of this completed update, for keeping its tables (see update_attributes_kept). */
+  kept_global_attributes = global_attributes;
+  kept_use_osl = scene->shader_manager->use_osl();
+  kept_num_geometry = scene->geometry.size();
+  kept_object_names.assign(scene->geometry.size(), {});
+  for (size_t i = 0; i < scene->geometry.size(); i++) {
+    const Geometry *geom = scene->geometry[i];
+    for (const AttributeRequest &req : geom_attributes[i].requests) {
+      if (!geom->attributes.find(req.name)) {
+        kept_object_names[i].push_back(req.name);
+      }
+    }
+  }
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    kept_table_sizes[table] = object_attribute_table_size(dscene, table);
+  }
   attribute_layout_valid = true;
 }
 

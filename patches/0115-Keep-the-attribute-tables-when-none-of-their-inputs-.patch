+static size_t object_attribute_table_size(const DeviceScene *dscene, const int table)
+{
+  switch (AttrKernelDataType(table)) {
+    case AttrKernelDataType::FLOAT:
+      return dscene->attributes_float.size();
+    case AttrKernelDataType::FLOAT2:
+      return dscene->attributes_float2.size();
+    case AttrKernelDataType::FLOAT4:
+      return dscene->attributes_float4.size();
+    case AttrKernelDataType::QUATERNION:
+      return dscene->attributes_quaternion.size();
+    case AttrKernelDataType::SPHERICAL_HARMONICS_REST:
+      return dscene->attributes_spherical_harmonics_rest.size();
+    default:
+      return dscene->attributes_float3.size();
+  }
+}
+
+static void copy_object_attribute_table(DeviceScene *dscene, const int table)
+{
+  switch (AttrKernelDataType(table)) {
+    case AttrKernelDataType::FLOAT:
+      dscene->attributes_float.copy_to_device();
+      break;
+    case AttrKernelDataType::FLOAT2:
+      dscene->attributes_float2.copy_to_device();
+      break;
+    case AttrKernelDataType::FLOAT4:
+      dscene->attributes_float4.copy_to_device();
+      break;
+    case AttrKernelDataType::QUATERNION:
+      dscene->attributes_quaternion.copy_to_device();
+      break;
+    case AttrKernelDataType::SPHERICAL_HARMONICS_REST:
+      dscene->attributes_spherical_harmonics_rest.copy_to_device();
+      break;
+    default:
+      dscene->attributes_float3.copy_to_device();
+      break;
+  }
+}

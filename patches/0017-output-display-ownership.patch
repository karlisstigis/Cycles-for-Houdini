Rationale: A host presenting float output can suppress the otherwise redundant display update through an explicit driver ownership query.
Contract: output display ownership
Tests: tests/houdini_progressive_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/integrator/path_trace.cpp b/src/integrator/path_trace.cpp
index 782e9e78636d2ffb796dba6efab980da9e923457..fed7fe237bd55bbc55426b0c5b6af00d16a780d4 100644
--- a/src/integrator/path_trace.cpp
+++ b/src/integrator/path_trace.cpp
@@ -801,7 +801,7 @@ void PathTrace::update_display(const RenderWork &render_work)
     output_driver_->update_render_tile(tile);
   }
 
-  if (display_) {
+  if (display_ && (!output_driver_ || output_driver_->need_display_update())) {
     LOG_DEBUG << "Perform copy to GPUDisplay work.";
 
     const PassType pass_type = film_->get_display_pass();
diff --git a/src/session/output_driver.h b/src/session/output_driver.h
index 335f659d4513656d028857bfde9c47e280311e8a..91d723a3e13ad4158107ce1d7d3976b9c610594c 100644
--- a/src/session/output_driver.h
+++ b/src/session/output_driver.h
@@ -61,6 +61,13 @@ class OutputDriver {
     return false;
   }
 
+  /* Hosts which display float output themselves may suppress the redundant
+   * DisplayDriver transfer. Existing clients retain their normal display path. */
+  virtual bool need_display_update() const
+  {
+    return true;
+  }
+
   /* For baking, read render pass PASS_BAKE_PRIMITIVE/SEED/DIFFERENTIAL
    * to determine which shading points to use for baking at each pixel. Return
    * true if any data was read. */

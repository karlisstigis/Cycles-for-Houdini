diff --git a/src/scene/light_tree_emission.h b/src/scene/light_tree_emission.h
new file mode 100644
index 0000000000000000000000000000000000000000..c4abcf0c62ba64423e17265d6d2c854bd8c3a379
--- /dev/null
+++ b/src/scene/light_tree_emission.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "util/math.h"
+#include <cstdint>
+#include <cstring>
+
+CCL_NAMESPACE_BEGIN
+
+/* Mesh-local construction consumes this scalar, not emission chromaticity.
+ * Keep the key and triangle measure on the exact same calculation. */
+inline float light_tree_emission_energy(const float3 &estimate)
+{
+  /* Cycles builds with fast FP. A rounded scalar must cross this boundary
+   * before the area multiply, rather than allowing it into the RGB sum. */
+  const volatile float energy = average(fabs(estimate));
+  return energy;
+}
+
+struct LightTreeEmissionKey {
+  int sampling;
+  uint32_t energy_bits;
+  LightTreeEmissionKey(const int sampling, const float energy) : sampling(sampling)
+  {
+    std::memcpy(&energy_bits, &energy, sizeof(energy_bits));
+  }
+  bool operator==(const LightTreeEmissionKey &other) const
+  {
+    /* Integer comparison retains exactness even with compiler finite-math
+     * assumptions. Non-finite values cannot certify reusable source data. */
+    return sampling == other.sampling && (energy_bits & 0x7f800000u) != 0x7f800000u &&
+           energy_bits == other.energy_bits;
+  }
+};
+
+inline LightTreeEmissionKey light_tree_emission_key(const int sampling, const float3 &estimate)
+{
+  return {sampling, light_tree_emission_energy(estimate)};
+}
+
+CCL_NAMESPACE_END

diff --git a/src/kernel/camera/image_iris.h b/src/kernel/camera/image_iris.h
new file mode 100644
index 0000000000000000000000000000000000000000..ebdd3b12688e67e6dd39d26f525d1af3bcb22caf
--- /dev/null
+++ b/src/kernel/camera/image_iris.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+CCL_NAMESPACE_BEGIN
+
+/* Packed resource: width, height, padded hierarchy side, reserved, pixel offset,
+ * conditional CDF offset, marginal CDF offset, hierarchy offset. The hierarchy
+ * stores square levels root first. Image vertices define bilinear cells.
+ * Both mappings consume only the camera's original two lens dimensions. */
+ccl_device_inline float image_iris_linear_sample(const float u, const float a, const float b)
+{
+  const float denominator = a + sqrtf((1.0f - u) * a * a + u * b * b);
+  return denominator > 0.0f ? saturatef(u * (a + b) / denominator) : u;
+}
+
+template<typename Table>
+ccl_device_inline int image_iris_cdf_sample(const Table &table,
+                                            const int offset,
+                                            const int count,
+                                            ccl_private float &u)
+{
+  /* upper_bound skips zero-mass intervals, including an empty leading row. */
+  int first = 0, last = count;
+  while (first < last) {
+    const int middle = (first + last) / 2;
+    if (table(offset + middle + 1) <= u) first = middle + 1;
+    else last = middle;
+  }
+  const int index = min(first, count - 1);
+  const float low = table(offset + index), high = table(offset + index + 1);
+  u = high > low ? saturatef((u - low) / (high - low)) : 0.5f;
+  return index;
+}
+
+template<typename Table>
+ccl_device_inline float2 image_iris_sample(const Table &table,
+                                          const int method,
+                                          const float2 random)
+{
+  const int width = int(table(0)), height = int(table(1));
+  const int cells_x = width - 1, cells_y = height - 1;
+  /* Cycles lens values are half-open. Keep diagnostics and rounded remaps safe. */
+  float u = clamp(random.x, 0.0f, 0.99999994f);
+  float v = clamp(random.y, 0.0f, 0.99999994f);
+  int x = 0, y = 0;
+  if (method == 2) {
+    const int side = int(table(2));
+    int level_width = 1, offset = int(table(7));
+    while (level_width < side) {
+      offset += level_width * level_width;
+      level_width *= 2;
+      x *= 2;
+      y *= 2;
+      const int child = offset + y * level_width + x;
+      const float a = table(child), b = table(child + 1);
+      const float c = table(child + level_width), d = table(child + level_width + 1);
+      const float upper = a + b, lower = c + d;
+      const float row_probability = upper / (upper + lower);
+      const bool second_row = v >= row_probability;
+      if (second_row) {
+        ++y;
+        v = (v - row_probability) / (1.0f - row_probability);
+      }
+      else v /= row_probability;
+      const float left = second_row ? c : a, right = second_row ? d : b;
+      const float column_probability = left / (left + right);
+      if (u >= column_probability) {
+        ++x;
+        u = (u - column_probability) / (1.0f - column_probability);
+      }
+      else u /= column_probability;
+      u = clamp(u, 0.0f, 0.99999994f);
+      v = clamp(v, 0.0f, 0.99999994f);
+    }
+  }
+  else {
+    y = image_iris_cdf_sample(table, int(table(6)), cells_y, v);
+    x = image_iris_cdf_sample(table, int(table(5)) + y * (cells_x + 1), cells_x, u);
+  }
+  const int pixel = int(table(4)) + y * width + x;
+  const float a = table(pixel), b = table(pixel + 1);
+  const float c = table(pixel + width), d = table(pixel + width + 1);
+  /* Exact bilinear patch inverse: first its linear Y marginal, then X|Y. */
+  v = image_iris_linear_sample(v, a + b, c + d);
+  u = image_iris_linear_sample(u, mix(a, c, v), mix(b, d, v));
+  return make_float2((float(x) + u) / float(cells_x),
+                     (float(y) + v) / float(cells_y));
+}
+
+CCL_NAMESPACE_END

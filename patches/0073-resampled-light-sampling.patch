+ccl_device_inline float pt_ris_forward_lamp_weight(KernelGlobals kg,
+                                                   IntegratorState state,
+                                                   const PathRayVisibility path_visibility,
+                                                   const uint32_t path_flag,
+                                                   const int object_id,
+                                                   const int lamp,
+                                                   const float3 P,
+                                                   const float native_weight)
+{
+  if (!kernel_data.integrator.pt_ris_mode || !INTEGRATOR_STATE(state, path, pt_ris_marker) ||
+      (path_flag & PATH_RAY_MIS_SKIP) ||
+      !pt_ris_light_eligible(kg, lamp, INTEGRATOR_STATE(state, path, pt_ris_marker) == 1))
+  {
+    return native_weight;
+  }

+/* Clamp the native-equivalent value X*k (threshold c/k) and keep the importance weight.
+ * k = 1 unless Resampled Light Sampling selected the shadow-path sample. */
+ccl_device_forceinline void film_clamp_light_scaled(KernelGlobals kg,
+                                                    ccl_private Spectrum *L,
+                                                    const int bounce,
+                                                    const float k)
+{
+  if (k == 1.0f) {
+    film_clamp_light(kg, L, bounce);
+    return;
+  }
+  *L *= k;
+  film_clamp_light(kg, L, bounce);
+  *L /= k;
+}

diff --git a/src/kernel/integrator/pt_ris_nee.h b/src/kernel/integrator/pt_ris_nee.h
new file mode 100644
index 0000000000000000000000000000000000000000..068a57fd9ddd98dea93751eb3948aaac057e5b27
--- /dev/null
+++ b/src/kernel/integrator/pt_ris_nee.h
@@ -0,0 +1,322 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Resampled Light Sampling (RIS next-event estimation), Cycles Houdini integration.
+ * Selection part, used by integrate_surface_direct_light(). Candidates: light samples on the
+ * selected light plus BSDF directions intersected with it, resampled by the unshadowed
+ * contribution (Talbot et al. 2005; unbiased contribution weight, balance-heuristic candidate MIS). */
+#pragma once
+/* Included inside CCL_NAMESPACE by shade_surface.h (after pt_ris_nee_common.h). */
+
+struct PTRisResult {
+  int used;        /* 1 when the returned LightSample came from RIS */
+  float mis;       /* NEE partition weight w_N(Y) that replaces the native NEE MIS weight */
+  float clamp_k;   /* shadow film clamp factor 1/r (native-equivalent clamping) */
+};
+
+ccl_device_inline PTRisResult pt_ris_result_none()
+{
+  PTRisResult r;
+  r.used = 0;
+  r.mis = 1.0f;
+  r.clamp_k = 1.0f;
+  return r;
+}
+
+/* Mode of the vertex (see pt_ris_vertex_mode_at). */
+ccl_device_inline int pt_ris_vertex_mode(KernelGlobals kg,
+                                         ConstIntegratorState state,
+                                         const ccl_private ShaderData *sd)
+{
+  if (kernel_data.integrator.pt_ris_mode == 0) {
+    return 0;
+  }
+  /* Huang hair returns a placeholder MIS PDF, not its directional sampling density.
+   * It cannot participate in the RIS candidate mixture. Keep the entire vertex native,
+   * including the forward lamp-hit partition written by integrate_surface_bsdf_bssrdf_bounce.
+   * A mixed material must also fall back: every closure contributes to the candidate PDF. */
+  for (int i = 0; i < sd->num_closure; i++) {
+    if (sd->closure[i].type == CLOSURE_BSDF_HAIR_HUANG_ID) {
+      return 0;
+    }
+  }
+#ifdef __MNEE__
+  /* MNEE already sampled the light at this vertex: native NEE, native forward weights. */
+  if ((kernel_data.kernel_features & KERNEL_FEATURE_MNEE) &&
+      (INTEGRATOR_STATE(state, path, mnee) & PATH_MNEE_SAMPLED))
+  {
+    return 0;
+  }
+#endif
+  return pt_ris_vertex_mode_at(kg,
+                               int(INTEGRATOR_STATE(state, path, bounce)),
+                               sd->runtime_flag,
+                               INTEGRATOR_STATE(state, path, flag),
+                               sd->object_flag);
+}
+
+/* BSDF candidate: intersect the chosen lamp only and fill a LightSample like the native
+ * sampler would for that point (pdf with the same transmission convention as the sampler). */
+ccl_device_inline bool pt_ris_bsdf_candidate_on_lamp(KernelGlobals kg,
+                                                     const ccl_global KernelLight *klight,
+                                                     const int lamp,
+                                                     const float3 P,
+                                                     const float3 N,
+                                                     const float3 D,
+                                                     const int runtime_flags,
+                                                     ccl_private LightSample *c)
+{
+  Ray ray ccl_optional_struct_init;
+  ray.P = P;
+  ray.D = D;
+  ray.tmin = 0.0f;
+  ray.tmax = FLT_MAX;
+  float t = 0.0f;
+  LightEval le;
+  const uint32_t pf = (runtime_flags & SR_BSDF_HAS_TRANSMISSION) ? PATH_RAY_MIS_HAD_TRANSMISSION : 0u;
+  if (klight->type == LIGHT_AREA) {
+    if (!area_light_intersect(klight, &ray, &t)) {
+      return false;
+    }
+    le = area_light_eval_from_intersection(klight, P, D, t);
+    c->Ng = klight->area.dir;
+    c->P = P + D * t;
+  }
+  else if (klight->type == LIGHT_POINT || klight->type == LIGHT_SPOT) {
+    const bool hit = (klight->type == LIGHT_SPOT) ? spot_light_intersect(klight, &ray, &t) :
+                                                    point_light_intersect(klight, &ray, &t);
+    if (!hit) {
+      return false;
+    }
+    le = (klight->type == LIGHT_SPOT) ? spot_light_eval_from_intersection(kg, klight, P, D, t, N, pf) :
+                                        point_light_eval_from_intersection(klight, P, D, t, N, pf);
+    c->P = P + D * t;
+    if (klight->spot.is_sphere) {
+      c->Ng = normalize(c->P - klight->co);
+      c->P = c->Ng * klight->spot.radius + klight->co;
+    }
+    else {
+      c->Ng = -D;
+    }
+  }
+  else {
+    return false;
+  }
+  if (!(le.eval_fac > 0.0f) || !(le.pdf > 0.0f)) {
+    return false;
+  }
+  c->type = LightType(klight->type);
+  c->shader = klight->shader_id;
+  c->object = klight->object_id;
+  c->prim = lamp;
+  c->group = object_lightgroup(kg, c->object);
+  c->t = t;
+  c->D = D;
+  c->eval_fac = le.eval_fac;
+  c->pdf = le.pdf;
+  return true;
+}
+
+/* Full one-loop evaluation at direction wo: native mixture eval f (with light
+ * exclusions), native MIS pdf (Cycles one-sample model incl. BSSRDF weight) and the
+ * density of the RIS BSDF-candidate technique (closure pick pi_i, then its pdf). */
+ccl_device_inline void pt_ris_bsdf_eval(KernelGlobals kg,
+                                        ccl_private ShaderData *sd,
+                                        const float3 wo,
+                                        const uint light_shader_flags,
+                                        const float sum_bsdf_weight,
+                                        const float inv_bsdf_count,
+                                        ccl_private BsdfEval *f,
+                                        ccl_private float *pdf_mis,
+                                        ccl_private float *pdf_candidate)
+{
+  bsdf_eval_init(f, zero_spectrum());
+  float sum_pdf = 0.0f, sum_sample_weight = 0.0f, cand = 0.0f;
+  for (int i = 0; i < sd->num_closure; i++) {
+    const ccl_private ShaderClosure *sc = &sd->closure[i];
+    if (!CLOSURE_IS_BSDF_OR_BSSRDF(sc->type)) {
+      continue;
+    }
+    if (CLOSURE_IS_BSDF(sc->type)) {
+      float pdf = 0.0f;
+      const Spectrum eval = bsdf_eval(kg, sd, sc, wo, &pdf);
+      if (pdf != 0.0f) {
+        if (!_surface_shader_exclude(sc->type, light_shader_flags)) {
+          bsdf_eval_accum(f, sc, wo, eval * sc->weight);
+        }
+        sum_pdf += pdf * sc->sample_weight;
+        const float pi = 0.5f * sc->sample_weight / sum_bsdf_weight + 0.5f * inv_bsdf_count;
+        cand += pi * pdf;
+      }
+    }
+    sum_sample_weight += sc->sample_weight;
+  }
+  *pdf_mis = (sum_sample_weight > 0.0f) ? sum_pdf / sum_sample_weight : 0.0f;
+  *pdf_candidate = cand;
+}
+
+/* Light selection exactly as native light_sample_from_position, then RIS over
+ * candidates on the selected light when it is eligible. Falls back to the native
+ * sample on the already selected emitter otherwise. */
+ccl_device bool pt_ris_light_sample_from_position(KernelGlobals kg,
+                                                  IntegratorState state,
+                                                  ccl_private ShaderData *sd,
+                                                  const ccl_private RNGState *rng_state,
+                                                  ccl_private PTRisResult *res,
+                                                  const float3 rand,
+                                                  const float time,
+                                                  const float3 P,
+                                                  const float3 N,
+                                                  const int object_receiver,
+                                                  const int runtime_flags,
+                                                  const int bounce,
+                                                  const uint32_t path_flag,
+                                                  ccl_private LightSample *ls)
+{
+  const int mode = pt_ris_vertex_mode(kg, state, sd);
+  if (mode != 0) {
+    bool picked;
+#  ifdef __LIGHT_TREE__
+    if (kernel_data.integrator.use_light_tree) {
+      picked = light_tree_sample<false>(kg, rand.z, P, N, 0.0f, object_receiver, runtime_flags, ls);
+    }
+    else
+#  endif
+    {
+      picked = light_distribution_sample(kg, rand.z, ls);
+    }
+    if (!picked) {
+      return false;
+    }
+
+    int prim, object_id;
+#  ifdef __LIGHT_TREE__
+    if (kernel_data.integrator.use_light_tree) {
+      const ccl_global KernelLightTreeEmitter *kemitter = &kernel_data_fetch(light_tree_emitters,
+                                                                             ls->emitter_id);
+      prim = kemitter->light.id;
+      object_id = (prim >= 0) ? ls->object : kemitter->object_id;
+    }
+    else
+#  endif
+    {
+      const ccl_global KernelLightDistribution *kdistribution = &kernel_data_fetch(
+          light_distribution, ls->emitter_id);
+      prim = kdistribution->prim;
+      object_id = kdistribution->object_id;
+    }
+
+    const int lamp = ~prim;
+    if (prim >= 0 || !pt_ris_light_eligible(kg, lamp, pt_ris_vertex_caustics_ok(sd->object_flag))) {
+      /* Native single-sample NEE on the emitter selected above (same random numbers). */
+      return light_sample<false>(
+          kg, rand, time, P, N, object_receiver, runtime_flags, bounce, path_flag, ls);
+    }
+    if (!light_link_object_match(kg, object_receiver, object_id) ||
+        light_select_reached_max_bounces(kg, lamp, bounce))
+    {
+      return false;
+    }
+
+    const ccl_global KernelLight *klight = &kernel_data_fetch(lights, lamp);
+    const float selection = ls->pdf_selection;
+    const bool full = (mode == PT_RIS_MODE_FULL);
+    const int ML = kernel_data.integrator.pt_ris_ml;
+    const int MB = kernel_data.integrator.pt_ris_mb;
+
+    float sum_bsdf_weight = 0.0f;
+    int bsdf_count = 0;
+    for (int i = 0; i < sd->num_closure; i++) {
+      if (CLOSURE_IS_BSDF(sd->closure[i].type) && sd->closure[i].sample_weight > 0.0f) {
+        sum_bsdf_weight += sd->closure[i].sample_weight;
+        bsdf_count++;
+      }
+    }
+    const float inv_bsdf_count = (bsdf_count > 0) ? 1.0f / float(bsdf_count) : 0.0f;
+
+    uint lcg = lcg_state_init(rng_state->rng_pixel,
+                              rng_state->rng_offset,
+                              uint(rng_state->sample),
+                              0x52495331u ^ (uint(bounce) * 0x9e3779b9u));
+
+    LightSample sel = *ls;
+    float sel_phat = 0.0f, sel_mis = 0.0f, wsum = 0.0f;
+    const int total = ML + ((bsdf_count > 0) ? MB : 0);
+    const float mb_eff = (bsdf_count > 0) ? float(MB) : 0.0f;
+
+    for (int j = 0; j < total; j++) {
+      LightSample c = *ls;
+      bool valid;
+      if (j < ML) {
+        const float2 r2 = (j == 0) ? make_float2(rand.x, rand.y) :
+                                     make_float2(lcg_step_float(&lcg), lcg_step_float(&lcg));
+        valid = light_sample<false>(kg, lamp, r2, P, N, runtime_flags, path_flag, &c);
+      }
+      else {
+        /* BSDF candidate: pick a closure with pi_i, sample it, intersect light lamp only. */
+        float u = lcg_step_float(&lcg);
+        const float3 r3 = make_float3(lcg_step_float(&lcg), lcg_step_float(&lcg), lcg_step_float(&lcg));
+        const ccl_private ShaderClosure *sc = nullptr;
+        for (int i = 0; i < sd->num_closure; i++) {
+          const ccl_private ShaderClosure *s = &sd->closure[i];
+          if (!CLOSURE_IS_BSDF(s->type) || !(s->sample_weight > 0.0f)) {
+            continue;
+          }
+          const float pi = 0.5f * s->sample_weight / sum_bsdf_weight + 0.5f * inv_bsdf_count;
+          sc = s;
+          if (u < pi) {
+            break;
+          }
+          u -= pi;
+        }
+        valid = false;
+        if (sc) {
+          Spectrum eval = zero_spectrum();
+          float3 wo;
+          float pdf = 0.0f, eta = 1.0f;
+          float2 rough;
+          const int label = bsdf_sample(kg, sd, sc, r3, &eval, &wo, &pdf, &rough, &eta);
+          if (pdf > 0.0f && !(label & LABEL_SINGULAR) && !(label & LABEL_TRANSPARENT)) {
+            valid = pt_ris_bsdf_candidate_on_lamp(kg, klight, lamp, P, N, normalize(wo), runtime_flags, &c);
+          }
+        }
+      }
+      if (!valid || !(c.eval_fac > 0.0f)) {
+        continue;
+      }
+      BsdfEval f;
+      float pdf_mis, pdf_cand;
+      pt_ris_bsdf_eval(kg, sd, c.D, c.shader, sum_bsdf_weight, inv_bsdf_count, &f, &pdf_mis, &pdf_cand);
+      const float wN = full ? 1.0f : light_sample_mis_weight_nee(kg, selection * c.pdf, pdf_mis);
+      const float phat = reduce_add(fabs(bsdf_eval_sum(&f))) * c.eval_fac * wN;
+      const float denom = float(ML) * c.pdf + mb_eff * pdf_cand;
+      if (!(phat > 0.0f) || !(denom > 0.0f) || !isfinite_safe(phat / denom)) {
+        continue;
+      }
+      const float w = phat / denom;
+      wsum += w;
+      if (lcg_step_float(&lcg) * wsum < w) {
+        sel = c;
+        sel_phat = phat;
+        sel_mis = wN;
+      }
+    }
+
+    if (!(wsum > 0.0f) || !(sel_phat > 0.0f)) {
+      return false;
+    }
+    const float W = wsum / sel_phat;
+    res->used = 1;
+    res->mis = sel_mis;
+    /* r = p_L(Y) * W. Native-partition vertices clamp the native-equivalent value. */
+    res->clamp_k = full ? 1.0f : 1.0f / (sel.pdf * W);
+    if (!isfinite_safe(res->clamp_k) || !(res->clamp_k > 0.0f)) {
+      res->clamp_k = 1.0f;
+    }
+    *ls = sel;
+    ls->pdf_selection = selection;
+    ls->pdf = selection / W;
+    return ls->pdf > 0.0f;
+  }
+  return light_sample_from_position(
+      kg, rand, time, P, N, object_receiver, runtime_flags, bounce, path_flag, ls);
+}
diff --git a/src/kernel/integrator/pt_ris_nee_common.h b/src/kernel/integrator/pt_ris_nee_common.h
new file mode 100644
index 0000000000000000000000000000000000000000..74b28342709ee8707e333ea17741b4c8f7753c3b
--- /dev/null
+++ b/src/kernel/integrator/pt_ris_nee_common.h
@@ -0,0 +1,126 @@
+/* SPDX-License-Identifier: Apache-2.0
+ *
+ * Resampled Light Sampling (RIS next-event estimation), Cycles Houdini integration.
+ * Shared part: light eligibility, vertex mode and the forward (BSDF-hit) MIS weight.
+ * Off unless kernel_data.integrator.pt_ris_mode != 0 (Integrator socket pt_ris_nee). CPU and GPU. */
+#pragma once
+CCL_NAMESPACE_BEGIN
+
+#define PT_RIS_MODE_FULL 1   /* bounce 0: NEE-RIS carries all direct light of eligible lights */
+#define PT_RIS_MODE_NATIVE 2 /* native NEE/BSDF partition everywhere */
+
+/* Lights handled by RIS. Everything else keeps native single-sample NEE and native
+ * forward weights (per-light fallback):
+ *  - area lights, and point/spot/sphere lights with radius > 0;
+ *  - MIS on, no per-ray-type exclusions;
+ *  - any emission shader: textured/IES/node emission use the untextured eval_fac in the RIS
+ *    target and are shaded exactly only for the selected sample (native NEE/shadow path);
+ *  - light linking and shadow linking supported (receiver sets via light selection,
+ *    blocker sets via the native shadow ray, dedicated-light forward weight wrapped);
+ *  - MNEE caustic lights: everywhere except at MNEE caster/receiver vertices (native there). */
+/* Caustic (MNEE) lights are covered by RLS only at vertices that are neither MNEE casters nor
+ * receivers; there native NEE (and the native forward weight) is kept for them. */
+ccl_device_inline bool pt_ris_vertex_caustics_ok(const int object_flag)
+{
+  return !(object_flag & (SD_OBJECT_CAUSTICS_CASTER | SD_OBJECT_CAUSTICS_RECEIVER));
+}
+
+ccl_device_inline bool pt_ris_light_eligible(KernelGlobals kg, const int lamp, const bool caustics_ok)
+{
+  const ccl_global KernelLight *klight = &kernel_data_fetch(lights, lamp);
+  if (klight->type == LIGHT_POINT || klight->type == LIGHT_SPOT) {
+    if (!(klight->spot.radius > 0.0f)) {
+      return false;
+    }
+  }
+  else if (klight->type != LIGHT_AREA) {
+    return false;
+  }
+  const int shader = klight->shader_id;
+  /* Camera and volume-scatter exclusions do not affect surface NEE; diffuse/glossy/transmission
+   * exclusions are honoured by pt_ris_bsdf_eval (closure masking with the light shader flags),
+   * exactly as native NEE does. Only the shadow-catcher exclusion keeps the native path. */
+  if (!(shader & SHADER_USE_MIS) || (shader & SHADER_EXCLUDE_SHADOW_CATCHER)) {
+    return false;
+  }
+#ifdef __MNEE__
+  if ((kernel_data.kernel_features & KERNEL_FEATURE_MNEE) && klight->use_caustics && !caustics_ok) {
+    return false;
+  }
+#endif
+  return true;
+}
+
+/* Partition mode at a surface vertex. Called both at NEE time and when the bounce writes
+ * mis_ray_pdf (bounce not yet incremented), so both sides always agree. */
+ccl_device_inline int pt_ris_vertex_mode_at(KernelGlobals kg,
+                                            const int bounce,
+                                            const int runtime_flag,
+                                            const uint32_t path_flag,
+                                            const int object_flag)
+{
+  const int mode = kernel_data.integrator.pt_ris_mode;
+  if (mode == 0) {
+    return 0;
+  }
+  /* Shadow catcher: its passes are ratios of split-path estimates whose finite-sample value

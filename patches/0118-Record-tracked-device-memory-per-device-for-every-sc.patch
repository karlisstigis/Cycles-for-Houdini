 src/scene/geometry.cpp           |  9 +++++
 src/scene/scene.cpp              | 60 ++++++++++++++++++++++++++++++++
 src/scene/scene.h                | 36 +++++++++++++++++++
 src/util/stats.h                 | 39 +++++++++++++++++++--
 8 files changed, 169 insertions(+), 2 deletions(-)


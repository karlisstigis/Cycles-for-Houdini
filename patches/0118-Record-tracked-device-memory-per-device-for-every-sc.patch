diff --git a/src/device/optix/device_impl.cpp b/src/device/optix/device_impl.cpp
index fc76098e5c57d4bd43a8a0e7311d71462fc4f22c..720946118c802511adf54fbaccbc424a7dc919bc 100644
--- a/src/device/optix/device_impl.cpp
+++ b/src/device/optix/device_impl.cpp
@@ -1413,6 +1413,9 @@ bool OptiXDevice::build_optix_bvh(BVHOptiX *bvh,
     temp_mem_ptr = bvh_build_temp_mem.get();
   }
   device_only_memory<char> &temp_mem = *temp_mem_ptr;
+  if (temp_mem.device_pointer) {
+    stats.update_build(sizes.tempSizeInBytes, temp_size, reuse_temp);
+  }
   if (!temp_mem.device_pointer) {
     /* Make sure temporary memory allocation succeeded. */
     if (reuse_temp) {
@@ -2503,6 +2506,12 @@ void OptiXDevice::release_bvh_build_memory()
   bvh_build_temp_mem.reset();
 }
 
+size_t OptiXDevice::kept_build_temp_bytes()
+{
+  thread_scoped_lock lock(bvh_build_mutex);
+  return bvh_build_temp_mem ? bvh_build_temp_mem->device_size : 0;
+}
+
 void OptiXDevice::free_bvh_memory_delayed()
 {

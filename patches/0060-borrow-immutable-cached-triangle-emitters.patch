+LightTreeEmitterView LightTree::emitter(const int index, LightTreeTriangleReader &reader) const
+{
+  if (index < 0 || size_t(index) >= num_emitters()) {
+    throw std::runtime_error("Light-tree emitter index exceeds its logical owner");
+  }
+  int dense_index;
+  if (index < triangle_emitters_) {
+    auto found = std::upper_bound(triangle_spans_.begin(), triangle_spans_.end(), index,
+                                  [](int value, const EmitterSpan &span) { return value < span.first; });
+    if (found == triangle_spans_.begin()) {
+      throw std::runtime_error("Missing logical mesh-light emitter span");
+    }
+    --found;
+    const int local = index - found->first;
+    if (local < 0 || local >= found->count) {
+      throw std::runtime_error("Mesh-light emitter span is incomplete");
+    }
+    if (found->cached) {
+      return mesh_cache_->triangle(*found->cached, local, found->object_id, reader);
+    }
+    dense_index = found->dense_first + local;
+  }
+  else {
+    dense_index = dense_triangle_emitters_ + index - triangle_emitters_;
+  }
+  const LightTreeEmitter &source = emitters_.at(dense_index);
+  return {source.root.get(), source.prim_id, source.object_id,
+           source.light_set_membership, source.measure};
+}

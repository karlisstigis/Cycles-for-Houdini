diff --git a/src/scene/light.cpp b/src/scene/light.cpp
index 34db0ca2f62ed58f5856762ad6796a8820fa833d..f911e44a499584de3d6bfa272b2f0208512e90e9 100644
--- a/src/scene/light.cpp
+++ b/src/scene/light.cpp
@@ -24,6 +24,11 @@
 #include "util/log.h"
 #include "util/path.h"
 #include "util/progress.h"
+#include "util/time.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
 
 CCL_NAMESPACE_BEGIN
 
@@ -1070,10 +1075,34 @@ void LightManager::device_update_tree(Device * /*unused*/,
   /* Update light tree. */
   progress.set_status("Updating Lights", "Computing tree");
 
+  const char *profile_flag = std::getenv("CYCLES_HOUDINI_PROFILE_LIGHT_TREE");
+  const bool profiling = profile_flag && std::strcmp(profile_flag, "1") == 0;
+  const double started = profiling ? time_dt() : 0;
+  double construction_seconds = 0, flatten_seconds = 0, upload_seconds = 0, work_end = 0;
+  size_t profile_nodes = 0, profile_emitters = 0;
+  /* Declared before the tree: this runs after tree retirement, whose many
+   * transient node allocations were previously hidden in the overall timer. */
+  const scoped_callback_timer phase_timer([&](double /*unused*/) {
+    if (profiling) {
+      const double finished = time_dt();
+      std::fprintf(stderr,
+                   "CH_LIGHT_TREE_PHASES {\"complete\":%s,\"nodes\":%zu,\"emitters\":%zu,"
+                   "\"construction_seconds\":%.9f,\"flatten_seconds\":%.9f,"
+                   "\"upload_seconds\":%.9f,\"retirement_seconds\":%.9f,\"total_seconds\":%.9f}\n",
+                   work_end > 0 && !progress.get_cancel() ? "true" : "false",
+                   profile_nodes, profile_emitters, construction_seconds, flatten_seconds,
+                   upload_seconds, work_end > 0 ? finished - work_end : 0, finished - started);
+    }
+  });
+
   /* TODO: For now, we'll start with a smaller number of max lights in a node.
    * More benchmarking is needed to determine what number works best. */
   LightTree light_tree(scene, dscene, progress, 8, mesh_light_tree_cache.get());
   LightTreeNode *root = light_tree.build(scene, dscene);
+  const double constructed = profiling ? time_dt() : 0;
+  construction_seconds = constructed - started;
+  profile_nodes = light_tree.num_nodes;
+  profile_emitters = light_tree.num_emitters();
   mesh_light_tree_cache->report(!progress.get_cancel());
   if (progress.get_cancel()) {
     return;
@@ -1152,11 +1181,17 @@ void LightManager::device_update_tree(Device * /*unused*/,
   }
 
   /* Copy arrays to device. */
+  const double upload_at = profiling ? time_dt() : 0;
+  flatten_seconds = upload_at - constructed;
   dscene->light_tree_nodes.copy_to_device();
   dscene->light_tree_emitters.copy_to_device();
   dscene->light_to_tree.copy_to_device();
   dscene->object_lookup_offset.copy_to_device();
   dscene->triangle_to_tree.copy_to_device();
+  if (profiling) {
+    work_end = time_dt();
+    upload_seconds = work_end - upload_at;
+  }
 }
 
 static void background_cdf(int start,

   const auto restore_node = [&](const auto &self, int index, LightTreeNode *target) -> void {
     if (progress.get_cancel()) {
       return;
@@ -215,6 +220,10 @@ void LightTreeMeshCache::restore(const Entry &entry,
     target->type = node.type;
   };
   restore_node(restore_node, 0, root);
+  if (impl_->profiling) {
+    impl_->emitter_seconds += clone_at - started;
+    impl_->clone_seconds += time_dt() - clone_at;

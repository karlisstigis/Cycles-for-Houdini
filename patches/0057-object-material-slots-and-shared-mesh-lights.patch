diff --git a/src/kernel/geom/shader_palette.h b/src/kernel/geom/shader_palette.h
new file mode 100644
index 0000000000000000000000000000000000000000..3f7517ae122d5fca8689f1b2e77a87ebea4ca02a
--- /dev/null
+++ b/src/kernel/geom/shader_palette.h
@@ -0,0 +1,21 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "kernel/globals.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Triangle slots, rather than the primary shader ID, distinguish two faces
+ * whose base material happens to be the same but whose instance bindings differ. */
+ccl_device_inline int triangle_shader(KernelGlobals kg, const int prim, const int object)
+{
+  const int base = kernel_data_fetch(tri_shader, prim);
+  if (object == OBJECT_NONE) return base;
+  const ccl_global KernelObject &data = kernel_data_fetch(objects, object);
+  if (data.shader_palette_offset < 0) return base;
+  const int slot = kernel_data_fetch(tri_shader_slot, prim);
+  kernel_assert(slot >= 0 && slot < data.shader_palette_size);
+  return kernel_data_fetch(object_shader_palette, data.shader_palette_offset + slot) |
+         (base & SHADER_SMOOTH_NORMAL);
+}
+
+CCL_NAMESPACE_END

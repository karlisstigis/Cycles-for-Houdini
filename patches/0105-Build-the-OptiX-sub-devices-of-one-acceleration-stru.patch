@@ -15,9 +15,13 @@
 #include "bvh/multi.h"
 
 #include "scene/geometry.h"
+#include "scene/hair.h"
+#include "scene/mesh.h"
+#include "scene/pointcloud.h"
 
 #include "util/list.h"
 #include "util/map.h"

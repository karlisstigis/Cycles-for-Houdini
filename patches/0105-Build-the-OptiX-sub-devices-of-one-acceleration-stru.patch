 #include "util/types_image.h"
 
 CCL_NAMESPACE_BEGIN
@@ -234,6 +238,24 @@ class MultiDevice : public Device {
     }
   }
 
+  /* Primitives a bottom level build of these geometries covers. */
+  static size_t bvh_primitive_count(const BVH *bvh)
+  {
+    size_t count = 0;
+    for (const Geometry *geom : bvh->geometry) {
+      if (geom->is_mesh() || geom->is_volume()) {
+        count += static_cast<const Mesh *>(geom)->num_triangles();
+      }
+      else if (geom->is_hair()) {
+        count += static_cast<const Hair *>(geom)->num_segments();
+      }
+      else if (geom->is_pointcloud()) {
+        count += static_cast<const PointCloud *>(geom)->num_points();
+      }
+    }
+    return count;
+  }
+
   void build_bvh(BVH *bvh, Progress &progress, bool refit) override
   {
     /* Try to build and share a single acceleration structure, if possible */
@@ -254,6 +276,31 @@ class MultiDevice : public Device {
     BVHMulti *const bvh_multi = static_cast<BVHMulti *>(bvh);
     bvh_multi->sub_bvhs.resize(devices.size());
 
+    /* OptiX sub-devices of a top level structure or of a large geometry build at the same time:
+     * each uses only its own device, memory and build lock, the shared build input is computed
+     * once under its own mutex, and a top level build finds its device's bottom level structures
+     * through multi_sub_index, so geometry BVH pointers are not swapped. Small geometries keep
+     * one sub-device after the other: they already build in parallel with each other, and a
+     * parallel loop per geometry costs more than their builds (the threshold decides threading
+     * only, never results). CYCLES_OPTIX_SERIAL_SUBDEVICE_BVH builds one sub-device after the
+     * other everywhere as before, as a reference. Other layouts keep the sequential loop below. */
+    static const bool serial_sub_devices = getenv("CYCLES_OPTIX_SERIAL_SUBDEVICE_BVH") != nullptr;
+    constexpr size_t parallel_sub_device_min_primitives = 65536;
+    if (bvh->params.bvh_layout == BVH_LAYOUT_MULTI_OPTIX && !serial_sub_devices &&
+        devices.size() > 1 &&
+        (bvh->params.top_level || bvh_primitive_count(bvh) >= parallel_sub_device_min_primitives))
+    {
+      build_optix_sub_bvhs_parallel(bvh_multi, progress, refit);
+      return;
+    }
+
+    build_sub_bvhs_serial(bvh, bvh_multi, progress, refit);
+  }
+
+  /* One sub-device after the other, with the geometry BVH pointers swapped to each sub-device
+   * BVH while it builds. */
+  void build_sub_bvhs_serial(BVH *bvh, BVHMulti *bvh_multi, Progress &progress, bool refit)
+  {
     /* Temporarily move ownership of BVH on geometry to this vector, to swap
      * it for each sub device. Need to find a better way to handle this. */
     vector<unique_ptr<BVH>> geom_bvhs;
@@ -340,6 +387,46 @@ class MultiDevice : public Device {
     }
   }
 
+  void build_optix_sub_bvhs_parallel(BVHMulti *bvh_multi, Progress &progress, bool refit)
+  {
+    vector<SubDevice *> subs;
+    subs.reserve(devices.size());
+    for (SubDevice &sub : devices) {
+      subs.push_back(&sub);
+    }
+    for (size_t i = 0; i < subs.size(); i++) {
+      if (!bvh_multi->sub_bvhs[i]) {
+        BVHParams params = bvh_multi->params;
+        params.bvh_layout = BVH_LAYOUT_OPTIX;
+        bvh_multi->sub_bvhs[i] = BVH::create(
+            params, bvh_multi->geometry, bvh_multi->objects, subs[i]->device.get());
+      }
+    }
+
+    /* Host data computed by the first sub-device and reused by the others for this build. */
+    BVHSharedBuild shared_build;
+
+    /* Isolated, so a thread waiting here does not pick up another geometry's build task. */
+    isolate_task([&]() {
+      parallel_for(blocked_range<size_t>(0, subs.size(), 1), [&](const blocked_range<size_t> &r) {
+        for (size_t i = r.begin(); i != r.end(); i++) {
+          /* Reset both pointers on every exit path, so neither outlives this call. */
+          struct SubBuildScope {
+            BVH *sub_bvh;
+            ~SubBuildScope()
+            {
+              sub_bvh->shared_build = nullptr;
+              sub_bvh->multi_sub_index = -1;
+            }
+          } scope{bvh_multi->sub_bvhs[i].get()};
+          scope.sub_bvh->shared_build = &shared_build;
+          scope.sub_bvh->multi_sub_index = int(i);
+          subs[i]->device->build_bvh(scope.sub_bvh, progress, refit);
+        }
+      });
+    });
+  }
+
   OSLGlobals *get_cpu_osl_memory() override
   {
     /* Always return the OSL memory of the CPU device (this works since the constructor above

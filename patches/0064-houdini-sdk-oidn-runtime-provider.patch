Rationale: OIDN comes from the exact Houdini SDK runtime provider rather than Blender's dependency package; its ABI and DLL list are integration policy.
Contract: houdini sdk oidn runtime provider
Tests: tests/sdk_dependency_policy_test.py, scripts/verify-upstream-patches.py

diff --git a/src/cmake/external_libs.cmake b/src/cmake/external_libs.cmake
index 684cbf5e83d851f9bcc1710c680ce3e216b910ac..93904f2fe365747e98b6232e3940918e93ed1def 100644
--- a/src/cmake/external_libs.cmake
+++ b/src/cmake/external_libs.cmake
@@ -585,10 +585,14 @@ if(WITH_CYCLES_OPENIMAGEDENOISE)
   set(WITH_OPENIMAGEDENOISE ON)
   find_package(OpenImageDenoise REQUIRED)
 
-  if(WIN32)
-    add_bundled_libraries(openimagedenoise/bin)
-  else()
-    add_bundled_libraries(openimagedenoise/lib)
+  # The native Houdini integration uses its licensed host SDK's matching
+  # headers/import library/runtime. Never install competing vendor DLLs.
+  if(NOT CH_OIDN_PROVIDER STREQUAL "houdini-sdk")
+    if(WIN32)
+      add_bundled_libraries(openimagedenoise/bin)
+    else()
+      add_bundled_libraries(openimagedenoise/lib)
+    endif()
   endif()
 endif()
 ###########################################################################

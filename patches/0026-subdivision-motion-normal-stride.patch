Rationale: Subdivision motion normals require the actual per-step stride; a wrong stride can read another pose even with valid buffers.
Contract: subdivision motion normal stride
Tests: tests/houdini_velocity_normal_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/scene/object.cpp b/src/scene/object.cpp
index f5f3441c748b6219a78067d7ab20284acd30524e..107dcd356660515117b0d8ab40b5fdbc4150c907 100644
--- a/src/scene/object.cpp
+++ b/src/scene/object.cpp
@@ -1258,6 +1258,15 @@ void ObjectManager::device_update_geom_offsets(Device * /*unused*/,
       kobject.numverts = numverts;
       update = true;
     }
+    /* Tessellation can change triangle counts after object transforms were
+     * prepared. Motion corner normals use this count as their sample stride. */
+    const int numprims = (geom->is_mesh() || geom->is_volume()) ?
+                             static_cast<Mesh *>(geom)->num_triangles() :
+                             0;
+    if (kobject.numprims != numprims) {
+      kobject.numprims = numprims;
+      update = true;
+    }
   }
 
   if (update) {

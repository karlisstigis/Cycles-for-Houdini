-ccl_device float2 camera_sample_aperture(ccl_constant KernelCamera *cam, const float2 rand)
+ccl_device_inline float4 camera_sample_dof(ccl_constant KernelCamera *cam,
+                                          const ccl_global float4 *motion,
+                                          const float time)
+{
+  if (cam->num_dof_motion_steps && motion != nullptr) {
+    const float position = saturatef(time) * float(cam->num_dof_motion_steps - 1);
+    const int index = min(int(position), cam->num_dof_motion_steps - 2);
+    const float fraction = position - float(index);
+    /* Preserve unwrapped authored rotation, including multiple turns. The
+     * weighted form also avoids overflowing b-a for opposite large values. */
+    return motion[index] * (1.0f - fraction) + motion[index + 1] * fraction;
+  }
+  return make_float4(cam->aperturesize, cam->focaldistance, cam->bladesrotation,
+                     cam->aperture_ratio);
+}
+
+ccl_device_inline float3 camera_dof_normalize(const float3 value)
+{
+  const float scale = max(1.0f, max(fabsf(value.x), max(fabsf(value.y), fabsf(value.z))));
+  return normalize(value / scale);
+}

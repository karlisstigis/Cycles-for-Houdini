index 3e94c58ad8436f0863ae71685abc2f16a9fe8e41..c3731073a301f3393dead9acc0afafb1fc4a0542 100644
--- a/src/kernel/geom/curve.h
+++ b/src/kernel/geom/curve.h
@@ -63,10 +63,11 @@ ccl_device T curve_attribute(KernelGlobals kg,
                            kernel_data_fetch(objects, sd->object).numverts : 0;
     const BaseT f0 = attribute_data_fetch_motion<BaseT>(kg, sd, desc, k0, stride);
     const BaseT f1 = attribute_data_fetch_motion<BaseT>(kg, sd, desc, k1, stride);
+    const BaseT value = attribute_select_constant(f0, f1, f1, f0, mix(f0, f1, sd->u));
 
     if constexpr (is_dual_v<T>) {
       T result;
-      result.val = mix(f0, f1, sd->u);
+      result.val = value;
 #  ifdef __RAY_DIFFERENTIALS__
       result.dx = curve_attribute_dfdx(sd->du, f0, f1);
       result.dy = curve_attribute_dfdy(sd->du, f0, f1);
@@ -74,7 +75,7 @@ ccl_device T curve_attribute(KernelGlobals kg,
       return result;
     }
     else {
-      return mix(f0, f1, sd->u);
+      return value;
     }
   }
 

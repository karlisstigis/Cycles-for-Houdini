 #ifdef __RAY_DIFFERENTIALS__
       result.dx = triangle_attribute_dfdx(sd->du, sd->dv, f[0], f[1], f[2]);
       result.dy = triangle_attribute_dfdy(sd->du, sd->dv, f[0], f[1], f[2]);

Rationale: Weighted interpolation can alter the last bits of exactly constant attributes, breaking raw float identity even though all input components agree.
Contract: constant attribute sampling
Tests: tests/houdini_sampled_attribute_displacement_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/kernel/geom/attribute.h b/src/kernel/geom/attribute.h
index 93d79a6fd346ac898b338840494454337192ffb4..e1a43260ed8327523382b4cd1185f87e06035147 100644
--- a/src/kernel/geom/attribute.h
+++ b/src/kernel/geom/attribute.h
@@ -12,6 +12,41 @@
 
 CCL_NAMESPACE_BEGIN
 
+/* Preserve exactly uniform field components through interpolation. Weighted sums
+ * can change their last bits even when all source values agree; float hashes
+ * (such as White Noise) then turn a constant per-copy field into visible noise.
+ * Keep the ordinary interpolation for varying components, without quantizing
+ * user values or changing interpolation of unrelated geometry quantities. */
+ccl_device_inline float attribute_select_constant(
+    const float a, const float b, const float c, const float uniform, const float varying)
+{
+  return a == b && a == c ? uniform : varying;
+}
+
+ccl_device_inline float2 attribute_select_constant(
+    const float2 a, const float2 b, const float2 c, const float2 uniform, const float2 varying)
+{
+  return make_float2(attribute_select_constant(a.x, b.x, c.x, uniform.x, varying.x),
+                     attribute_select_constant(a.y, b.y, c.y, uniform.y, varying.y));
+}
+
+ccl_device_inline float3 attribute_select_constant(
+    const float3 a, const float3 b, const float3 c, const float3 uniform, const float3 varying)
+{
+  return make_float3(attribute_select_constant(a.x, b.x, c.x, uniform.x, varying.x),
+                     attribute_select_constant(a.y, b.y, c.y, uniform.y, varying.y),
+                     attribute_select_constant(a.z, b.z, c.z, uniform.z, varying.z));
+}
+
+ccl_device_inline float4 attribute_select_constant(
+    const float4 a, const float4 b, const float4 c, const float4 uniform, const float4 varying)
+{
+  return make_float4(attribute_select_constant(a.x, b.x, c.x, uniform.x, varying.x),
+                     attribute_select_constant(a.y, b.y, c.y, uniform.y, varying.y),
+                     attribute_select_constant(a.z, b.z, c.z, uniform.z, varying.z),
+                     attribute_select_constant(a.w, b.w, c.w, uniform.w, varying.w));
+}
+
 /* Attributes
  *
  * We support an arbitrary number of attributes on various mesh elements.
@@ -282,7 +317,7 @@ ccl_device T attribute_data_fetch_motion(KernelGlobals kg,
       const int second = next == centre ? 0 : next < centre ? next + 1 : next;
       const T a = attribute_data_fetch<T>(kg, desc.element, desc.offset + index + first * stride);
       const T b = attribute_data_fetch<T>(kg, desc.element, desc.offset + index + second * stride);
-      return (1.0f - factor) * a + factor * b;
+      return attribute_select_constant(a, b, b, a, (1.0f - factor) * a + factor * b);
     }
   }
   return attribute_data_fetch<T>(kg, desc.element, desc.offset + index);

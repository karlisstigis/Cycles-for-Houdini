-      light_tree_leaf_emitters_copy_and_flatten(
-          flatten, node, knodes, kemitters, next_node_index);
+  const auto flatten_range = [&](const blocked_range<int> &range) {
+    for (int index = range.begin(); index < range.end(); ++index) {
+      const LightTreeCachedNode &stored = cache.nodes[index];
+      LightTreeNode node(stored.measure(), stored.bit_trail);
+      node.object_id = anchor.object_id;
+      int left_child = -1, right_child = -1;
+      if (stored.type & LIGHT_TREE_LEAF) {
+        node.make_leaf(cache.emitter_start + stored.first, stored.second);
+      }
+      else {
+        left_child = first_node + stored.first;
+        right_child = first_node + stored.second;
+      }
+      node.type = stored.type;
+      if (index == 0) {
+        /* Root measures describe the current instance, and flattening may have
+         * moved the reference variant to a different first-encountered instance. */
+        node.measure = anchor.measure;
+        node.bit_trail = anchor.bit_trail;
+        node.type = anchor.type;
+      }
+      if (node.is_leaf()) {
+        /* Cached local leaves contain disjoint triangle ranges. They never
+         * recurse, reserve nodes or mutate the shared instance-reference map.
+         * Current IDs, visibility and sampling still come from the live scene. */
+        const auto &leaf = node.get_leaf();
+        for (int i = 0; i < leaf.num_emitters; ++i) {
+          const int emitter_index = leaf.first_emitter_index + i;
+          light_tree_triangle_emitter_copy_to_device(
+              flatten, flatten.emitters[emitter_index], node.bit_trail,
+              emitter_index, kemitters[emitter_index]);
+        }
+      }
+      light_tree_node_copy_to_device(knodes[first_node + index], node, left_child, right_child);
     }
-    light_tree_node_copy_to_device(knodes[first_node + index], node, left_child, right_child);
+  };
+  const char *serial_flag = std::getenv("CYCLES_HOUDINI_SERIAL_LIGHT_TREE_FLATTEN");
+  const bool force_serial = serial_flag && std::strcmp(serial_flag, "1") == 0;
+  if (cache.num_nodes >= 4096 && !force_serial) {
+    /* Reserve the whole range before dispatch. Borrowed cache records and
+     * scene fields remain immutable until all tasks join here. Use Cycles'
+     * existing task arena/thread limit; small ranges avoid dispatch overhead. */
+    flatten.parallel_cached_nodes += cache.num_nodes;
+    ++flatten.parallel_cached_ranges;
+    parallel_for(blocked_range<int>(0, cache.num_nodes, 1024), flatten_range);
+  }
+  else {
+    flatten_range(blocked_range<int>(0, cache.num_nodes));
   }
   return first_node;
 }

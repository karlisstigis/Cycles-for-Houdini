  *
  * BVH-like data structure that keeps track of lights
  * and considers additional orientation and energy information */
+/* The triangle shape can be shared while its emission and linking differ. */
+struct LightTreeMeshKey {
+  Mesh *mesh;
+  int palette;
+  uint64_t membership;
+  bool operator==(const LightTreeMeshKey &b) const
+  { return mesh == b.mesh && palette == b.palette && membership == b.membership; }
+};
+struct LightTreeMeshKeyHash {
+  size_t operator()(const LightTreeMeshKey &key) const
+  { return std::hash<Mesh *>{}(key.mesh) ^ (std::hash<uint64_t>{}(key.membership) << 1) ^
+           (std::hash<int>{}(key.palette) << 2); }
+};
+

diff --git a/src/scene/light_tree_build_profile.h b/src/scene/light_tree_build_profile.h
new file mode 100644
--- /dev/null
+++ b/src/scene/light_tree_build_profile.h
@@ -0,0 +1,95 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "util/time.h"
+#include "util/types.h"
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+
+CCL_NAMESPACE_BEGIN
+
+enum class LightTreeBuildStage { Decision, Centroids, Buckets, Prefix, Costs, Partition, Allocation, Leaf, Scheduling, Count };
+
+/* Optional CPU-work attribution, not elapsed wall time. Large ranges are timed
+ * completely; a deterministic 1/256 sample bounds timing/atomic overhead for
+ * small nodes. Decision includes its centroid/bucket/prefix/cost sub-stages. */
+struct LightTreeBuildProfile {
+  struct Stage {
+    std::atomic<uint64_t> nanoseconds{0}, estimated_nanoseconds{0};
+    std::atomic<uint64_t> samples{0}, represented_calls{0}, represented_emitters{0};
+  };
+  std::array<Stage, int(LightTreeBuildStage::Count)> stages;
+  static constexpr int full_range_min = 1024;
+  static constexpr uint small_weight = 256;
+
+  static uint weight(const int start, const int end)
+  {
+    if (end <= start) return 0;
+    if (end - start >= full_range_min) return 1;
+    uint hash = uint(start) * 0x9e3779b9u ^ uint(end) * 0x85ebca6bu;
+    hash ^= hash >> 16; hash *= 0x7feb352du;
+    hash ^= hash >> 15; hash *= 0x846ca68bu; hash ^= hash >> 16;
+    return (hash & (small_weight - 1)) == 0 ? small_weight : 0;
+  }
+
+  void record(const LightTreeBuildStage kind, const uint sample_weight,
+              const uint emitters, const uint64_t ns)
+  {
+    if (!sample_weight) return;
+    auto &s = stages[int(kind)];
+    s.nanoseconds.fetch_add(ns, std::memory_order_relaxed);
+    s.estimated_nanoseconds.fetch_add(ns * sample_weight, std::memory_order_relaxed);
+    s.samples.fetch_add(1, std::memory_order_relaxed);
+    s.represented_calls.fetch_add(sample_weight, std::memory_order_relaxed);
+    s.represented_emitters.fetch_add(uint64_t(emitters) * sample_weight, std::memory_order_relaxed);
+  }
+
+  void write(const bool complete, const int nodes, const bool duplicate_skip) const noexcept
+  {
+    try {
+      static const char *names[] = {"decision", "centroids", "buckets", "prefix", "costs", "partition", "allocation", "leaf", "scheduling"};
+      std::ostringstream out; out.imbue(std::locale::classic()); out << std::setprecision(9);
+      out << "CH_LIGHT_TREE_BUILD_DETAIL {\"complete\":" << (complete ? "true" : "false")
+          << ",\"duplicate_split_skip\":" << (duplicate_skip ? "true" : "false")
+          << ",\"nodes_created\":" << nodes << ",\"full_range_min\":" << full_range_min
+          << ",\"small_sample_weight\":" << small_weight << ",\"stages\":{";
+      for (size_t index = 0; index < stages.size(); ++index) {
+        const auto &s = stages[index]; if (index) out << ',';
+        out << '"' << names[index] << "\":{\"sampled_seconds\":"
+            << double(s.nanoseconds.load(std::memory_order_relaxed)) * 1e-9
+            << ",\"estimated_seconds\":" << double(s.estimated_nanoseconds.load(std::memory_order_relaxed)) * 1e-9
+            << ",\"samples\":" << s.samples.load(std::memory_order_relaxed)
+            << ",\"represented_calls\":" << s.represented_calls.load(std::memory_order_relaxed)
+            << ",\"represented_emitters\":" << s.represented_emitters.load(std::memory_order_relaxed) << '}';
+      }
+      out << "}}"; std::fprintf(stderr, "%s\n", out.str().c_str());
+    }
+    catch (...) { /* Diagnostic allocation must not change the render result. */ }
+  }
+};
+
+class LightTreeBuildTimer {
+  LightTreeBuildProfile *profile_;
+  LightTreeBuildStage kind_;
+  uint weight_ = 0, emitters_ = 0;
+  double began_ = 0;
+ public:
+  LightTreeBuildTimer(LightTreeBuildProfile *profile, const LightTreeBuildStage kind,
+                     const int start, const int end) : profile_(profile), kind_(kind)
+  {
+    if (profile_ && (weight_ = LightTreeBuildProfile::weight(start, end))) {
+      emitters_ = uint(end - start); began_ = time_dt();
+    }
+  }
+  ~LightTreeBuildTimer()
+  {
+    if (weight_) profile_->record(kind_, weight_, emitters_, uint64_t((time_dt() - began_) * 1e9));
+  }
+};
+
+CCL_NAMESPACE_END

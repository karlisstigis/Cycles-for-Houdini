diff --git a/src/scene/light_tree.h b/src/scene/light_tree.h
--- a/src/scene/light_tree.h
+++ b/src/scene/light_tree.h
@@ -258,6 +258,24 @@
 
 LightTreeBucket operator+(const LightTreeBucket &a, const LightTreeBucket &b);
 
+/* Right prefixes contribute only their measure to splitting costs. Keep the
+ * original right-to-left arithmetic, without copying/merging unused links. */
+inline void light_tree_right_measures(
+    const std::array<LightTreeBucket, LightTreeBucket::num_buckets> &buckets,
+    std::array<LightTreeMeasure, LightTreeBucket::num_buckets - 1> &right)
+{
+  right.back() = buckets.back().measure;
+  for (int index = LightTreeBucket::num_buckets - 3; index >= 0; --index) {
+    right[index] = right[index + 1] + buckets[index + 1].measure;
+  }
+}
+
+inline bool light_tree_duplicate_split(
+    const std::array<LightTreeBucket, LightTreeBucket::num_buckets> &buckets, const int split)
+{
+  return split > 0 && buckets[split].count == 0;
+}

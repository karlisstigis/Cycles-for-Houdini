index 0000000000000000000000000000000000000000..020db05c78fae714e4b28866273afc1c8060ca22
--- /dev/null
+++ b/src/util/boundbox_overlap.h
@@ -0,0 +1,157 @@
+/* SPDX-FileCopyrightText: 2026 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include <algorithm>
+#include <utility>
+
+#include "util/boundbox.h"
+#include "util/vector.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* An exact any-overlap broad phase for BoundBox::intersects. The referenced bounds and
+ * identities must remain alive and unchanged until the index is discarded. */
+class BoundBoxOverlapIndex {
+ public:
+  struct Entry {
+    const BoundBox *bounds;
+    const void *identity;
+  };
+
+  explicit BoundBoxOverlapIndex(vector<Entry> entries) : entries_(std::move(entries))
+  {
+    if (entries_.size() <= 8) {
+      return;
+    }
+    const auto fallback_begin = std::partition(
+        entries_.begin(), entries_.end(), [](const Entry &entry) {
+          return indexable(*entry.bounds);
+        });
+    fallback_.assign(fallback_begin, entries_.end());
+    entries_.erase(fallback_begin, entries_.end());
+    if (entries_.size() > 8) {
+      nodes_.reserve(entries_.size() / 2 + 1);
+      build(0, entries_.size());
+    }
+  }
+
+  bool intersects(BoundBox bounds, const void *excluded_identity) const
+  {
+    /* Empty and small volume scenes retain the cheap linear path, without any
+     * query validity/center calculations or tree allocation. */
+    if (nodes_.empty()) {
+      return intersects_entries(bounds, excluded_identity, entries_, 0, entries_.size()) ||
+             intersects_entries(bounds, excluded_identity, fallback_, 0, fallback_.size());
+    }
+    /* Invalid boxes can still intersect according to the legacy center/size predicate.
+     * Keep their exact behavior, including inverted intervals, infinities and NaNs. */
+    if (!indexable(bounds)) {
+      return intersects_entries(bounds, excluded_identity, entries_, 0, entries_.size()) ||
+             intersects_entries(bounds, excluded_identity, fallback_, 0, fallback_.size());
+    }
+    return intersects_entries(bounds, excluded_identity, fallback_, 0, fallback_.size()) ||
+           (!nodes_.empty() && intersects_node(bounds, excluded_identity, 0));
+  }
+
+ private:
+  struct Node {
+    float3 center_min, center_max, max_size;
+    size_t begin, end, right;
+  };
+  vector<Entry> entries_, fallback_;
+  vector<Node> nodes_;
+
+  static bool indexable(const BoundBox &bounds)
+  {
+    /* Host MSVC uses /fp:fast. Inspect exponent bits so classification does not
+     * depend on the compiler preserving floating-point isfinite/NaN tests. */
+    const auto finite = [](const float3 value) {
+      return (__float_as_uint(value.x) & 0x7f800000u) != 0x7f800000u &&
+             (__float_as_uint(value.y) & 0x7f800000u) != 0x7f800000u &&
+             (__float_as_uint(value.z) & 0x7f800000u) != 0x7f800000u;
+    };
+    return finite(bounds.min) && finite(bounds.max) && bounds.valid() && finite(bounds.center()) &&
+           finite(bounds.size());
+  }
+
+  static bool intersects_entries(BoundBox &bounds,
+                                 const void *excluded_identity,
+                                 const vector<Entry> &entries,
+                                 const size_t begin,
+                                 const size_t end)
+  {
+    for (size_t i = begin; i < end; ++i) {
+      if (entries[i].identity != excluded_identity && bounds.intersects(*entries[i].bounds)) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  size_t build(const size_t begin, const size_t end)
+  {
+    const size_t index = nodes_.size();
+    Node node;
+    node.center_min = node.center_max = entries_[begin].bounds->center();
+    node.max_size = entries_[begin].bounds->size();
+    node.begin = begin;
+    node.end = end;
+    node.right = 0;
+    for (size_t i = begin + 1; i < end; ++i) {
+      const BoundBox &bounds = *entries_[i].bounds;
+      node.center_min = min(node.center_min, bounds.center());
+      node.center_max = max(node.center_max, bounds.center());
+      node.max_size = max(node.max_size, bounds.size());
+    }
+    nodes_.push_back(node);
+    if (end - begin > 8) {
+      /* Use double for the split extent: finite centers may span more than FLT_MAX. */
+      int axis = 0;
+      for (int i = 1; i < 3; ++i) {
+        if (double(node.center_max[i]) - node.center_min[i] >
+            double(node.center_max[axis]) - node.center_min[axis])
+        {
+          axis = i;
+        }
+      }
+      const size_t middle = begin + (end - begin) / 2;
+      std::nth_element(entries_.begin() + begin,
+                       entries_.begin() + middle,
+                       entries_.begin() + end,
+                       [axis](const Entry &a, const Entry &b) {
+                         return a.bounds->center()[axis] < b.bounds->center()[axis];
+                       });
+      build(begin, middle);
+      const size_t right = build(middle, end);
+      nodes_[index].right = right;
+    }
+    return index;
+  }
+
+  bool intersects_node(BoundBox &bounds, const void *excluded_identity, const size_t index) const
+  {
+    const Node &node = nodes_[index];
+    const float3 center = bounds.center();
+    const float3 nearest_center = min(max(center, node.center_min), node.center_max);
+    const float3 center_diff = center - nearest_center;
+    const float3 total_size = (bounds.size() + node.max_size) * 0.5f;
+    /* BoundBox::intersects compares rounded centers and size sums, not endpoints.
+     * Each node encloses the leaf centers and maximum sizes. Monotonic float
+     * operations make this conservative even at a rounded touch or size overflow. */
+    if (!(fabsf(center_diff.x) <= total_size.x && fabsf(center_diff.y) <= total_size.y &&
+          fabsf(center_diff.z) <= total_size.z))
+    {
+      return false;
+    }
+    if (!node.right) {
+      return intersects_entries(bounds, excluded_identity, entries_, node.begin, node.end);
+    }
+    return intersects_node(bounds, excluded_identity, index + 1) ||
+           intersects_node(bounds, excluded_identity, node.right);
+  }
+};
+
+CCL_NAMESPACE_END

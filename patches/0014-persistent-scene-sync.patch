+void Session::synchronize_scene(std::function<void()> transaction)
+{
+  if (!transaction) {
+    throw std::invalid_argument("Scene synchronization requires a transaction");
+  }
+  auto completion = std::make_shared<std::promise<void>>();
+  std::future<void> finished = completion->get_future();
+  {
+    const thread_scoped_lock lock(session_thread_mutex_);
+    if (pending_scene_sync_ || session_thread_state_ == SESSION_THREAD_END) {
+      throw std::logic_error("Scene synchronization controller is busy or closing");
+    }
+    scene_sync_requested_.store(true);
+    pending_scene_sync_ = [this, transaction = std::move(transaction), completion]() {
+      scene_sync_failed_ = false;
+      try {
+        transaction();
+        completion->set_value();
+      }
+      catch (...) {
+        scene_sync_failed_ = true;
+        progress.set_error("Scene synchronization transaction failed");
+        progress.set_cancel("Scene synchronization transaction failed");
+        completion->set_exception(std::current_exception());
+      }
+    };
+  }
+  {
+    const thread_scoped_lock pause_lock(pause_mutex_);
+    new_work_added_ = true;
+  }
+  pause_cond_.notify_all();
+  start();
+  finished.get();
+}
+
+void Session::run_pending_scene_sync()
+{
+  std::function<void()> transaction;
+  {
+    const thread_scoped_lock lock(session_thread_mutex_);
+    transaction = std::move(pending_scene_sync_);
+    pending_scene_sync_ = nullptr;
+    scene_sync_requested_.store(false);
+  }
+  if (transaction) {
+    transaction();
+  }
+}
+

+void LightTreeCacheBlocks::reset(const int records, const int record_bytes)
+{
+  if (records < 0 || record_bytes <= 0 || record_bytes > 64 || record_bytes % 4) {
+    throw std::runtime_error("Invalid internal mesh-light cache block shape");
+  }
+  count = records;
+  stride = record_bytes;
+  blocks.resize((size_t(count) + light_tree_cache_block_size - 1) / light_tree_cache_block_size);
+}
+
+void LightTreeCacheBlocks::append(const int block, const void *records, const int records_count)
+{
+  if (!records || count <= 0 || stride <= 0 || stride > 64 || stride % 4 ||
+      blocks.size() != (size_t(count) + light_tree_cache_block_size - 1) / light_tree_cache_block_size ||
+      block < 0 || size_t(block) >= blocks.size() || records_count <= 0 ||
+      records_count != std::min(light_tree_cache_block_size, count - block * light_tree_cache_block_size)) {
+    throw std::runtime_error("Invalid internal mesh-light cache block write");
+  }
+  const size_t raw_bytes = size_t(records_count) * stride;
+  vector<uint8_t> encoded;
+  encoded.reserve(raw_bytes + 3);
+  encoded.push_back(uint8_t(((stride / 4 - 1) << 1) | 1));
+  encoded.push_back(uint8_t(records_count));
+  encoded.push_back(uint8_t(records_count >> 8));
+  std::array<uint32_t, 16> previous{};
+  const auto *source = static_cast<const uint8_t *>(records);
+  const int words = stride / 4;
+  for (int record = 0; record < records_count; ++record) {
+    std::array<uint32_t, 16> delta{};
+    uint16_t mask = 0;
+    for (int word = 0; word < words; ++word) {
+      uint32_t value;
+      std::memcpy(&value, source + size_t(record) * stride + word * 4, 4);
+      delta[word] = value ^ previous[word];
+      previous[word] = value;
+      if (delta[word]) mask |= uint16_t(1u << word);
+    }
+    encoded.push_back(uint8_t(mask));
+    encoded.push_back(uint8_t(mask >> 8));
+    for (int word = 0; word < words; ++word) {
+      if (!(mask & (1u << word))) continue;
+      uint32_t value = delta[word];
+      while (value >= 128) {
+        encoded.push_back(uint8_t(value) | 128);
+        value >>= 7;
+      }
+      encoded.push_back(uint8_t(value));
+    }
+    if (encoded.size() >= raw_bytes + 3) {
+      encoded.resize(raw_bytes + 3);
+      encoded[0] &= ~1;
+      std::memcpy(encoded.data() + 3, records, raw_bytes);
+      break;
+    }
+  }
+  /* Discard the encoder's raw-size capacity. The compact allocation itself,
+   * rather than the logical byte count, participates in the cache budget. */
+  blocks[block] = vector<uint8_t>(encoded.begin(), encoded.end());
+}
+
+void LightTreeCacheBlocks::read(const int block, void *records) const
+{
+  if (!records || count <= 0 ||
+      blocks.size() != (size_t(count) + light_tree_cache_block_size - 1) / light_tree_cache_block_size ||
+      block < 0 || size_t(block) >= blocks.size() || stride <= 0 || stride > 64 || stride % 4) {
+    throw std::runtime_error("Invalid internal mesh-light cache block read");
+  }
+  const auto &encoded = blocks[block];
+  const int records_count = std::min(light_tree_cache_block_size, count - block * light_tree_cache_block_size);
+  const size_t raw_bytes = size_t(records_count) * stride;
+  if (encoded.size() < 3) throw std::runtime_error("Incomplete internal mesh-light cache block");
+  if ((encoded[0] >> 1) != stride / 4 - 1 ||
+      (uint32_t(encoded[1]) | (uint32_t(encoded[2]) << 8)) != uint32_t(records_count)) {
+    throw std::runtime_error("Internal mesh-light cache record ownership mismatch");
+  }
+  if (!(encoded[0] & 1)) {
+    if (encoded.size() != raw_bytes + 3) throw std::runtime_error("Malformed raw mesh-light cache block");
+    std::memcpy(records, encoded.data() + 3, raw_bytes);
+    return;
+  }
+  size_t cursor = 3;
+  const int words = stride / 4;
+  const uint32_t valid_mask = (1u << words) - 1;
+  std::array<uint32_t, 16> previous{};
+  auto *destination = static_cast<uint8_t *>(records);
+  for (int record = 0; record < records_count; ++record) {
+    if (cursor + 2 > encoded.size()) throw std::runtime_error("Truncated internal mesh-light cache mask");
+    const uint32_t mask = uint32_t(encoded[cursor]) | (uint32_t(encoded[cursor + 1]) << 8);
+    cursor += 2;
+    if (mask & ~valid_mask) throw std::runtime_error("Malformed internal mesh-light cache mask");
+    for (int word = 0; word < words; ++word) {
+      if (mask & (1u << word)) {
+        uint32_t delta = 0;
+        int shift = 0;
+        for (;;) {
+          if (cursor == encoded.size() || shift > 28) throw std::runtime_error("Truncated internal mesh-light cache word");
+          const uint8_t byte = encoded[cursor++];
+          if (shift == 28 && byte > 15) throw std::runtime_error("Overflow in internal mesh-light cache word");
+          delta |= uint32_t(byte & 127) << shift;
+          if (!(byte & 128)) break;
+          shift += 7;
+        }
+        previous[word] ^= delta;
+      }
+      std::memcpy(destination + size_t(record) * stride + word * 4, &previous[word], 4);
+    }
+  }
+  if (cursor != encoded.size()) throw std::runtime_error("Trailing internal mesh-light cache bytes");
+}
+
+size_t LightTreeCacheBlocks::bytes() const
+{
+  size_t result = blocks.capacity() * sizeof(vector<uint8_t>);
+  for (const auto &block : blocks) result += block.capacity();
+  return result;
+}
+
+size_t LightTreeCachedNodes::bytes() const
+{
+  return raw.capacity() * sizeof(LightTreeCachedNode) + packed.bytes();
+}

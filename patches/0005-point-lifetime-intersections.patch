diff --git a/src/kernel/geom/point_lifetime.h b/src/kernel/geom/point_lifetime.h
new file mode 100644
index 0000000000000000000000000000000000000000..38610c12c18146233bd93464cce65336ab350469
--- /dev/null
+++ b/src/kernel/geom/point_lifetime.h
@@ -0,0 +1,30 @@
+/* SPDX-FileCopyrightText: 2026 Cycles Houdini contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include "kernel/geom/attribute.h"
+
+CCL_NAMESPACE_BEGIN
+
+#ifdef __POINTCLOUD__
+ccl_device_inline bool point_is_alive(KernelGlobals kg,
+                                     const int object,
+                                     const int prim,
+                                     const float time)
+{
+  if (!(kernel_data_fetch(object_flag, object) & SD_OBJECT_HAS_POINT_LIFETIME)) {
+    return true;
+  }
+  const AttributeDescriptor desc = find_attribute(kg, object, prim, ATTR_STD_POINT_LIFETIME);
+  if (!is_attribute_found(desc)) {
+    return true;
+  }
+  const float2 interval = attribute_data_fetch<float2>(kg, desc.element, desc.offset + prim);
+  /* A zero-length interval is always empty, including at shutter endpoints. */
+  return interval.x <= time && time < interval.y;
+}
+#endif
+
+CCL_NAMESPACE_END

Rationale: Interrupted dicing allocates buffers before filling them; publishing partial geometry can corrupt the next render rather than just cancel the current one.
Contract: subdivision interruption safety
Tests: tests/houdini_scene_interruption_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/scene/geometry.cpp b/src/scene/geometry.cpp
index 7f8fc7e8ed73fceda2283b3a5e172215cbf49763..db2900e737a1567066ca1d2f7e70d1c7fa3c0be2 100644
--- a/src/scene/geometry.cpp
+++ b/src/scene/geometry.cpp
@@ -968,6 +968,13 @@ void GeometryManager::device_update(Device *device,
       mesh->tessellate(subd_params);
     }
 
+    /* Dicing allocates the final buffers before filling them. An interrupted
+     * or failed tessellation can leave triangles incomplete; neither tangent
+     * generation nor any later geometry/device stage may consume them. */
+    if (progress.get_cancel() || progress.get_error()) {
+      return;
+    }
+
     /* Apply tangents for generated and UVs (if any need them) or remove if not needed */
     mesh->update_tangents(scene, true);
     if (!mesh->has_true_displacement()) {
@@ -975,7 +982,7 @@ void GeometryManager::device_update(Device *device,
     }
   });
 
-  if (progress.get_cancel()) {
+  if (progress.get_cancel() || progress.get_error()) {
     return;
   }
 

       return;
     }
 
@@ -161,7 +161,7 @@ void Mesh::tessellate(SubdParams &params)
     /* Split patches. */
     DiagSplit split(params);
     split.split_patches(linear_patches.data(), sizeof(LinearQuadPatch));
-    if (params.progress && params.progress->get_cancel()) {
+    if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
       return;
     }
 
@@ -177,7 +177,8 @@ void Mesh::tessellate(SubdParams &params)
     dice.dice(split);
   }
 
-  if ((!params.progress || !params.progress->get_cancel()) && subdivision_post_tessellate) {
+  if ((!params.progress || (!params.progress->get_cancel() && !params.progress->get_error())) &&
+      subdivision_post_tessellate) {
     subdivision_post_tessellate(*this);
   }
 

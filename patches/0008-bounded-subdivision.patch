diff --git a/src/subd/split.cpp b/src/subd/split.cpp
index 421f72304d988052d1bf89fc09b13fa65be37fb9..0a5bfd3c477af68fa7f915df374a1eb173861991 100644
--- a/src/subd/split.cpp
+++ b/src/subd/split.cpp
@@ -67,6 +67,17 @@ void DiagSplit::alloc_edge(SubPatch::Edge *sub_edge,
 
 void DiagSplit::alloc_subpatch(SubPatch &&sub)
 {
+  if (params.progress && params.progress->get_cancel()) {
+    return;
+  }
+  if (params.triangle_limit &&
+      uint64_t(num_triangles) + sub.calc_num_triangles() > params.triangle_limit) {
+    if (params.progress) {
+      params.progress->set_error("Subdivision triangle budget exceeded for " +
+                                 params.mesh->name.string());
+    }
+    return;
+  }
   assert(sub.edges[0].edge->T >= 1);
   assert(sub.edges[1].edge->T >= 1);
   assert(sub.edges[2].edge->T >= 1);
@@ -336,6 +347,9 @@ float2 DiagSplit::split_edge(const Patch *patch,
 
 void DiagSplit::split_quad(SubPatch &&sub)
 {
+  if (params.progress && params.progress->get_cancel()) {
+    return;
+  }
   /* Set edge factors if we haven't already. */
   resolve_edge_factors(sub);
 
@@ -576,6 +590,9 @@ void DiagSplit::split_quad_into_triangles(SubPatch &&sub)
 
 void DiagSplit::split_triangle(SubPatch &&sub)
 {
+  if (params.progress && params.progress->get_cancel()) {
+    return;
+  }
   assert(sub.shape == SubPatch::TRIANGLE);
 
   /* Set edge factors if we haven't already. */
@@ -767,6 +784,9 @@ void DiagSplit::split_patches(const Patch *patches, const size_t patches_byte_st
 
   /* Split all faces in the mesh. */
   for (int f = 0; f < params.mesh->get_num_subd_faces(); f++) {
+    if (params.progress && params.progress->get_cancel()) {
+      return;
+    }
     Mesh::SubdFace face = params.mesh->get_subd_face(f);
     const Patch *patch = (const Patch *)(((char *)patches) +
                                          (face.ptex_offset * patches_byte_stride));

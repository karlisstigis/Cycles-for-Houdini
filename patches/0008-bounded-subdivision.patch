@@ -167,6 +168,16 @@ class Mesh : public Geometry {
   NODE_SOCKET_API(Transform, subd_objecttoworld)
 
   AttributeSet subd_attributes;
+  /* Optional integration hook, run after interpolation on the update thread.
+   * Allows render-vertex seam preparation without splitting the control mesh. */
+  std::function<void(Mesh &)> subdivision_post_tessellate;
+  uint64_t subdivision_triangle_limit = 0; /* Zero keeps upstream behavior. */
+  void resize_subdivision_vertices(const int count)
+  {
+    const int base_count = get_num_subd_base_verts();
+    num_subd_added_verts = count - base_count;
+    resize_mesh(count, num_triangles());
+  }
 
   /* BVH */

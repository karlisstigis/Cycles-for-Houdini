diff --git a/src/scene/light_tree_reuse.h b/src/scene/light_tree_reuse.h
new file mode 100644
index 0000000000000000000000000000000000000000..e4418e03cdb12d6cff714dbf35e7c9150a62d577
--- /dev/null
+++ b/src/scene/light_tree_reuse.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "util/types.h"
+#include <unordered_map>
+
+CCL_NAMESPACE_BEGIN
+
+/* Exact output context of immutable cached interior rows. The live root is
+ * always regenerated. No source pointer or cache entry ownership is retained. */
+struct LightTreeFlattenRange {
+  uint64_t identity = 0;
+  int first_node = 0, num_nodes = 0, first_emitter = 0, object_id = 0;
+  size_t primitive_offset = 0;
+  uint visibility = 0, triangle_offset = 0;
+  bool operator==(const LightTreeFlattenRange &other) const
+  {
+    return identity == other.identity && first_node == other.first_node &&
+           num_nodes == other.num_nodes && first_emitter == other.first_emitter &&
+           object_id == other.object_id && primitive_offset == other.primitive_offset &&
+           visibility == other.visibility && triangle_offset == other.triangle_offset;
+  }
+};
+
+struct LightTreeFlattenCache {
+  std::unordered_map<int, LightTreeFlattenRange> ranges;
+};
+
+CCL_NAMESPACE_END

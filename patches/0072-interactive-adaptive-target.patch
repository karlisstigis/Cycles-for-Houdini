Rationale: Disabling the progressive noise floor lets the host own the interactive adaptive target without temporarily overriding its intended quality policy.
Contract: interactive adaptive target
Tests: tests/houdini_adaptive_target_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/integrator/render_scheduler.cpp b/src/integrator/render_scheduler.cpp
index 8085ea9f6491019f73165cd89933cbdb248729f6..12bf64220ed6ff4064e141db523c5427efe0312e 100644
--- a/src/integrator/render_scheduler.cpp
+++ b/src/integrator/render_scheduler.cpp
@@ -25,7 +25,7 @@ RenderScheduler::RenderScheduler(TileManager &tile_manager, const SessionParams
       tile_manager_(tile_manager),
       default_start_resolution_divider_(params.use_resolution_divider ? pixel_size_ * 8 : 0)
 {
-  use_progressive_noise_floor_ = !background_;
+  use_progressive_noise_floor_ = !background_ && params.use_progressive_noise_floor;
 }
 
 void RenderScheduler::set_need_schedule_cryptomatte(bool need_schedule_cryptomatte)
diff --git a/src/session/session.h b/src/session/session.h
index dd14083da044e665257772aaf9dd0b3a23376d91..2cf3c6a305926ca7c9dc290b933ecd40ba4a6cdd 100644
--- a/src/session/session.h
+++ b/src/session/session.h
@@ -65,6 +65,10 @@ class SessionParams {
 
   bool use_resolution_divider;
 
+  /* Interactive integrations may keep progressive display without temporarily
+   * relaxing the authored adaptive threshold. */
+  bool use_progressive_noise_floor;
+
   ShadingSystem shadingsystem;
 
   /* Session-specific temporary directory to store in-progress EXR files in. */
@@ -89,6 +93,7 @@ class SessionParams {
     tile_size = 2048;
 
     use_resolution_divider = true;
+    use_progressive_noise_floor = true;
 
     shadingsystem = SHADINGSYSTEM_SVM;
   }
@@ -102,6 +107,7 @@ class SessionParams {
              threads == params.threads && use_profiling == params.use_profiling &&
              use_auto_tile == params.use_auto_tile && tile_size == params.tile_size &&
              use_resolution_divider == params.use_resolution_divider &&
+             use_progressive_noise_floor == params.use_progressive_noise_floor &&
              shadingsystem == params.shadingsystem);
   }
 };

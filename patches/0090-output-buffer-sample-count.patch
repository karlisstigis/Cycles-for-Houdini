From 8a260fa49162b413a61f4ccd7e48470dbe2dbc4d Mon Sep 17 00:00:00 2001
From: Cycles Houdini candidate rebase <candidate@localhost>
Date: Wed, 11 Nov 2026 15:38:20 +0100
Subject: [PATCH] Expose current buffer samples independently of temporal
 progress

Rationale: Temporal progress survives accumulation resets and cannot de-normalize the current Sample Count pass. Preserve cumulative output metadata while exposing the matching current-buffer count.
Contract: Buffer sample statistics match pass normalization; existing output tile implementations retain their default non-temporal behavior.
Tests: tests/houdini_temporal_sample_count_smoke.py, tests/houdini_dlss_worker_smoke.py
---
 src/integrator/path_trace_tile.cpp | 5 +++++
 src/integrator/path_trace_tile.h   | 1 +
 src/session/output_driver.h        | 7 ++++++-
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/integrator/path_trace_tile.cpp b/src/integrator/path_trace_tile.cpp
index f848b46faa1531d58e9dc80e86b4b4e37ee8bfcf..094687efc6e7597911ff0c959e32fb61cc31cc01 100644
--- a/src/integrator/path_trace_tile.cpp
+++ b/src/integrator/path_trace_tile.cpp
@@ -28,6 +28,11 @@ int PathTraceTile::get_num_samples() const
   return path_trace_.get_total_render_tile_samples();
 }
 
+int PathTraceTile::get_num_buffer_samples() const
+{
+  return path_trace_.get_num_render_tile_samples();
+}
+
 const BufferPass *PathTraceTile::find_pass(const string_view pass_name) const
 {
   const BufferParams &buffer_params = path_trace_.get_render_tile_params();
diff --git a/src/integrator/path_trace_tile.h b/src/integrator/path_trace_tile.h
index 972f3498a21572c5dd268d12132c1fdc2cf44db6..20ec5b91be5e2e7355872c2e4b464978f12d3ea0 100644
--- a/src/integrator/path_trace_tile.h
+++ b/src/integrator/path_trace_tile.h
@@ -19,6 +19,7 @@ class PathTraceTile : public OutputDriver::Tile {
  public:
   PathTraceTile(PathTrace &path_trace);
   int get_num_samples() const override;
+  int get_num_buffer_samples() const override;
   int2 get_pass_render_size(const string_view pass_name) const override;
 
   bool get_pass_pixels(const string_view pass_name,
diff --git a/src/session/output_driver.h b/src/session/output_driver.h
index 6779c0b60ff0c46054154b067998e2e56fe38b0d..184aaab1216cc6690f591c843ac849b2b0e5cbbb 100644
--- a/src/session/output_driver.h
+++ b/src/session/output_driver.h
@@ -40,9 +40,14 @@ class OutputDriver {
     const string layer;
     const string view;
 
-    /* Optional sample statistics for host diagnostics and unnormalized passes. */
+    /* Optional cumulative sample statistics for host progress. */
     virtual int get_num_samples() const { return 0; }
 
+    /* Samples in the current accumulation buffer, matching pass normalization.
+     * Temporal denoisers may reset this buffer while cumulative progress advances.
+     * Existing drivers without temporal resets retain their sample-count behavior. */
+    virtual int get_num_buffer_samples() const { return get_num_samples(); }
+
     /* Actual sampling resolution before expansion to size. A denoised pass
      * may have a different resolution than a noisy/data pass. */
     virtual int2 get_pass_render_size(const string_view /*pass_name*/) const { return size; }

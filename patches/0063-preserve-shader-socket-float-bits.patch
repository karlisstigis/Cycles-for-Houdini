 CCL_NAMESPACE_BEGIN
 
+namespace {
+/* Keep socket change detection consistent with the existing raw-bit hashes and
+ * default-value comparison. Shader operations such as White Noise distinguish
+ * signed zero; numeric equality would discard an authored update. */
+template<typename T> bool socket_value_equal(const T &a, const T &b)
+{
+  if constexpr (std::is_same_v<T, float>) {
+    return std::memcmp(&a, &b, sizeof(float)) == 0;
+  }
+  else if constexpr (std::is_same_v<T, float2>) {
+    return socket_value_equal(a.x, b.x) && socket_value_equal(a.y, b.y);
+  }
+  else if constexpr (std::is_same_v<T, float3> || std::is_same_v<T, packed_float3>) {
+    /* The fourth float3 component is padding, and is not hashed. */
+    return socket_value_equal(a.x, b.x) && socket_value_equal(a.y, b.y) &&
+           socket_value_equal(a.z, b.z);
+  }
+  else if constexpr (std::is_same_v<T, float4>) {
+    return socket_value_equal(a.x, b.x) && socket_value_equal(a.y, b.y) &&
+           socket_value_equal(a.z, b.z) && socket_value_equal(a.w, b.w);
+  }
+  else if constexpr (std::is_same_v<T, Transform>) {
+    return socket_value_equal(a.x, b.x) && socket_value_equal(a.y, b.y) &&
+           socket_value_equal(a.z, b.z);
+  }
+  else {
+    return a == b;
+  }
+}
+}  // namespace
+
 /* Node Type */
 
 NodeOwner::~NodeOwner() = default;

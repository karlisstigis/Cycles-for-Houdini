diff --git a/src/kernel/camera/image_iris.h b/src/kernel/camera/image_iris.h
index ebdd3b12688e67e6dd39d26f525d1af3bcb22caf..a7b3a4bf62c1ba9ec00014a1d035c4de72021256 100644
--- a/src/kernel/camera/image_iris.h
+++ b/src/kernel/camera/image_iris.h
@@ -3,9 +3,11 @@
 
 CCL_NAMESPACE_BEGIN
 
-/* Packed resource: width, height, padded hierarchy side, reserved, pixel offset,
+/* Packed resource: width, height, padded hierarchy side, RGB offset, pixel offset,
  * conditional CDF offset, marginal CDF offset, hierarchy offset. The hierarchy
  * stores square levels root first. Image vertices define bilinear cells.
+ * RGB offset zero denotes scalar gray transmission. Optional RGB vertices use
+ * the same common scale as the density and are appended after the hierarchy.
  * Both mappings consume only the camera's original two lens dimensions. */
 ccl_device_inline float image_iris_linear_sample(const float u, const float a, const float b)
 {
@@ -87,4 +89,36 @@ ccl_device_inline float2 image_iris_sample(const Table &table,
                      (float(y) + v) / float(cells_y));
 }
 
+template<typename Table>
+ccl_device_inline float3 image_iris_weight(const Table &table, const float2 uv)
+{
+  const int rgb_offset = int(table(3));
+  if (rgb_offset == 0) return one_float3();
+  const int width = int(table(0)), height = int(table(1));
+  const float px = saturatef(uv.x) * float(width - 1);
+  const float py = saturatef(uv.y) * float(height - 1);
+  const int x = min(int(px), width - 2), y = min(int(py), height - 2);
+  const float u = px - float(x), v = py - float(y);
+  const int pixel = y * width + x;
+  const int a = rgb_offset + 3 * pixel, b = a + 3;
+  const int c = a + 3 * width, d = c + 3;
+  const float3 ra = make_float3(table(a), table(a + 1), table(a + 2));
+  const float3 rb = make_float3(table(b), table(b + 1), table(b + 2));
+  const float3 rc = make_float3(table(c), table(c + 1), table(c + 2));
+  const float3 rd = make_float3(table(d), table(d + 1), table(d + 2));
+  const int density = int(table(4)) + pixel;
+  const float ya = table(density), yb = table(density + 1);
+  const float yc = table(density + width), yd = table(density + width + 1);
+  const float3 rgb = mix(mix(ra, rb, u), mix(rc, rd, u), v);
+  const float luminance = mix(mix(ya, yb, u), mix(yc, yd, u), v);
+  /* Density is proportional to luminance. RGB / luminance keeps the natural
+   * filter tint while applying one common exposure compensation, never a
+   * separate white balance for each channel. Alpha is already in both tables.
+   * Exact zero-density endpoints can occur after inverse-CDF float rounding:
+   * use the finite cell mean rather than divide by zero or invent channels. */
+  if (luminance > 0.0f) return rgb / luminance;
+  const float mean_luminance = ya + yb + yc + yd;
+  return mean_luminance > 0.0f ? (ra + rb + rc + rd) / mean_luminance : zero_float3();
+}
+
 CCL_NAMESPACE_END

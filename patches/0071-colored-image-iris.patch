+      kernel_data.cam.image_iris_offset >= 0 && kernel_data.cam.type != CAMERA_CUSTOM)
+  {
+    /* These standard camera models return only the normalized iris RGB gain.
+     * Normalize its scalar transparency separately so aperture tint does not
+     * change geometric/achromatic coverage. Do not normalize custom camera T,
+     * which can encode an intentional physical sensor or exposure response. */
+    const float iris_average = average(T);
+    INTEGRATOR_STATE_WRITE(state, path, image_iris_transparency_scale) =
+        iris_average > 0.0f ? 1.0f / iris_average : 1.0f;
+  }
+#endif
+
   return true;
 }
 

 CCL_NAMESPACE_BEGIN
 
+/* The colored iris uses a common exposure gain for radiance. Scalar coverage
+ * must not inherit that initial RGB gain: empty transparent backgrounds retain
+ * alpha zero and opaque hits retain geometric coverage in alpha, Cryptomatte,
+ * Mist and shadow-catcher mattes. Subsequent colored material/volume
+ * transmission remains filtered by the camera response. The path scalar is
+ * copied with the state when shadow-catcher paths split. Radiance is unchanged. */
+ccl_device_inline float film_camera_coverage_weight(ConstIntegratorState state,
+                                                   const float weight)
+{
+#ifdef WITH_IMAGE_IRIS
+  return weight * INTEGRATOR_STATE(state, path, image_iris_transparency_scale);
+#else
+  return weight;
+#endif
+}
+
 /* Get pointer to pixel in render buffer. */
 
 ccl_device_forceinline ccl_global float *film_pass_pixel_render_buffer(

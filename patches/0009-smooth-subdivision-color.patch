Rationale: Packed float3 face-varying data must use packed reads and the smooth evaluator; this fixes color interpolation independent of the host.
Contract: Read float3 face-varying values with packed storage and enable the existing smooth evaluator for packed float3.
Tests: tests/houdini_subdivision_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/subd/interpolation.cpp b/src/subd/interpolation.cpp
index e29499ab13255008d34a92c83eba2cc5683b0aa9..5aacc71863b34d24df0c2fe77c3cda13096cb664 100644
--- a/src/subd/interpolation.cpp
+++ b/src/subd/interpolation.cpp
@@ -626,7 +626,8 @@ void SubdAttributeInterpolation::setup_attribute_type(const Attribute &subd_attr
       if (osd_mesh.use_smooth_fvar(subd_attr)) {
         for (const auto &merged_fvar : osd_mesh.merged_fvars) {
           if (&merged_fvar.attr == &subd_attr) {
-            if constexpr (std::is_same_v<typename T::Type, float2>) {
+            if constexpr (std::is_same_v<typename T::Type, float2> ||
+                          std::is_same_v<typename T::Type, packed_float3>) {
               setup_attribute_corner_smooth<T>(mesh_attr, merged_fvar.channel, merged_fvar.values);
               return;
             }

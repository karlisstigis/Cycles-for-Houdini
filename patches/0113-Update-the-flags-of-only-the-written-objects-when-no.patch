 {
   if (!need_update() && !need_flags_update) {
@@ -1530,6 +1539,9 @@ void ObjectManager::device_update_flags(Device * /*unused*/,
     }
   });
 
+  /* A flags update requested by the scene (nested dielectrics, displacement, a full rewrite)
+   * covers every object. */
+  const bool flags_full_requested = need_flags_update;
   if (bounds_valid) {
     /* Object flags and calculations related to volume depend on proper bounds calculated, which
      * might not be available yet when object flags are updated for displacement or hair
@@ -1547,24 +1559,24 @@ void ObjectManager::device_update_flags(Device * /*unused*/,
   /* Object info flag. */
   uint *object_flag = dscene->object_flag.data();
 
-  /* Object volume intersection. */
-  vector<BoundBoxOverlapIndex::Entry> volume_bounds;
-  bool has_volume_objects = false;
-  for (Object *object : scene->objects) {
-    if (object->geometry->has_volume) {
-      /* If the bounds are not valid it is not always possible to calculate the volume step, and
-       * the step size is not needed for the displacement. So, delay calculation of the volume
-       * step size until the final bounds are known. */
-      if (bounds_valid) {
-        volume_bounds.push_back({&object->bounds, object});
-      }
-      has_volume_objects = true;
-    }
-  }
-
-  const BoundBoxOverlapIndex volume_objects(std::move(volume_bounds));
-
-  for (Object *object : scene->objects) {
+  /* When only a few objects were written by the transforms step of this update (the partial object
+   * table, which rewrites their base flags), no volume object exists, no flags update was
+   * requested (nested dielectrics, displacement) and no shader changed, the flags of every other
+   * object are those of the previous pass: update only the written objects. A flags pass that did
+   * not complete after an object update (cancel or error in between) leaves flags_pending set and
+   * the next pass updates every object. CYCLES_FULL_OBJECT_FLAGS updates every object as before,
+   * as a reference; CYCLES_VERIFY_OBJECT_FLAGS compares a partial result, on the host and on every
+   * device, with updating every object. */
+  static const bool full_flags = getenv("CYCLES_FULL_OBJECT_FLAGS") != nullptr;
+  static const bool verify_flags = getenv("CYCLES_VERIFY_OBJECT_FLAGS") != nullptr;
+  const bool partial = !full_flags && bounds_valid && flags_partial_valid && !flags_full_requested &&
+                       !flags_have_volume && !scene->shaders_updated_this_update &&
+                       dscene->object_flag.size() == scene->objects.size() &&
+                       dscene->object_flag.device_pointer != 0 && !dscene->object_flag.need_realloc();
+
+  auto update_object = [&](Object *object,
+                           const BoundBoxOverlapIndex &volume_objects,
+                           const bool has_volume_objects) {
     if (object->geometry->has_volume) {
       object_flag[object->index] |= SD_OBJECT_HAS_VOLUME;
       object_flag[object->index] &= ~SD_OBJECT_HAS_VOLUME_ATTRIBUTES;
@@ -1615,11 +1627,97 @@ void ObjectManager::device_update_flags(Device * /*unused*/,
        */
       object_flag[object->index] |= SD_OBJECT_INTERSECTS_VOLUME;
     }
+  };
+
+  if (partial) {
+    const BoundBoxOverlapIndex no_volume_objects(vector<BoundBoxOverlapIndex::Entry>{});
+    vector<DeviceMemoryRange> ranges;
+    for (Object *object : flags_partial_objects) {
+      update_object(object, no_volume_objects, false);
+      const size_t offset = size_t(object->index) * sizeof(uint);
+      if (!ranges.empty() && ranges.back().offset + ranges.back().size == offset) {
+        ranges.back().size += sizeof(uint);
+      }
+      else {
+        ranges.push_back({offset, sizeof(uint)});
+      }
+    }
+    if (!ranges.empty() && !dscene->object_flag.copy_to_device_ranges(ranges)) {
+      dscene->object_flag.copy_to_device();
+    }
+    dscene->object_flag.clear_modified();
+    if (scene->update_stats) {
+      /* Counts, not times. */
+      scene->update_stats->object.times.add_entry({"partial object flags updates", 1.0});
+      scene->update_stats->object.times.add_entry(
+          {"partial object flags objects", double(flags_partial_objects.size())});
+    }
+    if (verify_flags) {
+      string difference;
+      const size_t n = scene->objects.size();
+      const vector<uint> kept(object_flag, object_flag + n);
+      vector<uint8_t> intersects(n);
+      for (size_t i = 0; i < n; i++) {
+        intersects[i] = scene->objects[i]->intersects_volume;
+      }
+      if (!device->verify_device_copy(dscene->object_flag, difference)) {
+        progress.set_error("Object flags verification failed: " + difference);
+      }
+      else {
+        const BoundBoxOverlapIndex no_volume_objects(vector<BoundBoxOverlapIndex::Entry>{});
+        for (Object *object : scene->objects) {
+          if (object->geometry->has_volume) {
+            progress.set_error("Object flags verification failed: volume object " +
+                               object->name.string() + " on the partial path");
+            break;
+          }
+          update_object(object, no_volume_objects, false);
+        }
+        for (size_t i = 0; i < n && !progress.get_error(); i++) {
+          if (kept[i] != object_flag[i] || bool(intersects[i]) != scene->objects[i]->intersects_volume) {
+            progress.set_error(string_printf(
+                "Object flags verification failed: object %zu (%s) flags %x, all objects give %x", i,
+                scene->objects[i]->name.c_str(), kept[i], object_flag[i]));
+          }
+        }
+      }
+      if (scene->update_stats) {
+        scene->update_stats->object.times.add_entry({"object flags verifications", 1.0});
+      }
+    }
   }
+  else {
+    /* Object volume intersection. */
+    vector<BoundBoxOverlapIndex::Entry> volume_bounds;
+    bool has_volume_objects = false;
+    for (Object *object : scene->objects) {
+      if (object->geometry->has_volume) {
+        /* If the bounds are not valid it is not always possible to calculate the volume step, and
+         * the step size is not needed for the displacement. So, delay calculation of the volume
+         * step size until the final bounds are known. */
+        if (bounds_valid) {
+          volume_bounds.push_back({&object->bounds, object});
+        }
+        has_volume_objects = true;
+      }
+    }
+
+    const BoundBoxOverlapIndex volume_objects(std::move(volume_bounds));
+
+    for (Object *object : scene->objects) {
+      update_object(object, volume_objects, has_volume_objects);
+    }
+    flags_have_volume = has_volume_objects;
 
-  /* Copy object flag. */
-  dscene->object_flag.copy_to_device();
-  dscene->object_flag.clear_modified();
+    /* Copy object flag. */
+    dscene->object_flag.copy_to_device();
+    dscene->object_flag.clear_modified();
+  }
+  if (bounds_valid) {
+    flags_pending = false;
+    flags_partial_valid = false;
+    flags_partial_objects.clear();
+  }
 }
 

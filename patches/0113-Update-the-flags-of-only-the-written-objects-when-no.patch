   if (update_flags & (OBJECT_ADDED | OBJECT_REMOVED)) {
     dscene->objects.tag_realloc();
@@ -1514,10 +1523,10 @@ void ObjectManager::device_update(Device *device,
   }
 }
 
-void ObjectManager::device_update_flags(Device * /*unused*/,
+void ObjectManager::device_update_flags(Device *device,
                                         DeviceScene *dscene,
                                         Scene *scene,
-                                        Progress & /*progress*/,
+                                        Progress &progress,

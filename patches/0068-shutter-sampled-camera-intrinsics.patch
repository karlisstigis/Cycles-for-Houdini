+/* Owned active projection samples; negative time selects requested-frame optics. */
+ccl_device_inline KernelCameraIntrinsic camera_intrinsic_at(ccl_constant KernelCamera *cam,
+    const ccl_global KernelCameraIntrinsic *motion, const float time)
+{
+  if (time < 0.0f || !cam->num_intrinsic_motion_steps || motion == nullptr) return cam->intrinsic;
+  const float position = saturatef(time) * float(cam->num_intrinsic_motion_steps - 1);
+  const int index = min(int(position), cam->num_intrinsic_motion_steps - 2);
+  const float fraction = position - float(index);
+  KernelCameraIntrinsic result;
+  result.projection = motion[index].projection * (1.0f - fraction) + motion[index + 1].projection * fraction;
+  result.fisheye = motion[index].fisheye * (1.0f - fraction) + motion[index + 1].fisheye * fraction;
+  result.equirectangular_range = motion[index].equirectangular_range * (1.0f - fraction) + motion[index + 1].equirectangular_range * fraction;
+  result.cylindrical_range = motion[index].cylindrical_range * (1.0f - fraction) + motion[index + 1].cylindrical_range * fraction;
+  result.polynomial = motion[index].polynomial * (1.0f - fraction) + motion[index + 1].polynomial * fraction;
+  result.extra = motion[index].extra * (1.0f - fraction) + motion[index + 1].extra * fraction;
+  return result;
+}
+ccl_device_inline float3 camera_intrinsic_raster(ccl_constant KernelCamera *cam,
+    const ccl_private KernelCameraIntrinsic &intrinsic,const float2 raster)
+{
+  const float scale = cam->type == CAMERA_PERSPECTIVE ? intrinsic.projection.z : intrinsic.projection.w;
+  return make_float3((cam->intrinsic_raster.x + raster.x * cam->intrinsic_raster.z) * scale,
+                     (cam->intrinsic_raster.y + raster.y * cam->intrinsic_raster.w) * scale,
+                     cam->type == CAMERA_PERSPECTIVE ? 1.0f : 0.0f);
+}
+ccl_device_inline float3 camera_intrinsic_project(ccl_constant KernelCamera *cam,
+    const ccl_private KernelCameraIntrinsic &intrinsic,const float3 point)
+{
+  /* Match transform_perspective at a shutter endpoint on the lens plane. */
+  if (cam->type == CAMERA_PERSPECTIVE && point.z == 0.0f) return zero_float3();
+  const float scale = cam->type == CAMERA_PERSPECTIVE ? intrinsic.projection.z : intrinsic.projection.w;
+  const float inverse_z = cam->type == CAMERA_PERSPECTIVE ? 1.0f / point.z : 1.0f;
+  return make_float3(((point.x * inverse_z / scale) - cam->intrinsic_raster.x) / (cam->intrinsic_raster.z * cam->width),
+                     ((point.y * inverse_z / scale) - cam->intrinsic_raster.y) / (cam->intrinsic_raster.w * cam->height),
+                     0.0f);
+}
+

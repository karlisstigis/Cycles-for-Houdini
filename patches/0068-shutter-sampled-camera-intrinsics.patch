+    if (panorama_type == PANORAMA_FISHEYE_EQUISOLID) return !(sample.fisheye == nominal.fisheye);
+    if (panorama_type == PANORAMA_FISHEYE_LENS_POLYNOMIAL) return sample.fisheye.x != nominal.fisheye.x ||

   NODE_SOCKET_API_ARRAY(array<int>, shader)
   NODE_SOCKET_API_ARRAY(array<bool>, smooth)
   NODE_SOCKET_API(bool, motion_displacement)
+  NODE_SOCKET_API_ARRAY(array<int>, motion_displacement_shader_slots)
 
   /* SubdFaces */
   NODE_SOCKET_API_ARRAY(array<int>, subd_start_corner)
diff --git a/src/scene/mesh_displace.cpp b/src/scene/mesh_displace.cpp
index 3bf8a4f18bf9d352d8e929de6d1185bacb412f74..06deb55af41962d4bbacffa8e2ade3d7c443344a 100644
--- a/src/scene/mesh_displace.cpp
+++ b/src/scene/mesh_displace.cpp
@@ -33,6 +33,8 @@ static int fill_shader_input(const Scene *scene,
 
   const int num_triangles = mesh->num_triangles();
   const int steps = mesh->get_motion_displacement() ? std::max(1u, mesh->get_motion_steps()) : 1;
+  const auto &temporal = mesh->get_motion_displacement_shader_slots();
+  const size_t palette_size = temporal.empty() ? 0 : temporal.size() / steps;
   for (int step = 0; step < steps; step++) {
     std::fill(done.begin(), done.end(), false);
     for (int i = 0; i < num_triangles; i++) {
@@ -81,6 +83,9 @@ static int fill_shader_input(const Scene *scene,
         in.u = u;
         in.v = v;
         in.time = steps == 1 ? 0.5f : float(step) / float(steps - 1);
+        in.shader = palette_size ? scene->shader_manager->get_shader_id(
+                                       static_cast<Shader *>(mesh_used_shaders[temporal[step * palette_size + shader_index]]), true) :
+                                   SHADER_NONE;
         d_input_data[d_input_size++] = in;
       }
     }

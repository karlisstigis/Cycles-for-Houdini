Rationale: Motion displacement shader slots allow time-varying shader identities while preserving shader flag bits; the added socket requires adapter ownership.
Contract: temporal displacement shaders
Tests: tests/houdini_temporal_displacement_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/kernel/bake/bake.h b/src/kernel/bake/bake.h
index 13347be699dc2e67b703902fa8728ab522ff29c1..a1ba7a7fc97915301ce77b3e5f27eb680da9d5da 100644
--- a/src/kernel/bake/bake.h
+++ b/src/kernel/bake/bake.h
@@ -32,6 +32,11 @@ ccl_device void kernel_displace_evaluate(KernelGlobals kg,
 
   ShaderData sd;
   shader_setup_from_displace(kg, &sd, in.object, in.prim, in.u, in.v, in.time);
+  /* Smooth/shadow flags occupy the sign bit of a valid shader ID. */
+  if (in.shader != SHADER_NONE) {
+    sd.shader = in.shader;
+    sd.shader_flag = kernel_data_fetch(shaders, sd.shader & SHADER_MASK).flags;
+  }
 
   /* Evaluate displacement shader. */
   ConstIntegratorBakeState state;
diff --git a/src/kernel/types.h b/src/kernel/types.h
index d200d155a2fabcc5d4df4a4066a6de36e8ba2990..e7cb7bf1fa8faf66d9922fb0eb70923cb39d367b 100644
--- a/src/kernel/types.h
+++ b/src/kernel/types.h
@@ -1781,7 +1781,8 @@ struct KernelShaderEvalInput {
   int prim;
   float u, v;
   float time;
-  float pad[3];
+  int shader;
+  float pad[2];
 };
 static_assert_align(KernelShaderEvalInput, 16);
 

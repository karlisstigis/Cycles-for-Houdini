     if (light->is_enabled) {
@@ -1795,10 +1824,7 @@ void LightManager::device_update_lights(DeviceScene *dscene, Scene *scene)
   int light_index = 0;
   int portal_index = kintegrator->num_lights;
 
-  for (const Object *object : scene->objects) {
-    if (!object->get_geometry()->is_light()) {
-      continue;
-    }
+  for (const Object *object : light_objects(scene)) {
 
     const Light *light = static_cast<const Light *>(object->get_geometry());
     if (light->is_portal_light()) {
@@ -1831,6 +1857,18 @@ void LightManager::device_update(Device *device,
     }
   });
 
+  static const bool verify_light_list = getenv("CYCLES_VERIFY_LIGHT_LIST") != nullptr;
+  if (verify_light_list) {
+    string difference;
+    if (!verify_light_objects(scene, difference)) {
+      progress.set_error("Light list verification failed: " + difference);
+      return;
+    }
+    if (scene->update_stats) {
+      scene->update_stats->light.times.add_entry({"light list verifications", 1.0});
+    }
+  }
+
   /* Detect which lights are enabled, also determines if we need to update the background. */
   test_enabled_lights(scene);
 

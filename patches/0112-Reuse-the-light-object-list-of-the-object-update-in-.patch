diff --git a/src/scene/light.cpp b/src/scene/light.cpp
index a8fae41dc4ac2d48269e9095c297c7d9ad160e7f..5dd58940b89be593a6d85eda5de2a14f4fadc157 100644
--- a/src/scene/light.cpp
+++ b/src/scene/light.cpp
@@ -508,12 +508,50 @@ LightManager::LightManager()
 
 LightManager::~LightManager() = default;
 
-bool LightManager::has_background_light(Scene *scene)
+/* The light objects of the scene in object order. The object manager collects them while assigning
+ * object indices, so a light edit does not walk every object of the scene again (several times).
+ * CYCLES_FULL_LIGHT_WALK walks every object as before, as a reference. */
+const vector<Object *> &LightManager::light_objects(const Scene *scene)
 {
-  for (Object *object : scene->objects) {
+  static const bool full_walk = getenv("CYCLES_FULL_LIGHT_WALK") != nullptr;
+  const ObjectManager *object_manager = scene->object_manager.get();
+  if (!full_walk && object_manager->light_objects_valid) {
+    return object_manager->light_objects;
+  }
+  walked_light_objects.clear();
+  for (const Object *object : scene->objects) {
+    if (object->get_geometry()->is_light()) {
+      walked_light_objects.push_back(const_cast<Object *>(object));
+    }
+  }
+  return walked_light_objects;
+}
+
+/* CYCLES_VERIFY_LIGHT_LIST: the light objects used are those found by walking every object. */
+bool LightManager::verify_light_objects(const Scene *scene, string &difference)
+{
+  const vector<Object *> &used = light_objects(scene);
+  size_t k = 0;
+  for (const Object *object : scene->objects) {
     if (!object->get_geometry()->is_light()) {
       continue;
     }
+    if (k >= used.size() || used[k] != object) {
+      difference = "light object " + object->name.string() + " missing or out of order";
+      return false;
+    }
+    k++;
+  }
+  if (k != used.size()) {
+    difference = string_printf("%zu light objects listed, %zu in the scene", used.size(), k);
+    return false;
+  }
+  return true;
+}
+

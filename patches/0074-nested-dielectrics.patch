+uint64_t Device::mem_read_uint32_counter(device_memory &mem)
+{
+  assert(mem.data_type == TYPE_UINT && mem.data_elements == 1 && mem.data_size == 1);
+  if (info.type == DEVICE_CPU) {
+    return *reinterpret_cast<const uint *>(mem.device_pointer);
+  }
+  uint value = 0;
+  void *host = mem.host_pointer;
+  mem.host_pointer = &value;
+  try {
+    mem_copy_from(mem, 0, 1, 1, sizeof(value));
+  }
+  catch (...) {
+    mem.host_pointer = host;
+    throw;
+  }
+  mem.host_pointer = host;
+  return value;
+}
+
 device_ptr Device::mem_device_ptr(const device_memory &mem, Device *sub_device)
 {
   assert(sub_device == this);

 /* Calculate the path contribution. */
+#ifdef __VOLUME__
+/* Nested dielectrics: manifold walks assume every caster interface is against air. The solved chain
+ * (receiver -> vertices -> light) is classified with the integrator's rule, starting from the
+ * receiver's nested stack: if any crossing on it is buried or not against air, the chain is rejected
+ * here (MNEE contributes nothing) and the BSDF continuation that follows the same chain is not culled,
+ * because shade_surface.h sets PATH_MNEE_NESTED at the same crossings. So each specular chain is
+ * counted by exactly one estimator. Surfaces between the receiver and the vertices are already
+ * rejected by the visibility retrace below; the segment after the last vertex is walked here. */
+#  define MNEE_NESTED_LAST_SEGMENT_MAX 64
+#  define MNEE_NESTED_MAX \
+    (MAX_VOLUME_STACK_SIZE + MNEE_MAX_CAUSTIC_CASTERS + MNEE_NESTED_LAST_SEGMENT_MAX)
+
+/* Classify one crossing against the local media list. Returns true for a nested crossing. If the
+ * crossing is not nested, an object already in the list is removed (segments are straight, so every
+ * crossing enters or leaves) and *r_enter tells the caller to append the object with its IOR. */
+ccl_device_inline bool mnee_nested_cross(KernelGlobals kg,
+                                         ccl_private int *objects,
+                                         ccl_private float *iors,
+                                         ccl_private int &num,
+                                         const int object,
+                                         const int shader,
+                                         ccl_private bool *r_enter)
+{
+  *r_enter = false;
+  const int shader_flags = kernel_data_fetch(shaders, (shader & SHADER_MASK)).flags;
+  if (!nested_flags_participate(kernel_data_fetch(object_flag, object), shader_flags)) {
+    return false;
+  }
+  if (nested_list_is_nested_crossing(kg, objects, iors, num, object)) {
+    return true;
+  }
+  for (int i = 0; i < num; i++) {
+    if (objects[i] == object) {
+      for (int j = i; j + 1 < num; j++) {
+        objects[j] = objects[j + 1];
+        iors[j] = iors[j + 1];
+      }
+      num--;
+      return false;
+    }
+  }
+  *r_enter = true;
+  return false;
+}
+
+/* IOR of the medium entered at a chain crossing, as the BSDF side stores it: the shader's constant,
+ * or for a graph-driven IOR the value recorded by a recording-only evaluation at the crossing
+ * (nested_entry_ior), the same rule as buried hits, the camera probe and the SSS replay. */
+ccl_device_forceinline float mnee_nested_entry_ior(KernelGlobals kg,
+                                                   ConstIntegratorState state,
+                                                   ccl_private ShaderData *sd,
+                                                   ccl_private bool *r_cache_miss)
+{
+  const float c = kernel_data_fetch(shaders, (sd->shader & SHADER_MASK)).nested_ior;
+  if (c > 0.0f) {
+    return c;
+  }
+  sd->runtime_flag |= SR_NESTED_ACTIVE | SR_NESTED_MASKED;
+  sd->nested_opposite_ior = 1.0f;
+  sd->nested_ior_sum = 0.0f;
+  sd->nested_ior_weight = 0.0f;
+  surface_shader_eval<KERNEL_FEATURE_NODE_MASK_SURFACE_SHADOW>(
+      kg, state, sd, nullptr, PATH_RAY_VISIBILITY_SHADOW, PATH_RAY_FLAG_NONE);
+  if (sd->runtime_flag & SR_CACHE_MISS) {
+    *r_cache_miss = true;
+    return 1.0f;
+  }
+  return nested_entry_ior(kg, sd);
+}
+
+#  define MNEE_NESTED_ACCEPT 0
+#  define MNEE_NESTED_REJECT 1
+#  define MNEE_NESTED_CACHE_MISS 2
+
+/* The list is sized for the stack plus every possible crossing, so it cannot overflow. */
+ccl_device int mnee_nested_chain_check(KernelGlobals kg,
+                                       ConstIntegratorState state,
+                                       const ccl_private LightSample *ls,
+                                       const bool light_fixed_direction,
+                                       const int vertex_count,
+                                       const ccl_private ManifoldVertex *vertices,
+                                       const float time)
+{
+  if (!kernel_data.integrator.nested_dielectrics) {
+    return MNEE_NESTED_ACCEPT;
+  }
+  int objects[MNEE_NESTED_MAX];
+  float iors[MNEE_NESTED_MAX];
+  int num = 0;
+  for (int i = 0; i < kernel_data.integrator.nested_stack_size && i < MAX_VOLUME_STACK_SIZE; i++) {
+    const int object = INTEGRATOR_STATE_ARRAY(state, nested_stack, i, object);
+    if (object == OBJECT_NONE) {
+      break;
+    }
+    objects[num] = object;
+    iors[num] = INTEGRATOR_STATE_ARRAY(state, nested_stack, i, ior);
+    num++;
+  }
+
+  ShaderDataTinyStorage entry_sd_storage;
+  ccl_private ShaderData *entry_sd = AS_SHADER_DATA(&entry_sd_storage);
+  bool cache_miss = false;
+
+  for (int vi = 0; vi < vertex_count; vi++) {
+    const ccl_private ManifoldVertex &v = vertices[vi];
+    bool enter = false;
+    if (mnee_nested_cross(kg, objects, iors, num, v.object, v.shader, &enter)) {
+      return MNEE_NESTED_REJECT;
+    }
+    if (enter) {
+      /* Evaluated at the solved vertex, where the BSDF side would record it. */
+      shader_setup_from_sample(kg,
+                               entry_sd,
+                               v.p,
+                               v.n,
+                               v.n,
+                               v.shader,
+                               v.object,
+                               v.prim,
+                               v.uv.x,
+                               v.uv.y,
+                               0.0f,
+                               time,
+                               false,
+                               false);
+      iors[num] = mnee_nested_entry_ior(kg, state, entry_sd, &cache_miss);
+      if (cache_miss) {
+        return MNEE_NESTED_CACHE_MISS;
+      }
+      objects[num] = v.object;
+      num++;
+    }
+  }
+
+  /* Segment from the last vertex to the light. */
+  const ccl_private ManifoldVertex &last = vertices[vertex_count - 1];
+  Ray ray;
+  ray.P = last.p;
+  if (light_fixed_direction) {
+    ray.D = ls->D;
+    ray.tmax = FLT_MAX;
+  }
+  else {
+    ray.D = normalize_len(ls->P - last.p, &ray.tmax);
+  }
+  ray.tmin = 0.0f;
+  ray.time = time;
+  ray.dP = differential_zero_compact();
+  ray.dD = differential_zero_compact();
+  ray.self.object = last.object;
+  ray.self.prim = last.prim;
+  ray.self.light_object = ls->object;

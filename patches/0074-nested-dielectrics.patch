+#ifdef __VOLUME__
+/* Nested dielectrics. Participating objects get their own probes: ordinary closest-hit queries
+ * stepping along a ray, independent of the volume probe and its SD_OBJECT_HAS_VOLUME filter.
+ * Non-participating hits are stepped over without shading; the budget is in hits, large enough
+ * for dense scenes. If it runs out, objects whose boundary was not reached are treated as not
+ * containing the probe origin (nothing is fabricated). */
+#  define NESTED_PROBE_MAX_STEPS 4096
+
+ccl_device_forceinline bool nested_probe_hit_participates(KernelGlobals kg,
+                                                          const ccl_private Intersection *isect)
+{
+  if (!(isect->type & PRIMITIVE_TRIANGLE)) {
+    return false;
+  }
+  const int shader = intersection_get_shader(kg, isect);
+  return nested_flags_participate(kernel_data_fetch(object_flag, isect->object),
+                                  kernel_data_fetch(shaders, shader).flags);
+}
+
+/* IOR of the medium behind a probe hit. A graph-driven IOR (KernelShader.nested_ior <= 0) is
+ * evaluated here like at a buried hit; the refractive closures record it and allocate nothing.
+ * A texture cache miss is reported through r_cache_miss (the caller commits nothing and retries). */
+ccl_device_forceinline float nested_probe_entry_ior(KernelGlobals kg,
+                                                    ConstIntegratorState state,
+                                                    ccl_private ShaderData *sd,
+                                                    ccl_private bool &r_cache_miss)
+{
+  const float c = kernel_data_fetch(shaders, (sd->shader & SHADER_MASK)).nested_ior;
+  if (c > 0.0f) {
+    return c;
+  }
+  sd->runtime_flag |= SR_NESTED_ACTIVE | SR_NESTED_MASKED;
+  sd->nested_opposite_ior = 1.0f;
+  sd->nested_ior_sum = 0.0f;
+  sd->nested_ior_weight = 0.0f;
+  surface_shader_eval<KERNEL_FEATURE_NODE_MASK_SURFACE_SHADOW>(
+      kg, state, sd, nullptr, PATH_RAY_VISIBILITY_SHADOW, PATH_RAY_FLAG_NONE);
+  if (sd->runtime_flag & SR_CACHE_MISS) {
+    r_cache_miss = true;
+    return 1.0f;
+  }
+  return nested_entry_ior(kg, sd);
+}
+
+/* Camera inside participating objects: shoot a +Z ray and keep parity per object. A front face
+ * means the probe entered the object (it cannot contain the camera); its back face then removes it
+ * again. A back face of an object that was not entered along the probe means the camera is inside.
+ * Entries are written outermost first (order of entry). The list of objects entered along the
+ * probe holds what the probe is currently inside, so it stays as small as the nesting depth; if it
+ * overflows, back faces of untracked objects are ignored (treated as not containing the camera). */
+ccl_device bool integrator_nested_stack_init(KernelGlobals kg, IntegratorState state)
+{
+  ShaderDataTinyStorage stack_sd_storage;
+  ccl_private ShaderData *stack_sd = AS_SHADER_DATA(&stack_sd_storage);
+
+  Ray ray ccl_optional_struct_init;
+  integrator_state_read_ray(state, &ray);
+  ray.D = make_float3(0.0f, 0.0f, 1.0f);
+  ray.tmin = 0.0f;
+  ray.tmax = FLT_MAX;
+  ray.self.object = OBJECT_NONE;
+  ray.self.prim = PRIM_NONE;
+  ray.self.light_object = OBJECT_NONE;
+  ray.self.light_prim = PRIM_NONE;
+
+  const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
+  const uint visibility = SHADOW_CATCHER_PATH_VISIBILITY(path_flag, PATH_RAY_VISIBILITY_CAMERA);
+  const int max_entries = kernel_data.integrator.nested_stack_size - 1;
+
+  int found_object[MAX_VOLUME_STACK_SIZE];
+  float found_ior[MAX_VOLUME_STACK_SIZE];
+  int num_found = 0;
+  int entered[MAX_VOLUME_STACK_SIZE];
+  int num_entered = 0;
+  bool entered_overflow = false;
+  bool found_overflow = false;
+  bool reached_end = false;
+
+  for (int step = 0; step < NESTED_PROBE_MAX_STEPS; step++) {
+    Intersection isect ccl_optional_struct_init;
+    if (!scene_intersect(kg, &ray, visibility, &isect)) {
+      reached_end = true;
+      break;
+    }
+    if (nested_probe_hit_participates(kg, &isect)) {
+      shader_setup_from_ray(kg, stack_sd, &ray, &isect);
+      int e = -1;
+      for (int i = 0; i < num_entered; i++) {
+        if (entered[i] == isect.object) {
+          e = i;
+        }
+      }
+      if (!(stack_sd->runtime_flag & SR_BACKFACING)) {
+        if (e < 0) {
+          if (num_entered < MAX_VOLUME_STACK_SIZE) {
+            entered[num_entered++] = isect.object;
+          }
+          else {
+            entered_overflow = true;
+          }
+        }
+      }
+      else if (e >= 0) {
+        entered[e] = entered[--num_entered];
+      }
+      else if (!entered_overflow) {
+        bool add = true;
+        for (int i = 0; i < num_found && add; i++) {
+          add = (found_object[i] != isect.object);
+        }
+        if (add && num_found < max_entries) {
+          bool cache_miss = false;
+          found_object[num_found] = isect.object;
+          found_ior[num_found] = nested_probe_entry_ior(kg, state, stack_sd, cache_miss);
+          if (cache_miss) {
+            /* Nothing written yet: the kernel is re-executed once the texture is loaded. */
+            return false;
+          }
+          num_found++;
+        }
+        else if (add) {
+          found_overflow = true;
+        }
+      }
+    }
+    ray.tmin = intersection_t_offset(isect.t);
+    ray.self.object = isect.object;
+    ray.self.prim = isect.prim;
+  }
+
+  if (!reached_end || entered_overflow || found_overflow) {
+    /* Unresolved probe: hit budget exhausted, entered list overflow, or the camera is inside more
+     * media than the stack holds. Counted for the host-side warning. */
+    nested_report_unresolved(kg);
+  }
+
+  for (int i = 0; i < num_found; i++) {
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, object) = found_object[num_found - 1 - i];
+
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, ior) = found_ior[num_found - 1 - i];
+  }
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, num_found, object) = OBJECT_NONE;
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, num_found, ior) = 0.0f;
+  return true;
+}
+
+/* Subsurface scattering moved the path from from_P to to_P (the SSS object itself never
+ * participates). The participating boundaries on the straight segment in between are replayed on a
+ * local copy of the nested stack, crossing by crossing with the same push/pop rules as the path, and
+ * the copy is committed only after the whole segment was replayed. There is no cap on crossings
+ * besides the NESTED_PROBE_MAX_STEPS hit budget:
+ * - texture cache miss while evaluating a graph-driven IOR: nothing is committed, the caller retries;
+ * - hit budget exhausted (more than NESTED_PROBE_MAX_STEPS surfaces on the segment): the replay is
+ *   discarded and the path keeps the complete stack it had at the SSS entry point (documented). */
+struct NestedLocalStack {
+  int object[MAX_VOLUME_STACK_SIZE];
+  float ior[MAX_VOLUME_STACK_SIZE];
+  int num;
+};
+
+#  define NESTED_SSS_REPLAY_DONE 0
+#  define NESTED_SSS_REPLAY_CACHE_MISS 1
+#  define NESTED_SSS_REPLAY_BUDGET 2
+
+ccl_device_inline int nested_local_stack_size(KernelGlobals kg)
+{
+  return min(kernel_data.integrator.nested_stack_size, MAX_VOLUME_STACK_SIZE);
+}
+
+/* Same rule as nested_stack_push(): when full, the lowest-priority entry (ties: the newest) is
+ * dropped, unless the new object is not higher than it. num counts entries; the path stack keeps one
+ * slot for the OBJECT_NONE terminator, so at most size - 1 entries are stored. */
+ccl_device_inline void nested_local_stack_push(KernelGlobals kg,
+                                               ccl_private NestedLocalStack *s,
+                                               const int object,
+                                               const float ior)
+{
+  const int size = nested_local_stack_size(kg);
+  for (int i = 0; i < s->num; i++) {
+    if (s->object[i] == object) {
+      return;
+    }
+  }
+  if (s->num >= size - 1) {
+    int min_i = -1;
+    int min_priority = 0;
+    for (int i = 0; i < s->num; i++) {
+      const int p = nested_object_priority(kg, s->object[i]);
+      if (min_i < 0 || p <= min_priority) {
+        min_i = i;
+        min_priority = p;
+      }
+    }
+    if (min_i < 0 || nested_object_priority(kg, object) <= min_priority) {
+      return;
+    }
+    for (int j = min_i; j + 1 < s->num; j++) {
+      s->object[j] = s->object[j + 1];
+      s->ior[j] = s->ior[j + 1];
+    }
+    s->num--;
+  }
+  s->object[s->num] = object;
+  s->ior[s->num] = ior;
+  s->num++;
+}
+
+/* Same rule as nested_stack_pop(): removes the last occurrence; absent objects are ignored. */
+ccl_device_inline void nested_local_stack_pop(ccl_private NestedLocalStack *s, const int object)
+{
+  int found = -1;
+  for (int i = 0; i < s->num; i++) {
+    if (s->object[i] == object) {
+      found = i;
+    }
+  }
+  if (found < 0) {
+    return;
+  }
+  for (int j = found; j + 1 < s->num; j++) {
+    s->object[j] = s->object[j + 1];
+    s->ior[j] = s->ior[j + 1];
+  }
+  s->num--;
+}
+
+ccl_device int integrator_nested_stack_replay_for_subsurface(KernelGlobals kg,
+                                                             IntegratorState state,
+                                                             const float3 from_P,
+                                                             const float3 to_P,
+                                                             ccl_private NestedLocalStack *local)
+{
+  const int size = nested_local_stack_size(kg);
+  local->num = 0;
+  for (int i = 0; i < size; i++) {
+    const int object = INTEGRATOR_STATE_ARRAY(state, nested_stack, i, object);
+    if (object == OBJECT_NONE) {
+      break;
+    }
+    local->object[local->num] = object;
+    local->ior[local->num] = INTEGRATOR_STATE_ARRAY(state, nested_stack, i, ior);
+    local->num++;
+  }
+
+  ShaderDataTinyStorage stack_sd_storage;
+  ccl_private ShaderData *stack_sd = AS_SHADER_DATA(&stack_sd_storage);
+
+  Ray ray ccl_optional_struct_init;
+  ray.P = from_P;
+  ray.D = safe_normalize_len(to_P - from_P, &ray.tmax);
+  ray.tmin = 0.0f;
+  ray.time = INTEGRATOR_STATE(state, ray, time);
+#  ifdef __RAY_DIFFERENTIALS__
+  ray.dP = differential_zero_compact();
+  ray.dD = differential_zero_compact();
+#  endif
+  ray.self.object = INTEGRATOR_STATE(state, isect, object);
+  ray.self.prim = INTEGRATOR_STATE(state, isect, prim);
+  ray.self.light_object = OBJECT_NONE;
+  ray.self.light_prim = PRIM_NONE;
+
+  /* Transmission visibility, as for the path itself. Not PATH_RAY_VISIBILITY_ALL: that includes
+   * PATH_RAY_VISIBILITY_SHADOW_OPAQUE, which makes the GPU traversals (OptiX
+   * OPTIX_RAY_FLAG_TERMINATE_ON_FIRST_HIT, CUDA BVH2 early exit) return the first hit found instead
+   * of the closest one, so crossings were skipped on the GPU. */
+  const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
+  const uint visibility = SHADOW_CATCHER_PATH_VISIBILITY(path_flag, PATH_RAY_VISIBILITY_TRANSMIT);
+
+  for (int step = 0; step < NESTED_PROBE_MAX_STEPS; step++) {
+
+    Intersection isect ccl_optional_struct_init;
+    if (!scene_intersect(kg, &ray, visibility, &isect)) {
+      return NESTED_SSS_REPLAY_DONE;
+    }
+    if (nested_probe_hit_participates(kg, &isect)) {
+      shader_setup_from_ray(kg, stack_sd, &ray, &isect);
+      if (stack_sd->runtime_flag & SR_BACKFACING) {
+        nested_local_stack_pop(local, isect.object);
+      }
+      else {
+        bool cache_miss = false;
+        const float ior = nested_probe_entry_ior(kg, state, stack_sd, cache_miss);
+        if (cache_miss) {
+          return NESTED_SSS_REPLAY_CACHE_MISS;
+        }
+        nested_local_stack_push(kg, local, isect.object, ior);
+      }
+    }
+    ray.tmin = intersection_t_offset(isect.t);
+    ray.self.object = isect.object;
+    ray.self.prim = isect.prim;
+  }
+  return NESTED_SSS_REPLAY_BUDGET;
+}
+
+/* Commit a completed replay to the path's nested stack. */
+ccl_device void integrator_nested_stack_commit_for_subsurface(
+    KernelGlobals kg, IntegratorState state, const ccl_private NestedLocalStack *local)
+{
+  for (int i = 0; i < local->num; i++) {
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, object) = local->object[i];
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, ior) = local->ior[i];
+  }
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, local->num, object) = OBJECT_NONE;
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, local->num, ior) = 0.0f;
+}

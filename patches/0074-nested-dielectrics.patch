+/* Nested dielectrics: exact maximum number of axis-aligned boxes sharing a common point. Boxes have
+ * the Helly property, so a point of a k-clique lies at the largest min of the clique on every axis.
+ * The outer sweep runs along the axis with the least total pairwise overlap (so boxes separated
+ * along any one axis cost almost nothing); for each distinct outer min the active boxes' 2D maximum
+ * coverage comes from a sweep over the middle axis with a segment tree over the compressed inner axis
+ * (range add, global max): O(n^2 log n) worst case, with an early exit at `limit`. Returns -1 when
+ * `budget` operations are exceeded (the caller then assumes the conservative maximum). */
+namespace {
+struct NestedDepthBox {
+  float mn[3], mx[3];
+};
+struct NestedDepthTree {
+  vector<int> mx, lz;
+  int n = 0;
+  void init(const int n_)
+  {
+    n = n_;
+    mx.assign(4 * n, 0);
+    lz.assign(4 * n, 0);
+  }
+  void add(const int node, const int l, const int r, const int a, const int b, const int v)
+  {
+    if (b < l || r < a) {
+      return;
+    }
+    if (a <= l && r <= b) {
+      mx[node] += v;
+      lz[node] += v;
+      return;
+    }
+    const int m = (l + r) / 2;
+    add(2 * node, l, m, a, b, v);
+    add(2 * node + 1, m + 1, r, a, b, v);
+    mx[node] = lz[node] + max(mx[2 * node], mx[2 * node + 1]);
+  }
+  void add(const int a, const int b, const int v)
+  {
+    add(1, 0, n - 1, a, b, v);
+  }
+  int top() const
+  {
+    return mx[1];
+  }
+};
+}  // namespace
+
+static int nested_box_depth(const vector<NestedDepthBox> &boxes, const int limit, const double budget)
+{
+  const int n = int(boxes.size());
+  if (n <= 1) {
+    return n;
+  }
+  double overlap[3];
+  for (int axis = 0; axis < 3; axis++) {
+    vector<std::pair<float, int>> events;
+    events.reserve(2 * n);
+    for (const NestedDepthBox &b : boxes) {
+      events.push_back({b.mn[axis], -1});
+      events.push_back({b.mx[axis], +1});
+    }
+    std::sort(events.begin(), events.end());
+    double sum = 0.0;
+    int open = 0;
+    for (const auto &e : events) {
+      if (e.second < 0) {
+        sum += open;
+        open++;
+      }
+      else {
+        open--;
+      }
+    }
+    overlap[axis] = sum;
+  }
+  int order[3] = {0, 1, 2};
+  std::sort(order, order + 3, [&overlap](const int a, const int b) {
+    return overlap[a] < overlap[b];
+  });
+  const int A = order[0], B = order[1], C = order[2];
+
+  vector<float> zs;
+  zs.reserve(2 * n);
+  for (const NestedDepthBox &b : boxes) {
+    zs.push_back(b.mn[C]);
+    zs.push_back(b.mx[C]);
+  }
+  std::sort(zs.begin(), zs.end());
+  zs.erase(std::unique(zs.begin(), zs.end()), zs.end());
+  auto z_index = [&zs](const float v) {
+    return int(std::lower_bound(zs.begin(), zs.end(), v) - zs.begin());
+  };
+  NestedDepthTree tree;
+  tree.init(int(zs.size()));
+  const double log_z = std::log2(double(zs.size()) + 1.0);
+
+  vector<int> by_a(n);
+  for (int i = 0; i < n; i++) {
+    by_a[i] = i;
+  }
+  std::sort(by_a.begin(), by_a.end(), [&boxes, A](const int a, const int b) {
+    return boxes[a].mn[A] < boxes[b].mn[A];
+  });
+  vector<int> active;
+  vector<std::pair<float, int>> y_events; /* Starts (negative) before ends at equal y. */
+  double ops = 0.0;
+  int depth = 1;
+  size_t next = 0;
+  while (next < by_a.size() && depth < limit) {
+    const float x = boxes[by_a[next]].mn[A];
+    while (next < by_a.size() && boxes[by_a[next]].mn[A] <= x) {
+      active.push_back(by_a[next++]);
+    }
+    active.erase(std::remove_if(active.begin(),
+                                active.end(),
+                                [&boxes, A, x](const int b) { return boxes[b].mx[A] < x; }),
+                 active.end());
+    if (int(active.size()) <= depth) {
+      continue;
+    }
+    y_events.clear();
+    for (const int b : active) {
+      y_events.push_back({boxes[b].mn[B], -(b + 1)});
+      y_events.push_back({boxes[b].mx[B], b + 1});
+    }
+    std::sort(y_events.begin(),
+              y_events.end(),
+              [](const std::pair<float, int> &p, const std::pair<float, int> &q) {
+                return p.first < q.first || (p.first == q.first && p.second < 0 && q.second > 0);
+              });
+    ops += double(y_events.size()) * (2.0 + log_z);
+    if (ops > budget) {
+      return -1;
+    }
+    for (const auto &e : y_events) {
+      const int b = (e.second < 0 ? -e.second : e.second) - 1;
+      const int z0 = z_index(boxes[b].mn[C]);
+      const int z1 = z_index(boxes[b].mx[C]);
+      if (e.second < 0) {
+        tree.add(z0, z1, +1);
+        depth = max(depth, tree.top());
+      }
+      else {
+        tree.add(z0, z1, -1);
+      }
+    }
+  }
+  return min(depth, limit);
+}
+
+/* Nested dielectrics: unresolved media probes. Both run on the session thread, which owns the device
+ * memory: reset when the render buffers are reset, polled after each render pass. */
+void Scene::nested_probe_reset()
+{
+  nested_probe_unresolved_ = 0;
+  nested_probe_warned_ = false;
+  nested_probe_final_logged_ = false;
+  if (dscene.nested_probe_unresolved.size() != 0) {
+    dscene.nested_probe_unresolved.data()[0] = 0;
+    dscene.nested_probe_unresolved.copy_to_device();
+  }
+}
+
+void Scene::nested_probe_poll(const bool render_finished)
+{
+  if (dscene.nested_probe_unresolved.size() == 0) {
+    return;
+  }
+  if (!render_finished) {
+    nested_probe_unresolved_ = device->mem_read_uint32_counter(dscene.nested_probe_unresolved);
+  }
+  const uint64_t count = nested_probe_unresolved_.load();
+  if (count == 0) {
+    return;
+  }
+  if (!nested_probe_warned_) {
+    nested_probe_warned_ = true;
+    LOG_WARNING << "Nested dielectrics: " << count
+                << " media probes ended unresolved (camera probe hit budget or list overflow, or "
+                   "SSS replay hit budget); the media of those paths may be wrong.";
+  }
+  if (render_finished && !nested_probe_final_logged_) {
+    nested_probe_final_logged_ = true;
+    LOG_WARNING << "Nested dielectrics: " << count << " unresolved media probes in this render.";
+  }
+}
+
+int Scene::get_nested_stack_size() const
+{
+  if (!integrator->get_nested_dielectrics()) {
+    nested_stack_depth = 0;
+    nested_stack_depth_clamped = false;
+    nested_stack_size_cache_valid = false;
+    return 1;
+  }
+
+  /* Participating bounding boxes, and a cache key over them: camera-only or shader-only updates
+   * that leave participation and bounds unchanged reuse the previous result. */
+  vector<NestedDepthBox> boxes;
+  uint64_t key = 1469598103934665603ull;
+  auto mix = [&key](const uint32_t v) { key = (key ^ v) * 1099511628211ull; };
+  for (const Object *object : objects) {
+    if (object->is_nested_dielectric(this) && object->bounds.valid()) {
+      boxes.push_back({{object->bounds.min.x, object->bounds.min.y, object->bounds.min.z},
+                       {object->bounds.max.x, object->bounds.max.y, object->bounds.max.z}});
+      const float v[6] = {object->bounds.min.x,
+                          object->bounds.min.y,
+                          object->bounds.min.z,
+                          object->bounds.max.x,
+                          object->bounds.max.y,
+                          object->bounds.max.z};
+      for (const float f : v) {
+        uint32_t u;
+        memcpy(&u, &f, sizeof(u));
+        mix(u);
+      }
+    }
+  }
+  mix(uint32_t(boxes.size()));
+  if (nested_stack_size_cache_valid && nested_stack_size_cache_key == key) {
+    return nested_stack_size_cache_value;
+  }
+
+  const double t0 = time_dt();
+  /* Exact depth, scanned one past what a path can track so overflow can be reported; a budget of
+   * about 1e8 operations bounds pathological layouts (conservative maximum, with the warning). */
+  bool clamped = false;
+  int depth = nested_box_depth(boxes, MAX_VOLUME_STACK_SIZE, 1e8);
+  if (depth < 0) {
+    depth = MAX_VOLUME_STACK_SIZE - 1;
+    clamped = true;
+  }
+
+  /* One slot for the terminator, at least two in total. */
+  const int size = boxes.empty() ? 1 : clamp(depth + 1, 2, MAX_VOLUME_STACK_SIZE);
+  nested_stack_depth = depth;
+  nested_stack_depth_clamped = clamped || depth + 1 > MAX_VOLUME_STACK_SIZE;
+  if (nested_stack_depth_clamped) {
+    LOG_WARNING << "Nested dielectrics: participating objects overlap deeper than the "
+                << MAX_VOLUME_STACK_SIZE - 1
+                << " media a path can track"
+                << (clamped ? " (or the bound exceeded its operation budget)" : "")
+                << ". Paths inside more media drop the lowest-priority one.";
+  }

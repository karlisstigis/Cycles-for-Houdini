diff --git a/src/kernel/integrator/nested_dielectric.h b/src/kernel/integrator/nested_dielectric.h
new file mode 100644
index 0000000000000000000000000000000000000000..8f3fba5fc58f42435dd0ba9ed383d0897015eebb
--- /dev/null
+++ b/src/kernel/integrator/nested_dielectric.h
@@ -0,0 +1,394 @@
+/* SPDX-FileCopyrightText: 2026 Cycles for Houdini contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* Nested dielectrics (priority-based nested media, Schmidt and Budge 2002), Cycles Houdini
+ * patch 0074.
+ *
+ * Every path carries the participating objects it is inside, in order of entry, with the IOR read
+ * at entry (shadow paths: objects only). A participating hit on object X is "masked" (a buried
+ * boundary the ray passes straight through) when another entry has a higher priority. Otherwise
+ * the closures use the relative IOR against the "opposite" medium: the highest entry below X
+ * (ties: entered first), or air. See artifacts/feature-nested/DESIGN.md.
+ *
+ * Nothing here runs unless kernel_data.integrator.nested_dielectrics is set: the object flag
+ * SD_OBJECT_NESTED_DIELECTRIC and shader flag SD_NESTED_REFRACTIVE are only set by the host when
+ * the feature is on, and every entry point checks them or the integrator flag first. */
+
+#pragma once
+
+#include "util/atomic.h"
+
+CCL_NAMESPACE_BEGIN
+
+
+#ifdef __VOLUME__
+
+/* Tie modes (KernelIntegrator.nested_tie_mode). */
+#  define NESTED_TIE_INDEPENDENT 0
+#  define NESTED_TIE_FIRST_ENTERED 1
+
+ccl_device_forceinline bool nested_flags_participate(const uint object_flag, const int shader_flag)
+{
+  return (object_flag & SD_OBJECT_NESTED_DIELECTRIC) && (shader_flag & SD_NESTED_REFRACTIVE);
+}
+
+ccl_device_forceinline bool nested_sd_participates(const ccl_private ShaderData *sd)
+{
+  return nested_flags_participate(sd->object_flag, sd->shader_flag);
+}
+
+ccl_device_forceinline int nested_object_priority(KernelGlobals kg, const int object)
+{
+  return kernel_data_fetch(objects, object).dielectric_priority;
+}
+
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device_forceinline int nested_stack_read_object(const IntegratorGenericState state,
+                                                    const int i)
+{
+  if constexpr (shadow) {
+    return INTEGRATOR_STATE_ARRAY(state, shadow_nested_stack, i, object);
+  }
+  else {
+    return INTEGRATOR_STATE_ARRAY(state, nested_stack, i, object);
+  }
+}
+
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device_forceinline void nested_stack_write(IntegratorGenericState state,
+                                               const int i,
+                                               const int object,
+                                               const float ior)
+{
+  if constexpr (shadow) {
+    INTEGRATOR_STATE_ARRAY_WRITE(state, shadow_nested_stack, i, object) = object;
+    (void)ior;
+  }
+  else {
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, object) = object;
+    INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, i, ior) = ior;
+  }
+}
+
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device_forceinline float nested_stack_read_ior(const IntegratorGenericState state,
+                                                   const int i)
+{
+  if constexpr (shadow) {
+    return 1.0f;
+  }
+  else {
+    return INTEGRATOR_STATE_ARRAY(state, nested_stack, i, ior);
+  }
+}
+
+/* Remove entry i, keeping the order of the others. `num` is the number of entries. */
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device_inline void nested_stack_remove(IntegratorGenericState state, const int i, const int num)
+{
+  for (int j = i; j + 1 < num; j++) {
+    nested_stack_write<shadow>(state,
+                               j,
+                               nested_stack_read_object<shadow>(state, j + 1),
+                               nested_stack_read_ior<shadow>(state, j + 1));
+  }
+  nested_stack_write<shadow>(state, num - 1, OBJECT_NONE, 0.0f);
+}
+
+/* Classify a hit on `object` (priority `priority`) against the stack.
+ * Returns true when the boundary is buried (masked). Otherwise writes the IOR of the medium on the
+ * other side of the boundary to *opposite_ior (1.0 = air). The object itself is ignored if it is in
+ * the stack; an object not in the stack counts as the newest entry. */
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device bool nested_classify(KernelGlobals kg,
+                                const IntegratorGenericState state,
+                                const int object,
+                                const int priority,
+                                ccl_private float *opposite_ior)
+{
+  const int tie_mode = kernel_data.integrator.nested_tie_mode;
+  const int size = kernel_data.integrator.nested_stack_size;
+
+  bool before_self = true;
+  bool found = false;
+  int best_priority = 0;
+  float best_ior = 1.0f;
+
+  for (int i = 0; i < size; i++) {
+    const int entry = nested_stack_read_object<shadow>(state, i);
+    if (entry == OBJECT_NONE) {
+      break;
+    }
+    if (entry == object) {
+      before_self = false;
+      continue;
+    }
+    const int p = nested_object_priority(kg, entry);
+    if (p > priority) {
+      return true;
+    }
+    if (p == priority) {
+      if (tie_mode == NESTED_TIE_FIRST_ENTERED) {
+        if (before_self) {
+          return true;
+        }
+      }
+      else {
+        /* Independent ties: equal priorities do not see each other. */
+        continue;
+      }
+    }
+    /* Candidate for the opposite medium; strict > keeps the first entered on ties. */
+    if (!found || p > best_priority) {
+      found = true;
+      best_priority = p;
+      best_ior = nested_stack_read_ior<shadow>(state, i);
+    }
+  }
+
+  if (opposite_ior) {
+    *opposite_ior = best_ior;
+  }
+  return false;
+}
+
+/* Same rule as nested_classify() on a local list (MNEE seed walk). Returns true when the crossing
+ * of `object` is a nested interaction: buried, or not against air (opposite IOR != 1). */
+ccl_device bool nested_list_is_nested_crossing(KernelGlobals kg,
+                                               const ccl_private int *objects,
+                                               const ccl_private float *iors,
+                                               const int num,
+                                               const int object)
+{
+  const int tie_mode = kernel_data.integrator.nested_tie_mode;
+  const int priority = nested_object_priority(kg, object);
+  bool before_self = true;
+  bool found = false;
+  int best_priority = 0;
+  float best_ior = 1.0f;
+  for (int i = 0; i < num; i++) {
+    if (objects[i] == object) {
+      before_self = false;
+      continue;
+    }
+    const int p = nested_object_priority(kg, objects[i]);
+    if (p > priority) {
+      return true;
+    }
+    if (p == priority) {
+      if (tie_mode == NESTED_TIE_FIRST_ENTERED) {
+        if (before_self) {
+          return true;
+        }
+      }
+      else {
+        continue;
+      }
+    }
+    if (!found || p > best_priority) {
+      found = true;
+      best_priority = p;
+      best_ior = iors[i];
+    }
+  }
+  return best_ior != 1.0f;
+}
+
+/* Main path: decide masking and the opposite IOR for a surface hit, before shader evaluation. */
+
+ccl_device_forceinline void nested_surface_prepare(KernelGlobals kg,
+                                                   ConstIntegratorState state,
+                                                   ccl_private ShaderData *sd)
+{
+  if (!nested_sd_participates(sd)) {
+    return;
+  }
+  float opposite_ior = 1.0f;
+  const bool masked = nested_classify<false>(
+      kg, state, sd->object, nested_object_priority(kg, sd->object), &opposite_ior);
+  sd->runtime_flag |= SR_NESTED_ACTIVE | (masked ? SR_NESTED_MASKED : 0);
+  sd->nested_opposite_ior = fmaxf(opposite_ior, 1e-5f);
+  sd->nested_ior_sum = 0.0f;
+  sd->nested_ior_weight = 0.0f;
+}
+
+/* Intersect kernel: is the closest hit a masked boundary? Used to skip Russian roulette. */
+ccl_device_forceinline bool nested_isect_is_masked(KernelGlobals kg,
+                                                   ConstIntegratorState state,
+                                                   const ccl_private Intersection *ccl_restrict
+                                                       isect,
+                                                   const int shader_flags)
+{
+  if (!kernel_data.integrator.nested_dielectrics || !(shader_flags & SD_NESTED_REFRACTIVE) ||
+      isect->object == OBJECT_NONE)
+  {
+    return false;
+  }
+  if (!(kernel_data_fetch(object_flag, isect->object) & SD_OBJECT_NESTED_DIELECTRIC)) {
+    return false;
+  }
+  return nested_classify<false>(
+      kg, state, isect->object, nested_object_priority(kg, isect->object), nullptr);
+}
+
+/* IOR of the entered medium: evaluated value if the shader recorded one, else the shader's
+ * constant (or its fallback when the IOR is varying), else 1. */
+ccl_device_forceinline float nested_entry_ior(KernelGlobals kg, const ccl_private ShaderData *sd)
+{
+  if ((sd->runtime_flag & SR_NESTED_ACTIVE) && sd->nested_ior_weight > 0.0f) {
+    return sd->nested_ior_sum / sd->nested_ior_weight;
+  }
+  const float c = fabsf(kernel_data_fetch(shaders, (sd->shader & SHADER_MASK)).nested_ior);
+  return (c > 0.0f) ? c : 1.0f;
+}
+
+/* Does a masked hit need shader evaluation to know the IOR of the entered medium? */
+ccl_device_forceinline bool nested_masked_needs_eval(KernelGlobals kg,
+                                                     const ccl_private ShaderData *sd)
+{
+  return !(sd->runtime_flag & SR_BACKFACING) &&
+         !(kernel_data_fetch(shaders, (sd->shader & SHADER_MASK)).nested_ior > 0.0f);
+}
+
+/* Add an object to the stack (if not present). When full, the lowest-priority entry (ties: the
+ * newest) is dropped, unless the new object is not higher than it. */
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device void nested_stack_push(KernelGlobals kg,
+                                  IntegratorGenericState state,
+                                  const int object,
+                                  const float ior)
+{
+  const int size = kernel_data.integrator.nested_stack_size;
+  int num = 0;
+  for (; num < size; num++) {
+    const int entry = nested_stack_read_object<shadow>(state, num);
+    if (entry == OBJECT_NONE) {
+      break;
+    }
+    if (entry == object) {
+      return;
+    }
+  }
+
+  if (num >= size - 1) {
+    int min_i = -1;
+    int min_priority = 0;
+    for (int i = 0; i < num; i++) {
+      const int p = nested_object_priority(kg, nested_stack_read_object<shadow>(state, i));
+      if (min_i < 0 || p <= min_priority) {
+        min_i = i;
+        min_priority = p;
+      }
+    }
+    if (min_i < 0 || nested_object_priority(kg, object) <= min_priority) {
+      return;
+    }
+    nested_stack_remove<shadow>(state, min_i, num);
+    num--;
+  }
+
+  nested_stack_write<shadow>(state, num, object, ior);
+  nested_stack_write<shadow>(state, num + 1, OBJECT_NONE, 0.0f);
+}
+
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device void nested_stack_pop(KernelGlobals kg, IntegratorGenericState state, const int object)
+{
+  const int size = kernel_data.integrator.nested_stack_size;
+  int found = -1;
+  int num = 0;
+  for (; num < size; num++) {
+    const int entry = nested_stack_read_object<shadow>(state, num);
+    if (entry == OBJECT_NONE) {
+      break;
+    }
+    if (entry == object) {
+      found = num;
+    }
+  }
+  if (found >= 0) {
+    nested_stack_remove<shadow>(state, found, num);
+  }
+}
+
+/* Update the stack for a transmission through a participating surface (real or masked). */
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device void nested_stack_enter_exit(KernelGlobals kg,
+                                        IntegratorGenericState state,
+                                        const ccl_private ShaderData *sd)
+{
+  if (!nested_sd_participates(sd)) {
+    return;
+  }
+  if (sd->runtime_flag & SR_BACKFACING) {
+    nested_stack_pop<shadow>(kg, state, sd->object);
+  }
+  else {
+    nested_stack_push<shadow>(kg, state, sd->object, shadow ? 0.0f : nested_entry_ior(kg, sd));
+  }
+}
+
+/* Volume of a participating object only contributes where that object is not buried. */
+template<const bool shadow, typename IntegratorGenericState>
+ccl_device_forceinline bool nested_volume_entry_suppressed(KernelGlobals kg,
+                                                           const IntegratorGenericState state,
+                                                           const int object,
+                                                           const int shader)
+{
+  if (!kernel_data.integrator.nested_dielectrics || object == OBJECT_NONE) {
+    return false;
+  }
+  if (!nested_flags_participate(kernel_data_fetch(object_flag, object),
+                                kernel_data_fetch(shaders, (shader & SHADER_MASK)).flags))
+  {
+    return false;
+  }
+  return nested_classify<shadow>(kg, state, object, nested_object_priority(kg, object), nullptr);
+}
+
+/* Shadow paths start with a copy of the main stack (objects only). */
+ccl_device_forceinline void nested_stack_copy_to_shadow(KernelGlobals kg,
+                                                        IntegratorShadowState shadow_state,
+                                                        ConstIntegratorState state)
+{
+  if (!kernel_data.integrator.nested_dielectrics) {
+    return;
+  }
+  const int size = kernel_data.integrator.nested_stack_size;
+  for (int i = 0; i < size; i++) {
+    const int object = INTEGRATOR_STATE_ARRAY(state, nested_stack, i, object);
+    INTEGRATOR_STATE_ARRAY_WRITE(shadow_state, shadow_nested_stack, i, object) = object;
+    if (object == OBJECT_NONE) {
+      break;
+    }
+  }
+}
+
+/* A media probe (camera +Z probe, SSS replay) ended unresolved: count it for the host-side warning
+ * (Scene::nested_probe_unresolved_count). The counter only exists while the toggle is on. */
+ccl_device_inline void nested_report_unresolved(KernelGlobals kg)
+{
+  atomic_fetch_and_add_uint32(&kernel_data_array(nested_probe_unresolved)[0], 1);
+}
+
+ccl_device_forceinline void nested_stack_init(KernelGlobals kg, IntegratorState state)
+
+{
+  if (!kernel_data.integrator.nested_dielectrics) {
+    return;
+  }
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, 0, object) = OBJECT_NONE;
+  INTEGRATOR_STATE_ARRAY_WRITE(state, nested_stack, 0, ior) = 0.0f;
+  INTEGRATOR_STATE_WRITE(state, path, nested_masked) = 0;
+}
+
+ccl_device_forceinline bool nested_stack_is_empty(KernelGlobals kg, ConstIntegratorState state)
+{
+  return !kernel_data.integrator.nested_dielectrics ||
+         INTEGRATOR_STATE_ARRAY(state, nested_stack, 0, object) == OBJECT_NONE;
+}
+
+#endif /* __VOLUME__ */
+
+CCL_NAMESPACE_END

     mem.device_pointer = key;
   }
 
+  uint64_t mem_read_uint32_counter(device_memory &mem) override
+  {
+    const device_ptr key = mem.device_pointer;
+    uint64_t total = 0;
+    try {
+      /* Peer devices share an allocation: read its owner exactly once. */
+      for (const vector<SubDevice *> &island : peer_islands) {
+        SubDevice *owner = find_matching_mem_device(key, *island.front());
+        mem.device = owner->device.get();
+        mem.device_pointer = ptr_map_find(*owner, key);
+        total += owner->device->mem_read_uint32_counter(mem);
+      }
+    }
+    catch (...) {
+      mem.device = this;
+      mem.device_pointer = key;
+      throw;
+    }
+    mem.device = this;
+    mem.device_pointer = key;
+    return total;
+  }

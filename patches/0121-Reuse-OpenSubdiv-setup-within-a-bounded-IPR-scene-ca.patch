+SubdivisionOsdCacheStats SubdivisionOsdCache::stats() const
 {
+  const std::lock_guard lock(impl->mutex);
+  auto result = impl->stats;
+  result.entries = impl->lru.size();
+  result.active_retired_bytes =
+      impl->charged->load(std::memory_order_relaxed) - result.retained_bytes;

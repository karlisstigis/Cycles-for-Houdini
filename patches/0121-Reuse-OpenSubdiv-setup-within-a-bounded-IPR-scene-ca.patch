+}  // namespace
+
+struct SubdivisionOsdCache::Impl {
+  struct Record {
+    size_t key;
+    std::shared_ptr<const OsdCacheEntry> entry;
+  };
+  using RecencyList = std::list<Record>;
+
+  mutable std::mutex mutex;
+  SubdivisionOsdCacheStats stats;
+  size_t last_key = 0;
+  RecencyList lru;
+  std::optional<std::unordered_map<size_t, RecencyList::iterator>> by_mesh;
+  std::shared_ptr<std::atomic<size_t>> charged = std::make_shared<std::atomic<size_t>>(0);
+
+  RecencyList::iterator lookup(const size_t key)
+  {
+    if (by_mesh) {
+      const auto record = by_mesh->find(key);
+      if (record != by_mesh->end()) {
+        return record->second;
+      }
+    }
+    return lru.end();
+  }
+
+  std::shared_ptr<const OsdCacheEntry> remove(RecencyList::iterator record)
+  {
+    auto entry = std::move(record->entry);
+    stats.retained_bytes -= entry->charge.bytes;
+    by_mesh->erase(record->key);
+    if (by_mesh->empty()) {
+      by_mesh.reset();
+    }
+    lru.erase(record);
+    return entry;
+  }
+};
+
+SubdivisionOsdCache::SubdivisionOsdCache() : impl(std::make_unique<Impl>()) {}
+SubdivisionOsdCache::~SubdivisionOsdCache() = default;
+
+void SubdivisionOsdCache::set_budget(const size_t bytes)
+{
+  const std::lock_guard lock(impl->mutex);
+  auto &stats = impl->stats;
+  stats.budget_bytes = bytes;
+  while (stats.retained_bytes > bytes) {
+    impl->remove(std::prev(impl->lru.end()));
+    ++stats.evictions;
+  }
+}
 

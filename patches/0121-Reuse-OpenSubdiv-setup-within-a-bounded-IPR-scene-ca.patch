-/* OsdData */
+/* Retained entries own only immutable setup data. A dicing pass pins an entry until its last
+ * patch or borrowed face-varying value has been consumed. */
+struct OsdCacheEntry {
+  struct Charge {
+    std::shared_ptr<std::atomic<size_t>> total;
+    size_t bytes = 0;
+    ~Charge()
+    {
+      if (total) {
+        total->fetch_sub(bytes, std::memory_order_relaxed);
+      }
+    }
+  } charge;  /* Release the charge after the payload is destroyed. */
+
+  OsdTopology topology;
+  vector<char> key;
+  vector<vector<char>> merged_values;

+/* Compare only inputs consumed by the cached setup. Position and all other interpolated
+ * primvars are computed from the current mesh on every pass. */
+template<typename Visit> bool visit_osd_key(const OsdMesh &osd_mesh, Visit visit)
+{
+  const Mesh &mesh = osd_mesh.mesh;
+  const auto scalar = [&](const auto value) { return visit(&value, sizeof(value)); };
+  const auto array = [&](const auto &values) {
+    return scalar(values.size()) && visit(values.data(), values.size() * sizeof(*values.data()));
+  };
+
+  if (!scalar(mesh.get_num_subd_base_verts()) || !scalar(mesh.get_num_subd_faces()) ||
+      !scalar(mesh.get_subdivision_boundary_interpolation()) ||
+      !scalar(mesh.get_subdivision_fvar_interpolation()) ||
+      !array(mesh.get_subd_num_corners()) || !array(mesh.get_subd_start_corner()) ||
+      !array(mesh.get_subd_face_corners()) || !array(mesh.get_subd_creases_edge()) ||
+      !array(mesh.get_subd_creases_weight()) || !array(mesh.get_subd_vert_creases()) ||
+      !array(mesh.get_subd_vert_creases_weight()))
+  {
+    return false;
+  }
+
+  const size_t corners = mesh.get_subd_face_corners().size();
+  for (const Attribute &attr : mesh.subd_attributes.attributes) {
+    if (!osd_mesh.use_smooth_fvar(attr)) {
+      continue;
+    }
+    const size_t name_size = attr.name.size();
+    if (size_t(attr.size) != corners || !scalar(name_size) ||
+        !visit(attr.name.c_str(), name_size) || !scalar(attr.std) || !scalar(attr.element) ||
+        !scalar(attr.flags) || !scalar(attr.type.basetype) || !scalar(attr.type.aggregate) ||
+        !scalar(attr.type.vecsemantics) || !scalar(attr.type.arraylen) ||
+        !scalar(attr.num_motion_steps()))
+    {
+      return false;
+    }
+    const size_t step_size = corners * attr.data_sizeof();
+    for (int step = 0; step < attr.num_motion_steps(); ++step) {
+      if ((step_size && !attr.data(step)) || !visit(attr.data(step), step_size)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool key_matches(const OsdCacheEntry &entry, const OsdMesh &osd_mesh)
+{
+  size_t offset = 0;
+  return visit_osd_key(osd_mesh, [&](const void *data, size_t size) {
+    if (size > entry.key.size() - offset ||
+        (size && std::memcmp(data, entry.key.data() + offset, size) != 0))
+    {
+      return false;
+    }
+    offset += size;
+    return true;
+  }) && offset == entry.key.size();
+}
+
+size_t key_size(const OsdMesh &osd_mesh, const size_t budget)
+{
+  size_t bytes = 0;
+  const bool fits = visit_osd_key(osd_mesh, [&](const void *, size_t size) {
+    if (size > budget - bytes) {
+      return false;
+    }
+    bytes += size;
+    return true;
+  });
+  return fits ? bytes : 0;
+}
+
+void restore_fvar_values(const OsdCacheEntry &entry, OsdMesh &osd_mesh)
+{
+  int channel = 0;
+  osd_mesh.merged_fvars.reserve(entry.merged_values.size());
+  for (const Attribute &attr : osd_mesh.mesh.subd_attributes.attributes) {
+    if (!osd_mesh.use_smooth_fvar(attr)) {
+      continue;
+    }
+    for (int step = 0; step < attr.num_motion_steps(); ++step, ++channel) {
+      osd_mesh.merged_fvars.push_back({attr, step, channel, {}, &entry.merged_values[channel]});
+    }
+  }
+  assert(size_t(channel) == entry.merged_values.size());
+}
+
+/* Use exposed capacities and component counts for OpenSubdiv's private buffers, with headroom
+ * for allocator rounding and structures without a capacity API. This is an accounting charge,
+ * independent of process working set and uncached, pass-local tessellation memory. */
+size_t estimate_entry_bytes(const OsdMesh &mesh,
+                            const OsdTopology &topology,
+                            const size_t key_bytes,
+                            const size_t budget)
+{
+  const size_t limit = (budget / 5) * 4;
+  size_t bytes = 0;
+  const auto add = [&](const size_t count, const size_t stride) {
+    if (count > (limit - bytes) / stride) {
+      return false;
+    }
+    bytes += count * stride;
+    return true;
+  };
+  const auto stencil = [&](const Far::StencilTable *table) {
+    return !table || (add(1, sizeof(*table)) && add(table->GetSizes().capacity(), sizeof(int)) &&
+                       add(table->GetOffsets().capacity(), sizeof(Far::Index)) &&
+                       add(table->GetControlIndices().capacity(), sizeof(Far::Index)) &&
+                       add(table->GetWeights().capacity(), sizeof(float)));
+  };
+
+  const auto &refiner = *topology.refiner;
+  const auto &table = *topology.patch_table;
+  if (!add(1, sizeof(OsdCacheEntry) + sizeof(refiner) + sizeof(table) + sizeof(Far::PatchMap) +
+                   1024) ||
+      !add(key_bytes, 1) || !add(refiner.GetNumVerticesTotal(), 64) ||
+      !add(refiner.GetNumEdgesTotal(), 64) || !add(refiner.GetNumFacesTotal(), 64) ||
+      !add(refiner.GetNumFaceVerticesTotal(), 32) || !add(table.GetNumPatchesTotal(), 64) ||
+      !add(table.GetNumPtexFaces(), 16) ||
+      !add(table.GetNumControlVerticesTotal(), sizeof(Far::Index)) ||
+      !stencil(table.GetLocalPointStencilTable()) ||
+      !stencil(table.GetLocalPointVaryingStencilTable()))
+  {
+    return 0;
+  }
+  for (const auto &channel : mesh.merged_fvars) {
+    if (!add(1, sizeof(channel.values)) || !add(channel.values.capacity(), 1) ||
+        !add(refiner.GetNumFVarValuesTotal(channel.channel), 64) ||
+        !add(table.GetFVarValues(channel.channel).size(), sizeof(Far::Index)) ||
+        !add(table.GetFVarPatchParams(channel.channel).size(), sizeof(Far::PatchParam)) ||
+        !stencil(table.GetLocalPointFaceVaryingStencilTable(channel.channel)))
+    {
+      return 0;
+    }
+  }
+
+  return bytes + (bytes + 3) / 4; /* 25% headroom. */
+}

+
+void SubdivisionOsdCache::erase(const size_t key)
+{
+  std::shared_ptr<const OsdCacheEntry> retired;
+  {
+    const std::lock_guard lock(impl->mutex);
+    const auto record = impl->lookup(key);
+    if (record != impl->lru.end()) {
+      retired = impl->remove(record);
+    }
+  }
+  /* Destroy a removed mesh's entry after releasing the cache lock. */
+}
+
+std::shared_ptr<const OsdCacheEntry> SubdivisionOsdCache::find(const OsdMesh &osd_mesh,
+                                                             size_t &admission_budget)
+{
+  auto &mesh = osd_mesh.mesh;
+  std::shared_ptr<const OsdCacheEntry> entry;
+  {
+    const std::lock_guard lock(impl->mutex);
+    if (impl->stats.budget_bytes == 0) {
+      return {};
+    }
+
+    if (mesh.subdivision_osd_cache_owner.lock().get() != this) {
+      mesh.subdivision_osd_cache_owner = weak_from_this();
+      mesh.subdivision_osd_cache_key = ++impl->last_key;
+      ++impl->stats.misses;
+      /* A mesh diced once has no retained entry. */
+      return {};
+    }
+
+    admission_budget = impl->stats.budget_bytes;
+    const auto record = impl->lookup(mesh.subdivision_osd_cache_key);
+    if (record == impl->lru.end()) {
+      ++impl->stats.misses;
+      return {};
+    }
+    entry = record->entry;
+  }
+
+  /* Only compare the entry for this mesh, without blocking another mesh's lookup. */
+  const bool matched = key_matches(*entry, osd_mesh);
+  const std::lock_guard lock(impl->mutex);
+  const auto record = impl->lookup(mesh.subdivision_osd_cache_key);
+  const bool still_retained = record != impl->lru.end() && record->entry == entry;
+  if (matched) {
+    if (still_retained) {
+      impl->lru.splice(impl->lru.begin(), impl->lru, record);
+    }
+    ++impl->stats.hits;
+    return entry;
+  }
+
+  if (still_retained) {
+    impl->remove(record);
+  }
+  ++impl->stats.misses;
+  return {};
+}
+
+void SubdivisionOsdCache::admit(const OsdMesh &osd_mesh, std::shared_ptr<OsdCacheEntry> entry)
+{
+  const std::lock_guard lock(impl->mutex);
+  auto &stats = impl->stats;
+  const size_t bytes = entry->charge.bytes;
+  if (stats.budget_bytes == 0 || bytes > stats.budget_bytes) {
+    return;
+  }
+  const size_t key = osd_mesh.mesh.subdivision_osd_cache_key;
+  if (impl->lookup(key) != impl->lru.end()) {
+    return;
+  }
+
+  /* Only idle LRU victims can make room for an admission. Active or recently retired
+   * entries consume their charge until the last reader releases them. */
+  const size_t available = stats.budget_bytes - bytes;
+  auto next_victim = impl->lru.end();
+  while (impl->charged->load(std::memory_order_relaxed) > available &&
+         next_victim != impl->lru.begin())
+  {
+    auto victim = std::prev(next_victim);
+    if (victim->entry.use_count() != 1) {
+      next_victim = victim;
+      continue;
+    }
+    /* Release idle entries here so the admission uses the resulting charge. */
+    impl->remove(victim);
+    ++stats.evictions;
+  }
+  if (impl->charged->load(std::memory_order_relaxed) > available) {
+    return;
+  }
+
+  impl->lru.push_front({key, entry});
+  try {
+    if (!impl->by_mesh) {
+      impl->by_mesh.emplace();
+    }
+    impl->by_mesh->emplace(key, impl->lru.begin());
+  }
+  catch (...) {
+    impl->lru.pop_front();
+    if (impl->by_mesh && impl->by_mesh->empty()) {
+      impl->by_mesh.reset();
+    }
+    throw;
+  }
+  entry->charge.total = impl->charged;
+  impl->charged->fetch_add(bytes, std::memory_order_relaxed);
+  stats.retained_bytes += bytes;
+  ++stats.admissions;
+}
+
+void SubdivisionOsdCache::record_oversized()
+{
+  const std::lock_guard lock(impl->mutex);
+  if (impl->stats.budget_bytes) {
+    ++impl->stats.oversized;
+  }
+}

Rationale: Automatic world-map resolution must handle multiple detected suns rather than a single-sun assumption; this affects generic background importance sampling.
Contract: world auto map resolution
Tests: tests/houdini_world_sampling_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/scene/light.cpp b/src/scene/light.cpp
index 8ebfb7afeddd9a9998c159aef058795823651415..98e4fbc3bb6baf793a307b1a960d3b305dc0b015 100644
--- a/src/scene/light.cpp
+++ b/src/scene/light.cpp
@@ -1293,8 +1293,10 @@ void LightManager::device_update_background(Device *device,
   kbackground->use_sun_guiding = (num_suns == 1);
   if (!kbackground->use_sun_guiding) {
     kbackground->sun_weight = 0.0f;
-    environment_res.x = max(environment_res.x, 4096);
-    environment_res.y = max(environment_res.y, 2048);
+    if (num_suns > 1) {
+      environment_res.x = max(environment_res.x, 4096);
+      environment_res.y = max(environment_res.y, 2048);
+    }
   }
 
   /* Enable MIS for background sampling if any strategy is active. */

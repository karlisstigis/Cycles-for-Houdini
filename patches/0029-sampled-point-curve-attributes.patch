   return kernel_data_fetch(attributes_quaternion, offset);
 }
 
+/* Generic field storage keeps the centre first and the remaining samples in
+ * chronological order. Dedicated position/radius/normal readers are unchanged. */
+template<typename T>
+ccl_device T attribute_data_fetch_motion(KernelGlobals kg,
+                                         ccl_private const ShaderData *sd,
+                                         const AttributeDescriptor desc,
+                                         const int index,
+                                         const int stride)
+{
+  if ((desc.element & ATTR_ELEMENT_IS_MOTION) && sd->time >= 0.0f) {
+    const int steps = kernel_data_fetch(objects, sd->object).num_geom_steps;
+    if (steps > 1) {
+      const float time = saturatef(sd->time) * (steps - 1);
+      const int step = min(int(time), steps - 2);
+      const float factor = time - step;
+      const int centre = (steps - 1) / 2;
+      const int first = step == centre ? 0 : step < centre ? step + 1 : step;
+      const int next = step + 1;
+      const int second = next == centre ? 0 : next < centre ? next + 1 : next;
+      const T a = attribute_data_fetch<T>(kg, desc.element, desc.offset + index + first * stride);
+      const T b = attribute_data_fetch<T>(kg, desc.element, desc.offset + index + second * stride);
+      return (1.0f - factor) * a + factor * b;
+    }
+  }
+  return attribute_data_fetch<T>(kg, desc.element, desc.offset + index);
+}
+
 /* Transform matrix attribute on meshes */
 
 ccl_device Transform primitive_attribute_matrix(KernelGlobals kg, const AttributeDescriptor desc)

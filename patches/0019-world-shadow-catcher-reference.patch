index 997afd6b5591416d5448c574006a373c14f73b2c..f8544e52780e427f784b74889589060e301a8bda 100644
--- a/src/scene/background.cpp
+++ b/src/scene/background.cpp
@@ -23,6 +23,7 @@ NODE_DEFINE(Background)
 
   SOCKET_BOOLEAN(use_shader, "Use Shader", true);
   SOCKET_UINT(visibility, "Visibility", PATH_RAY_VISIBILITY_ALL);
+  SOCKET_BOOLEAN(is_shadow_catcher, "Shadow Catcher Reference", true);
 
   SOCKET_BOOLEAN(transparent, "Transparent", false);
   SOCKET_BOOLEAN(transparent_glass, "Transparent Glass", false);
@@ -66,6 +67,12 @@ void Background::device_update(Device *device, DeviceScene *dscene, Scene *scene
 
   kbackground->transparent = transparent;
   kbackground->surface_shader = scene->shader_manager->get_shader_id(bg_shader);
+  /* Match the sampled BackgroundLight's reference visibility for rays which
+   * miss geometry. Constant environments can have background MIS disabled,
+   * so the light object's visibility flags alone do not cover these paths. */
+  if (!is_shadow_catcher) {
+    kbackground->surface_shader |= SHADER_EXCLUDE_SHADOW_CATCHER;
+  }
 
   if (transparent && transparent_glass) {
     /* Square twice, once for principled BSDF convention, and once for

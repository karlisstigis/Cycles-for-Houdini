diff --git a/src/kernel/integrator/shade_background.h b/src/kernel/integrator/shade_background.h
index 66df298206dea3bba892330127db62dd490396e4..22c27954974ec52a63b71d7e2bb262aa5e590492 100644
--- a/src/kernel/integrator/shade_background.h
+++ b/src/kernel/integrator/shade_background.h
@@ -47,7 +47,10 @@ ccl_device Spectrum integrator_eval_background_shader(KernelGlobals kg,
   const uint32_t path_flag = INTEGRATOR_STATE(state, path, flag);
 
   /* Use visibility flag to skip lights. */
-  if (!is_light_shader_visible_to_path(shader, path_visibility, path_flag)) {
+  if (((path_flag & PATH_RAY_SHADOW_CATCHER_PASS) &&
+       (shader & SHADER_EXCLUDE_SHADOW_CATCHER)) ||
+      !is_light_shader_visible_to_path(shader, path_visibility, path_flag))
+  {
     result = SHADER_EVAL_EMPTY;
     return zero_spectrum();
   }

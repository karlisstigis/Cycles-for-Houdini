@@ -14,6 +14,13 @@
 
 CCL_NAMESPACE_BEGIN
 
+/* Select the angular branch nearest the centre of the configured image.
+ * atan2 alone loses the branch for longitude windows such as 0..360 degrees. */
+ccl_device_inline float panorama_unwrap_angle(const float angle, const float centre)
+{
+  return angle + roundf((centre - angle) / M_2PI_F) * M_2PI_F;
+}
+

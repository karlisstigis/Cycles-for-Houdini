-    const float r2 = r * r;
-    const float F_r = theta - (coeff0 + dot(coeffs, make_float4(r, r2, r2 * r, r2 * r2)));
-    const float dF_r = dot(diff_coeffs, make_float4(1.0f, r, r2, r2 * r));

index 83a2c6d544787404d12258e0e0a48c016c4ebd7e..6d1b99638943356a6a82535b48fbde6b65fdfdc6 100644
--- a/src/scene/mesh_subdivision.cpp
+++ b/src/scene/mesh_subdivision.cpp
@@ -12,6 +12,7 @@
 
 #include "util/algorithm.h"
 #include "util/vector.h"
+#include "util/tbb.h"
 
 CCL_NAMESPACE_BEGIN
 
@@ -187,9 +188,91 @@ void Mesh::tessellate(SubdParams &params)
     if (subdivision_post_tessellate) {
       subdivision_post_tessellate(*this);
     }
+    if (subdivision_shading_samples) {
+      subdivision_shading_samples->ready = true;
+    }
   }
 
   // TODO: Free subd base data? Or will this break interactive updates?
 }
 
+void Mesh::remap_subdivision_shading_vertices(const int *indices, const size_t count)
+{
+  if (subdivision_shading_samples &&
+      !subdivision_shading_samples->remap_vertices(indices, count))
+  {
+    /* Budget pressure only disables this optional optimization. */
+    subdivision_shading_samples.reset();
+  }
+}
+
+bool Mesh::interpolate_subdivision_shading()
+{
+  auto *samples = subdivision_shading_samples.get();
+  if (!samples || !samples->ready || need_tesselation() ||
+      samples->vertices.size() != num_verts() || samples->triangles.size() != num_triangles())
+  {
+    return false;
+  }
+  if (subd_face_corners_is_modified() || subd_num_corners_is_modified() ||
+      subd_start_corner_is_modified() || subd_creases_edge_is_modified() ||
+      subd_creases_weight_is_modified() || subd_vert_creases_is_modified() ||
+      subd_vert_creases_weight_is_modified() || subd_smooth_is_modified())
+  {
+    return false;
+  }
+  for (const Attribute &attribute : subd_attributes.attributes) {
+    if (attribute.modified && (attribute.std == ATTR_STD_POSITION ||
+                               attribute.std == ATTR_STD_VERTEX_NORMAL ||
+                               attribute.std == ATTR_STD_CORNER_NORMAL))
+    {
+      return false;
+    }
+  }
+#ifdef WITH_OPENSUBDIV
+  OsdMesh osd_mesh(*this);
+  OsdData osd_data;
+  if (get_subdivision_type() == SUBDIVISION_CATMULL_CLARK) {
+    osd_data.build(osd_mesh);
+  }
+  SubdAttributeInterpolation interpolation(*this, osd_mesh, osd_data);
+#else
+  SubdAttributeInterpolation interpolation(*this);
+#endif
+  interpolation.setup(true);
+  if (!interpolation.vertex_attributes.empty()) {
+    parallel_for(blocked_range<size_t>(0, samples->vertices.size(), 1024), [&](const auto &range) {
+      for (size_t i = range.begin(); i < range.end(); ++i) {
+        const auto &sample = samples->vertices[i];
+        if (sample.patch < 0) {
+          continue; /* Unused control vertices are not read by render triangles. */
+        }
+        const int index = int(i);
+        const float2 uv = make_float2(sample.u, sample.v);
+        for (const auto &attribute : interpolation.vertex_attributes) {
+          attribute.interp(sample.patch, sample.face, sample.corner, &index, &uv, 1);
+        }
+      }
+    });
+  }
+  if (!interpolation.triangle_attributes.empty()) {
+    parallel_for(blocked_range<size_t>(0, samples->triangles.size(), 1024), [&](const auto &range) {
+      for (size_t i = range.begin(); i < range.end(); ++i) {
+        const auto &sample = samples->triangles[i];
+        if (sample.patch < 0) {
+          throw std::logic_error("Missing retained subdivision triangle ownership");
+        }
+        const int index = int(i);
+        const float2 uv[] = {make_float2(sample.u[0], sample.v[0]),
+                             make_float2(sample.u[1], sample.v[1]),
+                             make_float2(sample.u[2], sample.v[2])};
+        for (const auto &attribute : interpolation.triangle_attributes) {
+          attribute.interp(sample.patch, sample.face, sample.corner, &index, uv, 1);
+        }
+      }
+    });
+  }
+  return true;
+}
+
 CCL_NAMESPACE_END

diff --git a/src/subd/shading.h b/src/subd/shading.h
new file mode 100644
index 0000000000000000000000000000000000000000..8dcb3a59083a9529777433c518c5a2d856fcdc0f
--- /dev/null
+++ b/src/subd/shading.h
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "util/types.h"
+#include "util/vector.h"
+
+#include <atomic>
+#include <cassert>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+
+CCL_NAMESPACE_BEGIN
+
+/* Optional host-side integration storage. A shared budget covers all private
+ * mesh variants, including temporary vertex remapping allocations. Upstream
+ * users opt out by leaving Mesh::subdivision_shading_budget empty. */
+class SubdivisionShadingBudget {
+ public:
+  const size_t limit;
+  std::atomic<size_t> used{0};
+
+  explicit SubdivisionShadingBudget(const size_t limit) : limit(limit) {}
+
+  bool reserve(const size_t bytes)
+  {
+    size_t current = used.load(std::memory_order_relaxed);
+    do {
+      if (bytes > limit || current > limit - bytes) {
+        return false;
+      }
+    } while (!used.compare_exchange_weak(current, current + bytes, std::memory_order_relaxed));
+    return true;
+  }
+
+  void release(const size_t bytes)
+  {
+    const size_t previous = used.fetch_sub(bytes, std::memory_order_relaxed);
+    assert(previous >= bytes);
+    (void)previous;
+  }
+};
+
+/* Use scalar UV components to avoid padding to float2 alignment. */
+struct SubdivisionShadingVertex {
+  int patch = -1, face = 0, corner = 0;
+  float u = 0, v = 0;
+};
+struct SubdivisionShadingTriangle {
+  int patch = -1, face = 0, corner = 0;
+  float u[3] = {}, v[3] = {};
+};
+
+struct SubdivisionShadingSamples {
+  std::shared_ptr<SubdivisionShadingBudget> budget;
+  size_t reservation = 0;
+  vector<SubdivisionShadingVertex> vertices;
+  vector<SubdivisionShadingTriangle> triangles;
+  bool ready = false;
+
+  SubdivisionShadingSamples() = default;
+  SubdivisionShadingSamples(const SubdivisionShadingSamples &) = delete;
+  SubdivisionShadingSamples &operator=(const SubdivisionShadingSamples &) = delete;
+  ~SubdivisionShadingSamples()
+  {
+    vertices.free_memory();
+    triangles.free_memory();
+    if (budget) {
+      budget->release(reservation);
+    }
+  }
+
+  static std::unique_ptr<SubdivisionShadingSamples> create(
+      const std::shared_ptr<SubdivisionShadingBudget> &budget,
+      const size_t vertex_count,
+      const size_t triangle_count)
+  {
+    if (!budget) {
+      return nullptr;
+    }
+    constexpr size_t maximum = std::numeric_limits<size_t>::max();
+    if (vertex_count > (maximum - sizeof(SubdivisionShadingSamples)) /
+                           sizeof(SubdivisionShadingVertex))
+    {
+      return nullptr;
+    }
+    const size_t vertex_bytes = vertex_count * sizeof(SubdivisionShadingVertex);
+    if (triangle_count > (maximum - sizeof(SubdivisionShadingSamples) - vertex_bytes) /
+                             sizeof(SubdivisionShadingTriangle))
+    {
+      return nullptr;
+    }
+    const size_t bytes = sizeof(SubdivisionShadingSamples) + vertex_bytes +
+                         triangle_count * sizeof(SubdivisionShadingTriangle);
+    auto samples = std::make_unique<SubdivisionShadingSamples>();
+    if (!budget->reserve(bytes)) {
+      return nullptr;
+    }
+    samples->budget = budget;
+    samples->reservation = bytes;
+    samples->vertices.resize(vertex_count);
+    samples->triangles.resize(triangle_count);
+    return samples;
+  }
+
+  bool remap_vertices(const int *indices, const size_t count)
+  {
+    if (count < vertices.size()) {
+      throw std::logic_error("Subdivision shading remap removed existing vertices");
+    }
+    for (size_t i = 0; i < count; ++i) {
+      if (indices[i] < 0 || size_t(indices[i]) >= vertices.size()) {
+        throw std::logic_error("Subdivision shading remap references an unowned vertex");
+      }
+    }
+    if (count > std::numeric_limits<size_t>::max() / sizeof(SubdivisionShadingVertex)) {
+      return false;
+    }
+    const size_t temporary_bytes = count * sizeof(SubdivisionShadingVertex);
+    if (!budget->reserve(temporary_bytes)) {
+      return false;
+    }
+    reservation += temporary_bytes;
+    vector<SubdivisionShadingVertex> replacement(count);
+    for (size_t i = 0; i < count; ++i) {
+      replacement[i] = vertices[indices[i]];
+    }
+    const size_t previous_bytes = vertices.size() * sizeof(SubdivisionShadingVertex);
+    vertices.swap(replacement);
+    replacement.free_memory();
+    budget->release(previous_bytes);
+    reservation -= previous_bytes;
+    return true;
+  }
+};
+
+CCL_NAMESPACE_END

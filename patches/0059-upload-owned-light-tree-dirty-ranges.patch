+struct LightTreeUpload {
+  size_t bytes = 0, spans = 0;
+  bool partial = false;
+};
+
+template<typename T>
+static LightTreeUpload light_tree_upload(device_vector<T> &buffer,
+                                          const DeviceMemoryDirtyRanges &dirty,
+                                          const bool changed)
+{
+  if (!changed || buffer.size() == 0) {
+    return {};
+  }
+  const char *disable = std::getenv("CYCLES_HOUDINI_DISABLE_LIGHT_TREE_RANGE_UPLOAD");
+  const vector<DeviceMemoryRange> ranges = dirty.ranges();
+  if (ranges.empty()) {
+    throw std::runtime_error("Changed light-tree buffer has no dirty rows");
+  }
+  const size_t bytes = device_memory_validate_ranges(buffer.memory_size(), ranges);
+  if (!(disable && std::strcmp(disable, "1") == 0) && bytes < buffer.memory_size() &&
+      buffer.copy_to_device_ranges(ranges))
+  {
+    return {bytes, ranges.size(), true};
+  }
+  buffer.copy_to_device();
+  return {buffer.memory_size(), 1, false};
+}

diff --git a/src/device/memory_range.h b/src/device/memory_range.h
new file mode 100644
index 0000000000000000000000000000000000000000..a5368cf6973e33902b5d18871fda227bcdc531c2
--- /dev/null
+++ b/src/device/memory_range.h
@@ -0,0 +1,109 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "util/types.h"
+#include "util/vector.h"
+#include <algorithm>
+#include <atomic>
+#include <limits>
+#include <memory>
+#include <stdexcept>
+
+CCL_NAMESPACE_BEGIN
+
+struct DeviceMemoryRange {
+  size_t offset = 0;
+  size_t size = 0;
+};
+
+/* Byte ranges are ordered, disjoint and checked before any device is touched. */
+inline size_t device_memory_validate_ranges(const size_t bytes,
+                                          const vector<DeviceMemoryRange> &ranges)
+{
+  size_t end = 0, total = 0;
+  for (const DeviceMemoryRange &range : ranges) {
+    if (!range.size || range.offset < end || range.offset > bytes ||
+        range.size > bytes - range.offset)
+    {
+      throw std::runtime_error("Invalid owned device memory copy range");
+    }
+    end = range.offset + range.size;
+    total += range.size;
+  }
+  return total;
+}
+
+/* Exact row comparisons mark coarse blocks concurrently. Storage is bounded by
+ * one bit per 256 rows, with at most 64 coalesced transfers. Dense edits use the
+ * ordinary full upload. No source/device pointers are retained here. */
+class DeviceMemoryDirtyRanges {
+ public:
+  static constexpr size_t block_rows = 256;
+  static constexpr size_t max_ranges = 64;
+
+  void reset(const size_t rows, const size_t stride, const bool compare)
+  {
+    if (!stride || rows > std::numeric_limits<size_t>::max() / stride) {
+      throw std::runtime_error("Invalid owned device dirty-row layout");
+    }
+    rows_ = rows;
+    stride_ = stride;
+    compare_ = compare;
+    const size_t blocks = rows / block_rows + (rows % block_rows != 0);
+    words_ = compare ? blocks / 64 + (blocks % 64 != 0) : 0;
+    bits_.reset(words_ ? new std::atomic<uint64_t>[words_] : nullptr);
+    for (size_t i = 0; i < words_; ++i) {
+      bits_[i].store(0, std::memory_order_relaxed);
+    }
+  }
+
+  void mark(const size_t row) const
+  {
+    if (row >= rows_) {
+      throw std::runtime_error("Device dirty row exceeds its owner");
+    }
+    if (compare_) {
+      const size_t block = row / block_rows;
+      bits_[block / 64].fetch_or(uint64_t(1) << (block % 64), std::memory_order_relaxed);
+    }
+  }
+
+  vector<DeviceMemoryRange> ranges() const
+  {
+    const size_t bytes = rows_ * stride_;
+    if (!compare_) {
+      return bytes ? vector<DeviceMemoryRange>{{0, bytes}} : vector<DeviceMemoryRange>{};
+    }
+    vector<DeviceMemoryRange> result;
+    const size_t blocks = rows_ / block_rows + (rows_ % block_rows != 0);
+    size_t total = 0;
+    for (size_t block = 0; block < blocks; ++block) {
+      if (!(bits_[block / 64].load(std::memory_order_relaxed) &
+            (uint64_t(1) << (block % 64))))
+      {
+        continue;
+      }
+      const size_t first = block * block_rows;
+      const size_t number = std::min(block_rows, rows_ - first);
+      const DeviceMemoryRange range{first * stride_, number * stride_};
+      total += range.size;
+      if (!result.empty() && result.back().offset + result.back().size == range.offset) {
+        result.back().size += range.size;
+      }
+      else {
+        result.push_back(range);
+      }
+      if (result.size() > max_ranges || total >= bytes / 2) {
+        return {{0, bytes}};
+      }
+    }
+    return result;
+  }
+
+ private:
+  size_t rows_ = 0, stride_ = 0, words_ = 0;
+  bool compare_ = false;
+  std::unique_ptr<std::atomic<uint64_t>[]> bits_;
+};
+
+CCL_NAMESPACE_END

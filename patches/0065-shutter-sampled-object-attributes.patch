+/* Object user fields store their requested-frame value first, followed by ALL
+ * chronological shutter samples. The requested frame need not be the shutter
+ * midpoint. Their sample count is independent of prototype deformation. */
+ccl_device_inline float attribute_object_lerp(const float a, const float b, const float factor)
+{
+  if (factor <= 0.0f || __float_as_uint(a) == __float_as_uint(b)) {
+    return a;
+  }
+  if (factor >= 1.0f) {
+    return b;
+  }
+  return (1.0f - factor) * a + factor * b;
+}
+
+ccl_device_inline float2 attribute_object_lerp(const float2 a, const float2 b, const float factor)
+{
+  return make_float2(attribute_object_lerp(a.x, b.x, factor),
+                     attribute_object_lerp(a.y, b.y, factor));
+}
+
+ccl_device_inline float3 attribute_object_lerp(const float3 a, const float3 b, const float factor)
+{
+  return make_float3(attribute_object_lerp(a.x, b.x, factor),
+                     attribute_object_lerp(a.y, b.y, factor),
+                     attribute_object_lerp(a.z, b.z, factor));
+}
+
+ccl_device_inline float4 attribute_object_lerp(const float4 a, const float4 b, const float factor)
+{
+  return make_float4(attribute_object_lerp(a.x, b.x, factor),
+                     attribute_object_lerp(a.y, b.y, factor),
+                     attribute_object_lerp(a.z, b.z, factor),
+                     attribute_object_lerp(a.w, b.w, factor));
+}
+
+template<typename T>
+ccl_device T attribute_data_fetch_object(KernelGlobals kg,
+                                         const ccl_private ShaderData *sd,
+                                         const AttributeDescriptor desc)
+{
+  const int encoded_steps = desc.object_motion & 127;
+  const int count = encoded_steps ? 2 * encoded_steps + 1 : 0;
+  const bool hold = (desc.object_motion & 128) &&
+                    (sd->runtime_flag & SR_OBJECT_ATTRIBUTE_DISPLACEMENT);
+  if (count > 1 && !hold && sd->time >= 0.0f && kernel_data.cam.shuttertime != -1.0f) {
+    const float normalized_time = saturatef(sd->time);
+    const float time = normalized_time * (count - 1);
+    const int step = min(int(time), count - 2);
+    const float factor = time - step;
+    const T a = attribute_data_fetch<T>(kg, desc.element, desc.offset + step + 1);
+    const T b = attribute_data_fetch<T>(kg, desc.element, desc.offset + step + 2);
+    /* A normalized authored breakpoint can multiply to just below its integer
+     * lattice position. Preserve its payload even for non-power-of-two grids. */
+    if (normalized_time == float(step) / float(count - 1)) {
+      return a;
+    }
+    if (normalized_time == float(step + 1) / float(count - 1)) {
+      return b;
+    }
+    return attribute_object_lerp(a, b, factor);
+  }
+  return attribute_data_fetch<T>(kg, desc.element, desc.offset);
+}
+

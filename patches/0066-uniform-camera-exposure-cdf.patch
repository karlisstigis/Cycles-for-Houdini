diff --git a/src/scene/camera.cpp b/src/scene/camera.cpp
index aab2133e4eeb2eff93a982233d25b60d372c64f0..a8a6659b477abc750bb78859d0de11bd7d06b385 100644
--- a/src/scene/camera.cpp
+++ b/src/scene/camera.cpp
@@ -3,6 +3,7 @@
  * SPDX-License-Identifier: Apache-2.0 */
 
 #include <algorithm>
+#include <cmath>
 
 #include "scene/camera.h"
 #include "scene/mesh.h"
@@ -44,6 +45,34 @@ float camera_shutter_curve_eval(float x, const array<float> &shutter_curve)
   return shutter_curve[shutter_curve.size() - 1];
 }
 
+void camera_shutter_curve_table(const array<float> &shutter_curve, vector<float> &table)
+{
+  static_assert(SHUTTER_TABLE_SIZE >= 2);
+  const bool uniform = shutter_curve.empty() ||
+                       (shutter_curve[0] > 0.0f && std::isfinite(shutter_curve[0]) &&
+                        std::all_of(shutter_curve.begin(), shutter_curve.end(), [&](const float value) {
+                          return value == shutter_curve[0];
+                        }));
+  if (uniform) {
+    /* The generic midpoint CDF table contracts the default camera exposure
+     * interval and shifts its mean. Camera lookup interpolates endpoint knots,
+     * so a constant positive PDF needs an identity table over the full shutter. */
+    table.resize(SHUTTER_TABLE_SIZE);
+    for (int i = 0; i < SHUTTER_TABLE_SIZE; ++i) {
+      table[i] = float(i) / float(SHUTTER_TABLE_SIZE - 1);
+    }
+    return;
+  }
+  /* Preserve authored nonuniform exposure and all generic film-filter CDFs. */
+  util_cdf_inverted(
+      SHUTTER_TABLE_SIZE,
+      0.0f,
+      1.0f,
+      [&](const float x) { return camera_shutter_curve_eval(x, shutter_curve); },
+      false,
+      table);
+}
+
 NODE_DEFINE(Camera)
 {
   NodeType *type = NodeType::add("camera", create);
@@ -573,13 +602,7 @@ void Camera::device_update(Device * /*device*/, DeviceScene *dscene, Scene *scen
   scene->lookup_tables->remove_table(&shutter_table_offset);
   if (kernel_camera.shuttertime != -1.0f) {
     vector<float> shutter_table;
-    util_cdf_inverted(
-        SHUTTER_TABLE_SIZE,
-        0.0f,
-        1.0f,
-        [this](const float x) { return camera_shutter_curve_eval(x, shutter_curve); },
-        false,
-        shutter_table);
+    camera_shutter_curve_table(shutter_curve, shutter_table);
     shutter_table_offset = scene->lookup_tables->add_table(dscene, shutter_table);
     kernel_camera.shutter_table_offset = (int)shutter_table_offset;
   }

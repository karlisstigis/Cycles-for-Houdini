+void ObjectManager::verify_object_table(Device *device,
+                                        DeviceScene *dscene,
+                                        Scene *scene,
+                                        Progress &progress)
+{
+  if (!object_table_verify_pending) {
+    return;
+  }
+  object_table_verify_pending = false;
+  const char *prefix = "Object table verification failed: ";
+  if (scene->update_stats) {
+    scene->update_stats->object.times.add_entry({"object table verifications", 1.0});
+  }
+
+  /* 1. The device copies hold the host tables, on every device. */
+  string difference;
+  if (!device->verify_device_copy(dscene->objects, difference) ||
+      !device->verify_device_copy(dscene->object_flag, difference) ||
+      (dscene->object_motion.size() && !device->verify_device_copy(dscene->object_motion, difference)) ||
+      (dscene->object_motion_pass.size() &&
+       !device->verify_device_copy(dscene->object_motion_pass, difference)))
+  {
+    progress.set_error(prefix + difference);
+    return;
+  }
+
+  /* 2. A full rewrite of every object gives the same tables. */
+  const size_t n = scene->objects.size();
+  const vector<KernelObject> objects(dscene->objects.data(), dscene->objects.data() + n);
+  const vector<uint> flags(dscene->object_flag.data(), dscene->object_flag.data() + n);
+  const vector<DecomposedTransform> motion(dscene->object_motion.data(),
+                                           dscene->object_motion.data() + dscene->object_motion.size());
+  const vector<Transform> motion_pass(dscene->object_motion_pass.data(),
+                                      dscene->object_motion_pass.data() +
+                                          dscene->object_motion_pass.size());
+  const KernelBVH bvh = dscene->data.bvh;
+
+  object_table_force_full = true;
+  device_update_transforms(dscene, scene, progress);
+  object_table_force_full = false;
+  device_update_geom_offsets(device, dscene, scene);
+  need_flags_update = true;
+  device_update_flags(device, dscene, scene, progress);
+  if (progress.get_cancel()) {
+    return;
+  }
+
+  for (size_t i = 0; i < n; i++) {
+    const char *a = reinterpret_cast<const char *>(&objects[i]);
+    const char *b = reinterpret_cast<const char *>(dscene->objects.data() + i);
+    for (size_t byte = 0; byte < sizeof(KernelObject); byte++) {
+      if (a[byte] != b[byte]) {
+        progress.set_error(prefix + string_printf("object %zu (%s) ", i, scene->objects[i]->name.c_str()) +
+                           kernel_object_member(byte));
+        return;
+      }
+    }
+    if (flags[i] != dscene->object_flag.data()[i]) {
+      progress.set_error(prefix + string_printf("object %zu (%s) flags %x instead of %x", i,
+                                                scene->objects[i]->name.c_str(), flags[i],
+                                                dscene->object_flag.data()[i]));
+      return;
+    }
+  }
+  if (motion.size() != dscene->object_motion.size() ||
+      (motion.size() && std::memcmp(motion.data(), dscene->object_motion.data(),
+                                    motion.size() * sizeof(DecomposedTransform)) != 0))
+  {
+    progress.set_error(string(prefix) + "object motion table");
+    return;
+  }
+  if (motion_pass.size() != dscene->object_motion_pass.size() ||
+      (motion_pass.size() && std::memcmp(motion_pass.data(), dscene->object_motion_pass.data(),
+                                         motion_pass.size() * sizeof(Transform)) != 0))
+  {
+    progress.set_error(string(prefix) + "object motion pass table");
+    return;
+  }
+  if (bvh.have_motion != dscene->data.bvh.have_motion || bvh.have_curves != dscene->data.bvh.have_curves ||
+      bvh.have_points != dscene->data.bvh.have_points || bvh.have_volumes != dscene->data.bvh.have_volumes)
+  {
+    progress.set_error(string(prefix) + "scene object flags (motion, curves, points, volumes)");
+    return;
+  }
+}

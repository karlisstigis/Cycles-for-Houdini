+bool Device::verify_device_copy(device_memory &mem, string &difference)
+{
+  if (info.type == DEVICE_CPU || !mem.host_pointer || !mem.device_pointer) {
+    return true;
+  }
+  const size_t bytes = mem.memory_size();
+  if (bytes == 0) {
+    return true;
+  }
+  vector<char> scratch(bytes);
+  void *host = mem.host_pointer;
+  mem.host_pointer = scratch.data();
+  mem_copy_from(mem, 0, mem.data_size, 1, mem.memory_elements_size(1));
+  mem.host_pointer = host;
+  for (size_t i = 0; i < bytes; i++) {
+    if (scratch[i] != static_cast<const char *>(host)[i]) {
+      difference = string_printf("%s on %s differs at byte %zu", mem.global_name(), info.description.c_str(), i);
+      return false;
+    }
+  }
+  return true;
+}

+/* Name of the KernelObject member that contains a byte, for verification messages. */
+static string kernel_object_member(const size_t byte)
+{
+  struct Member {
+    const char *name;
+    size_t offset;
+  };
+  static const Member members[] = {
+#define KERNEL_OBJECT_MEMBER(name) {#name, offsetof(KernelObject, name)}
+      KERNEL_OBJECT_MEMBER(tfm),
+      KERNEL_OBJECT_MEMBER(itfm),
+      KERNEL_OBJECT_MEMBER(color),
+      KERNEL_OBJECT_MEMBER(alpha),
+      KERNEL_OBJECT_MEMBER(pass_id),
+      KERNEL_OBJECT_MEMBER(random_number),
+      KERNEL_OBJECT_MEMBER(particle_index),
+      KERNEL_OBJECT_MEMBER(motion_offset),
+      KERNEL_OBJECT_MEMBER(numverts),
+      KERNEL_OBJECT_MEMBER(numprims),
+      KERNEL_OBJECT_MEMBER(attribute_map_offset),
+      KERNEL_OBJECT_MEMBER(position_offset),
+      KERNEL_OBJECT_MEMBER(visibility),
+      KERNEL_OBJECT_MEMBER(primitive_type),
+      KERNEL_OBJECT_MEMBER(lightgroup),
+#undef KERNEL_OBJECT_MEMBER
+  };
+  const char *name = "unnamed member";
+  size_t best = 0;
+  for (const Member &member : members) {
+    if (member.offset <= byte && member.offset >= best) {
+      best = member.offset;
+      name = member.name;
+    }
+  }
+  return string_printf("byte %zu (at or after member %s)", byte, name);
+}

Subject: [PATCH] latched quick cancellation

Locked-Patch: patches/0037-latched-quick-cancellation.patch
Locked-Patch-SHA256: a5b38078f5823c1f6ca2694c890423d2d3ab26e7e0b3d32f052f79ca55924e41
Contract: docs/renderer-patch-contracts.md
Related-Fixture: tests/houdini_scene_interruption_smoke.py
Qualification: Source replay only; no new runtime qualification asserted.

Rebased-From: 2336230a956d40913f965062b5481052f2589804
Previous-Patch: patches/0037-latched-quick-cancellation.patch
Previous-Patch-SHA256: a5b38078f5823c1f6ca2694c890423d2d3ab26e7e0b3d32f052f79ca55924e41
Rationale: A latched explicit host cancellation must stay requested until the session becomes idle, while ordinary progressive denoise behavior keeps its default.
Contract: latched quick cancellation
Tests: tests/houdini_scene_interruption_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/integrator/path_trace.cpp b/src/integrator/path_trace.cpp
index b0a751b7f1582df354f296d4ac89eb9f472c6324..9de94fe879ec3a8defc48a11eb0d41ec3e3434f5 100644
--- a/src/integrator/path_trace.cpp
+++ b/src/integrator/path_trace.cpp
@@ -626,7 +626,9 @@ void PathTrace::set_denoiser_params(const DenoiseParams &params)
       /* Only take into account the "immediate" cancel to have interactive rendering responding to
        * navigation as quickly as possible, but allow to run denoiser after user hit Escape key
        * while doing offline rendering. */
-      denoiser_->is_cancelled_cb = [this]() { return render_cancel_.is_requested; };
+      denoiser_->is_cancelled_cb = [this]() {
+        return render_cancel_.is_requested.load(std::memory_order_relaxed);
+      };
     }
   }
 
@@ -948,28 +950,35 @@ void PathTrace::finalize_full_buffer_on_disk(const RenderWork &render_work)
    * so that we never hold scene and full-frame buffer in memory at the same time). */
 }
 
-void PathTrace::cancel()
+void PathTrace::cancel(bool keep_requested)
 {
   thread_scoped_lock lock(render_cancel_.mutex);
 
-  /* With interactive denoisers like DLSS always render 1 complete sample,
-   * otherwise interactivity becomes bad. Otherwise cancel immediately so
-   * the main thread isn't blocked. */
-  if (!render_scheduler_.is_denoiser_interactive() || get_num_samples_in_buffer() > 1) {
-    render_cancel_.is_requested = true;
+  /* A latched host interruption must stop promptly, while an ordinary interactive
+   * restart lets DLSS finish its first sample. */
+  if (keep_requested || !render_scheduler_.is_denoiser_interactive() ||
+      get_num_samples_in_buffer() > 1) {
+    render_cancel_.is_requested.store(true, std::memory_order_relaxed);
   }
 
   while (render_cancel_.is_rendering) {
     render_cancel_.condition.wait(lock);
   }
 
-  render_cancel_.is_requested = false;
-
+  if (!keep_requested) {
+    render_cancel_.is_requested.store(false, std::memory_order_relaxed);
+  }
   if (display_) {
     display_->reset();
   }
 }
 
+void PathTrace::clear_cancel()
+{
+  const thread_scoped_lock lock(render_cancel_.mutex);
+  render_cancel_.is_requested.store(false, std::memory_order_relaxed);
+}
+
 int PathTrace::get_num_samples_in_buffer()
 {
   return render_scheduler_.get_num_rendered_samples();

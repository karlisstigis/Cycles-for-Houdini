    */
-  void cancel();
+  void cancel(bool keep_requested = false);
+  /* Clear a latched quick cancel only after the session thread is idle. */
+  void clear_cancel();
 
   /* Copy an entire render buffer to/from the path trace. */
 
@@ -199,7 +201,8 @@ class PathTrace {
  protected:
   bool is_render_cancel_requested() const
   {
-    return render_cancel_.is_requested || scene_update_requested_.load(std::memory_order_relaxed);
+    return render_cancel_.is_requested.load(std::memory_order_relaxed) ||
+           scene_update_requested_.load(std::memory_order_relaxed);
   }
 
   std::atomic<bool> scene_update_requested_{false};
@@ -364,7 +367,7 @@ class PathTrace {
     bool is_rendering = false;
 
     /* Indicates whether rendering is requested to be canceled by `cancel()`. */
-    bool is_requested = false;
+    std::atomic<bool> is_requested{false};
 
     /* Synchronization between thread which does `render_samples()` and thread which does
      * `cancel()`. */

diff --git a/src/integrator/path_trace.h b/src/integrator/path_trace.h
index 0a47de43bff9797e73497a2c6279251b7ccbea25..fe64ff2d38eb81b7be578296b1ad3b70d1ae988d 100644
--- a/src/integrator/path_trace.h
+++ b/src/integrator/path_trace.h
@@ -4,6 +4,7 @@
 
 #pragma once
 
+#include <atomic>
 #include <functional>
 
 #include "integrator/denoiser.h"
@@ -68,6 +69,14 @@ class PathTrace {
    * render result. */
   bool ready_to_reset();
 
+  /* Latch a pending scene transaction without waiting or cancelling the session.
+   * Session publishes true under its transaction mutex and clears it on the render
+   * thread at the next safe boundary. A regular reset/cancel must not clear it. */
+  void set_scene_update_requested(bool requested)
+  {
+    scene_update_requested_.store(requested, std::memory_order_relaxed);
+  }
+
   void reset(const BufferParams &full_params,
              const BufferParams &big_tile_params,
              bool reset_rendering);
@@ -187,6 +196,13 @@ class PathTrace {
   std::function<void(void)> progress_update_cb;
 
  protected:
+  bool is_render_cancel_requested() const
+  {
+    return render_cancel_.is_requested || scene_update_requested_.load(std::memory_order_relaxed);
+  }
+
+  std::atomic<bool> scene_update_requested_{false};
+
   /* Actual implementation of the rendering pipeline.
    * Calls steps in order, checking for the cancel to be requested in between.
    *
diff --git a/src/integrator/path_trace_work.h b/src/integrator/path_trace_work.h
index 2e51f643dcaab8d7481d485db06c0507d25f691f..2b7ae1bdd29a096b145ac6feb1abdc92fb9cf28e 100644
--- a/src/integrator/path_trace_work.h
+++ b/src/integrator/path_trace_work.h
@@ -4,6 +4,8 @@
 
 #pragma once
 

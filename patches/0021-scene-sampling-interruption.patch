+
 #include "integrator/pass_accessor.h"
 #include "scene/pass.h"
 #include "session/buffers.h"
@@ -36,6 +38,12 @@ class PathTraceWork {
 
   virtual ~PathTraceWork();
 
+  /* Set once before execution. PathTrace owns the flag for this work's lifetime. */
+  void set_scene_update_requested_flag(const std::atomic<bool> *flag)
+  {
+    scene_update_requested_flag_ = flag;
+  }
+
   /* Access the render buffers.
    *
    * Is only supposed to be used by the PathTrace to update buffer allocation and slicing to
@@ -141,7 +149,8 @@ class PathTraceWork {
   {
     /* NOTE: Rely on the fact that on x86 CPU reading scalar can happen without atomic even in
      * threaded environment. */
-    return *cancel_requested_flag_;
+    return *cancel_requested_flag_ ||
+           (scene_update_requested_flag_ && scene_update_requested_flag_->load(std::memory_order_relaxed));
   }
 
   /* Access to the device which is used to path trace this work on. */
@@ -197,6 +206,7 @@ class PathTraceWork {
   BufferParams effective_denoised_buffer_params_;
 
   const bool *cancel_requested_flag_ = nullptr;
+  const std::atomic<bool> *scene_update_requested_flag_ = nullptr;
 };
 

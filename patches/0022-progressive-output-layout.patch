+int2 PathTraceTile::get_pass_render_size(const string_view pass_name) const
+{
+  const BufferPass *pass = find_pass(pass_name);
+  return pass ? path_trace_.get_render_tile_effective_size(pass->mode) : make_int2(0, 0);
+}
+
+bool PathTraceTile::get_pass_pixels(const string_view pass_name,
+                                    const int num_channels,
+                                    float *pixels) const
+{
+  /* The caller holds the session at a synchronization point for this read. */
+  const BufferPass *pass = find_pass(pass_name);
   if (pass == nullptr) {
     /* Happens when interactive session changes display pass but render
      * buffer does not contain it yet. */
     return false;
   }
 
+  if (!copied_from_device_) {
+    path_trace_.copy_render_tile_from_device();
+    copied_from_device_ = true;
+  }
+
+  const BufferParams &buffer_params = path_trace_.get_render_tile_params();
+
   const float exposure = buffer_params.exposure;
   const int num_samples = path_trace_.get_num_render_tile_samples();
 
@@ -73,6 +84,31 @@ bool PathTraceTile::get_pass_pixels(const string_view pass_name,
       pass_access_info.use_approximate_shadow_catcher && !buffer_params.use_transparent_background;
 
   const PassAccessorCPU pass_accessor(pass_access_info, exposure, num_samples);
+  const int2 rendered = path_trace_.get_render_tile_effective_size(pass->mode);
+  if (rendered.x <= 0 || rendered.y <= 0 || rendered.x > size.x || rendered.y > size.y) {
+    return false;
+  }
+  if (rendered != size) {
+    /* Preserve OutputDriver's full tile contract. Read packed effective pixels,
+     * then expand with nearest sampling so raw IDs/data are never interpolated.
+     * No allocated-but-unrendered rows can reach the host. */
+    vector<float> preview(size_t(rendered.x) * rendered.y * num_channels);
+    const PassAccessor::Destination destination(preview.data(), num_channels);
+    if (!path_trace_.get_render_tile_pixels(pass_accessor, destination)) {
+      return false;
+    }
+    parallel_for(0, size.y, [&](int64_t y) {
+      const size_t source_y = size_t(y) * rendered.y / size.y;
+      for (int x = 0; x < size.x; ++x) {
+        const size_t source = (source_y * rendered.x + size_t(x) * rendered.x / size.x) * num_channels;
+        const size_t target = (size_t(y) * size.x + x) * num_channels;
+        for (int c = 0; c < num_channels; ++c) {
+          pixels[target + c] = preview[source + c];
+        }
+      }
+    });
+    return true;
+  }
   const PassAccessor::Destination destination(pixels, num_channels);
 
   return path_trace_.get_render_tile_pixels(pass_accessor, destination);

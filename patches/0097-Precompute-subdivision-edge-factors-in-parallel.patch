 int DiagSplit::alloc_verts(int num)
 {
   if (num < 0 || num > std::numeric_limits<int>::max() - num_verts) {
+    if (record_edge_factors) {
+      /* A speculative split only records edge factors, it reports no errors. */
+      return 0;
+    }
     if (params.progress) {
       params.progress->set_error("Subdivision vertex indexing limit exceeded");
       return 0;
@@ -77,6 +83,9 @@ void DiagSplit::alloc_edge(SubPatch::Edge *sub_edge,
 
 void DiagSplit::alloc_subpatch(SubPatch &&sub)
 {
+  if (record_edge_factors) {
+    return;
+  }
   if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
     return;
   }
@@ -125,10 +134,44 @@ float3 DiagSplit::to_world(const Patch *patch, const float2 uv)
 }
 
 std::pair<int, float> DiagSplit::T(const Patch *patch,
-                                   float2 uv_start,
-                                   float2 uv_end,
+                                   const float2 uv_start,
+                                   const float2 uv_end,
                                    const int depth,
                                    const bool recursive_resolve)
+{
+  if (record_edge_factors) {
+    const std::pair<int, float> result = compute_T(
+        patch, uv_start, uv_end, depth, recursive_resolve);
+    record_edge_factors->push_back({patch, uv_start, uv_end, depth, recursive_resolve, result});
+    return result;
+  }
+
+  /* compute_T() depends only on its arguments, so a precomputed result with exactly the
+   * same arguments is the result it would compute. They are usually requested in the
+   * order they were recorded. */
+  for (int pass = 0; pass < 2; pass++) {
+    const EdgeFactor *begin = (pass == 0) ? precomputed_next : precomputed_begin;
+    const EdgeFactor *end = (pass == 0) ? precomputed_end : precomputed_next;
+    for (const EdgeFactor *factor = begin; factor < end; factor++) {
+      if (factor->patch == patch && factor->depth == depth &&
+          factor->recursive_resolve == recursive_resolve &&
+          memcmp(&factor->uv_start, &uv_start, sizeof(float2)) == 0 &&
+          memcmp(&factor->uv_end, &uv_end, sizeof(float2)) == 0)
+      {
+        precomputed_next = factor + 1;
+        return factor->result;
+      }
+    }
+  }
+
+  return compute_T(patch, uv_start, uv_end, depth, recursive_resolve);
+}
+
+std::pair<int, float> DiagSplit::compute_T(const Patch *patch,
+                                           float2 uv_start,
+                                           float2 uv_end,
+                                           const int depth,
+                                           const bool recursive_resolve)
 {

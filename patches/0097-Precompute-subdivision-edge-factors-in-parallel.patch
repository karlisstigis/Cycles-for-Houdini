                        params.camera->has_intrinsic_projection_motion())) {
@@ -183,8 +226,8 @@ std::pair<int, float> DiagSplit::T(const Patch *patch,
     }
     else {
       const float2 uv_mid = (uv_start + uv_end) * 0.5f;
-      const auto result_a = T(patch, uv_start, uv_mid, depth, true);
-      const auto result_b = T(patch, uv_mid, uv_end, depth, true);
+      const auto result_a = compute_T(patch, uv_start, uv_mid, depth, true);
+      const auto result_b = compute_T(patch, uv_mid, uv_end, depth, true);
       res = result_a.first + result_b.first;
       Lsum_world = result_a.second + result_b.second;
     }
@@ -799,11 +842,25 @@ void DiagSplit::split_ngon(const Mesh::SubdFace &face,
   }
 }
 
+void DiagSplit::split_face(const Patch *patches,
+                           const size_t patches_byte_stride,
+                           const int face_index)
+{
+  Mesh::SubdFace face = params.mesh->get_subd_face(face_index);
+  const Patch *patch = (const Patch *)(((char *)patches) +
+                                       (face.ptex_offset * patches_byte_stride));
+  if (face.is_quad()) {
+    split_quad(face, face_index, patch);
+  }
+  else {
+    split_ngon(face, face_index, patch, patches_byte_stride);
+  }
+}
+
 void DiagSplit::split_patches(const Patch *patches, const size_t patches_byte_stride)
 {
   /* TODO: reuse edge factor vertex position computations. */
   /* TODO: support not splitting n-gons if not needed. */
-  /* TODO: multi-threading. */
 
   /* Keep base mesh vertices, create new triangles. */
   num_verts = params.mesh->get_num_subd_base_verts();
@@ -811,21 +868,65 @@ void DiagSplit::split_patches(const Patch *patches, const size_t patches_byte_st
 
   owned_verts.resize(num_verts, false);
 
+  /* Edge factors need patch evaluations and dominate the cost of splitting. Precompute
+   * them by splitting batches of faces speculatively in parallel, each range of faces
+   * with its own edges. Then split the faces in order exactly as before, taking an edge
+   * factor from the precomputed ones when its arguments match and computing it
+   * otherwise, so the result is identical to a serial split. The next batch is
+   * precomputed while the current one is split. */
+  const int num_faces = params.mesh->get_num_subd_faces();
+  const int num_base_verts = num_verts;
+  const int batch_size = 16384;
+  vector<vector<EdgeFactor>> batch_factors[2];
+
+  const auto precompute = [&](const int begin, vector<vector<EdgeFactor>> &factors) {
+    const int end = min(begin + batch_size, num_faces);
+    factors.clear();
+    factors.resize(end - begin);
+    parallel_for(blocked_range<int>(begin, end, 64), [&](const blocked_range<int> &r) {
+      DiagSplit speculative(params);
+      speculative.num_verts = num_base_verts;
+      for (int f = r.begin(); f != r.end(); f++) {
+        if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
+          return;
+        }
+        speculative.record_edge_factors = &factors[f - begin];
+        speculative.split_face(patches, patches_byte_stride, f);
+      }
+    });
+  };
+
+  if (num_faces > 0) {
+    precompute(0, batch_factors[0]);
+  }
+
   /* Split all faces in the mesh. */
-  for (int f = 0; f < params.mesh->get_num_subd_faces(); f++) {
-    if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
-      return;
+  for (int begin = 0, batch = 0; begin < num_faces; begin += batch_size, batch ^= 1) {
+    const int next = begin + batch_size;
+    tbb::task_group group;
+    if (next < num_faces) {
+      group.run([&, next, batch] { precompute(next, batch_factors[batch ^ 1]); });
     }
-    Mesh::SubdFace face = params.mesh->get_subd_face(f);
-    const Patch *patch = (const Patch *)(((char *)patches) +
-                                         (face.ptex_offset * patches_byte_stride));
-    if (face.is_quad()) {
-      split_quad(face, f, patch);
+
+    const int end = min(next, num_faces);
+    for (int f = begin; f < end; f++) {
+      if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
+        break;
+      }
+      const vector<EdgeFactor> &factors = batch_factors[batch][f - begin];
+      precomputed_begin = factors.data();
+      precomputed_next = precomputed_begin;
+      precomputed_end = precomputed_begin + factors.size();
+      split_face(patches, patches_byte_stride, f);
     }
-    else {
-      split_ngon(face, f, patch, patches_byte_stride);
+    group.wait();
+
+    if (params.progress && (params.progress->get_cancel() || params.progress->get_error())) {
+      break;
     }
   }
+
+  precomputed_begin = precomputed_next = precomputed_end = nullptr;
 }
 

+/* Packed table of an object attribute, using the same table choice as
+ * AttributeTableBuilder::add() for object elements. Returns the table index in
+ * AttrKernelDataType order and the size of one step in table elements. */
+static int object_attribute_table(const TypeDesc type, size_t &units_per_step)
+{
+  units_per_step = 1;
+  if (type == TypeFloat) {
+    return int(AttrKernelDataType::FLOAT);
+  }
+  if (type == TypeFloat2) {
+    return int(AttrKernelDataType::FLOAT2);
+  }
+  if (type == TypeMatrix) {
+    units_per_step = 3;
+    return int(AttrKernelDataType::FLOAT4);
+  }
+  if (type == TypeQuaternion) {
+    return int(AttrKernelDataType::QUATERNION);
+  }
+  if (type == TypePackedSphericalHarmonicsRest) {
+    return int(AttrKernelDataType::SPHERICAL_HARMONICS_REST);
+  }
+  if (type == TypeFloat4 || type == TypeRGBA) {
+    return int(AttrKernelDataType::FLOAT4);
+  }
+  return int(AttrKernelDataType::FLOAT3);
+}
+
+static size_t object_attribute_table_unit(const int table)
+{
+  switch (AttrKernelDataType(table)) {
+    case AttrKernelDataType::FLOAT:
+      return sizeof(float);
+    case AttrKernelDataType::FLOAT2:
+      return sizeof(float2);
+    case AttrKernelDataType::FLOAT4:
+      return sizeof(float4);
+    case AttrKernelDataType::QUATERNION:
+      return sizeof(Quaternion);
+    case AttrKernelDataType::SPHERICAL_HARMONICS_REST:
+      return sizeof(PackedSphericalHarmonicsRest);
+    default:
+      return sizeof(packed_float3);
+  }
+}
+
+static char *object_attribute_table_data(DeviceScene *dscene, const int table)
+{
+  switch (AttrKernelDataType(table)) {
+    case AttrKernelDataType::FLOAT:
+      return reinterpret_cast<char *>(dscene->attributes_float.data());
+    case AttrKernelDataType::FLOAT2:
+      return reinterpret_cast<char *>(dscene->attributes_float2.data());
+    case AttrKernelDataType::FLOAT4:
+      return reinterpret_cast<char *>(dscene->attributes_float4.data());
+    case AttrKernelDataType::QUATERNION:
+      return reinterpret_cast<char *>(dscene->attributes_quaternion.data());
+    case AttrKernelDataType::SPHERICAL_HARMONICS_REST:
+      return reinterpret_cast<char *>(dscene->attributes_spherical_harmonics_rest.data());
+    default:
+      return reinterpret_cast<char *>(dscene->attributes_float3.data());
+  }
+}
+
+/* One stored object attribute: where its steps go in the packed tables and
+ * where their source values are. */
+struct ObjectAttributeValues {
+  const ParamValue *param;
+  const ParamValue *sampled;
+  int table;
+  size_t offset_bytes;
+  size_t step_bytes;
+  int steps;
+};
+
+/* Pair the attributes the object would store now with the previous requests.
+ * Returns false unless converting the object again would produce exactly the
+ * previous requests (names, types, motion samples, bake hold and table
+ * extents); values are not compared here. */
+template<typename F>
+static bool match_object_attributes(const Scene *scene,
+                                    const Object &object,
+                                    const vector<vector<ustring>> &object_names,
+                                    const AttributeRequestSet &previous,
+                                    const size_t table_sizes[int(AttrKernelDataType::NUM)],
+                                    const F &visit)
+{
+  const Geometry *geom = object.get_geometry();
+  if (geom == nullptr || geom->index >= scene->geometry.size() ||
+      scene->geometry[geom->index] != geom)
+  {
+    return false;
+  }
+  const vector<ustring> &names = object_names[geom->index];
+
+  size_t k = 0;
+  for (const ParamValue &param : object.attributes) {
+    if (std::find(names.begin(), names.end(), param.name()) == names.end()) {
+      continue;
+    }
+    if (k == previous.requests.size()) {
+      return false;
+    }
+    const AttributeRequest &req = previous.requests[k++];
+    if (req.name != param.name() || req.std != ATTR_STD_NONE || req.type != param.type() ||
+        req.desc.element != ATTR_ELEMENT_OBJECT)
+    {
+      return false;
+    }
+
+    const ParamValue *sampled = nullptr;
+    for (const ParamValue &value : object.attribute_motion) {
+      if (value.name() == param.name()) {
+        sampled = &value;
+        break;
+      }
+    }
+    int steps = 0;
+    uint object_motion = 0;
+    if (sampled) {
+      steps = sampled->nvalues();
+      if (sampled->type() != param.type() || steps < 3 || steps > 129 || (steps & 1) == 0) {
+        return false;
+      }
+      object_motion = uint(steps) >> 1;
+      if (std::find(object.attribute_motion_displacement_hold.begin(),
+                    object.attribute_motion_displacement_hold.end(),
+                    param.name()) != object.attribute_motion_displacement_hold.end())
+      {
+        object_motion |= 128;
+      }
+    }
+    if (req.desc.object_motion != object_motion) {
+      return false;
+    }
+
+    size_t units_per_step = 1;
+    const int table = object_attribute_table(param.type(), units_per_step);
+    const size_t unit = object_attribute_table_unit(table);
+    const size_t step_bytes = unit * units_per_step;
+    if (req.desc.offset < 0 || size_t(param.datasize()) != step_bytes ||
+        size_t(req.desc.offset) + units_per_step * (steps + 1) > table_sizes[table])
+    {
+      return false;
+    }
+    visit(ObjectAttributeValues{
+        &param, sampled, table, size_t(req.desc.offset) * unit, step_bytes, steps});
+  }
+  return k == previous.requests.size();
+}
+
+/* True if every object would produce the requests of the last completed update. */
+static bool object_attribute_requests_unchanged(
+    const Scene *scene,
+    const vector<vector<ustring>> &object_names,
+    const vector<AttributeRequestSet> &previous,
+    const size_t table_sizes[int(AttrKernelDataType::NUM)])
+{
+  if (previous.size() != scene->objects.size()) {
+    return false;
+  }
+  std::atomic<bool> unchanged = true;
+  parallel_for(
+      blocked_range<size_t>(0, scene->objects.size(), 1024), [&](const blocked_range<size_t> &r) {
+        for (size_t i = r.begin(); i != r.end(); i++) {
+          if (!unchanged.load(std::memory_order_relaxed)) {
+            return;
+          }
+          if (!match_object_attributes(scene,
+                                       *scene->objects[i],
+                                       object_names,
+                                       previous[i],
+                                       table_sizes,
+                                       [](const ObjectAttributeValues &) {}))
+          {
+            unchanged = false;
+          }
+        }
+      });
+  return unchanged;
+}
+
+/* Write object attribute values at their previous offsets. Tables that kept
+ * their allocation are only written, and marked modified, where a value differs. */
+static void write_object_attribute_values(DeviceScene *dscene,
+                                          const Scene *scene,
+                                          const vector<vector<ustring>> &object_names,
+                                          const vector<AttributeRequestSet> &previous,
+                                          const size_t table_sizes[int(AttrKernelDataType::NUM)],
+                                          const bool table_kept[int(AttrKernelDataType::NUM)],
+                                          bool table_modified[int(AttrKernelDataType::NUM)])
+{
+  char *tables[int(AttrKernelDataType::NUM)];
+  std::atomic<bool> modified[int(AttrKernelDataType::NUM)];
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    tables[table] = object_attribute_table_data(dscene, table);
+    modified[table] = false;
+  }
+  parallel_for(
+      blocked_range<size_t>(0, scene->objects.size(), 1024), [&](const blocked_range<size_t> &r) {
+        for (size_t i = r.begin(); i != r.end(); i++) {
+          match_object_attributes(
+              scene,
+              *scene->objects[i],
+              object_names,
+              previous[i],
+              table_sizes,
+              [&](const ObjectAttributeValues &values) {
+                char *dst = tables[values.table] + values.offset_bytes;
+                for (int step = 0; step <= values.steps; step++) {
+                  const char *src = step == 0 ? static_cast<const char *>(values.param->data()) :
+                                                static_cast<const char *>(values.sampled->data()) +
+                                                    (step - 1) * values.step_bytes;
+                  char *step_dst = dst + step * values.step_bytes;
+                  if (!table_kept[values.table] || memcmp(step_dst, src, values.step_bytes) != 0) {
+                    memcpy(step_dst, src, values.step_bytes);
+                    modified[values.table] = true;
+                  }
+                }
+              });
+        }
+      });
+  for (int table = 0; table < int(AttrKernelDataType::NUM); table++) {
+    table_modified[table] = modified[table];
+  }
+}

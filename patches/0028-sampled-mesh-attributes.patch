diff --git a/src/kernel/geom/triangle.h b/src/kernel/geom/triangle.h
index fd0cc963274efe238e63efbbbe360f27fc066774..a3be9252f2257f7a267afaa04d59f47a799788ae 100644
--- a/src/kernel/geom/triangle.h
+++ b/src/kernel/geom/triangle.h
@@ -315,7 +315,28 @@ ccl_device T triangle_attribute(KernelGlobals kg,
     }
 
     BaseT f[3];
-    attribute_data_fetch_3<BaseT>(kg, desc.element, desc.offset, i0, i1, i2, f);
+    const int steps = kernel_data_fetch(objects, sd->object).num_geom_steps;
+    if ((desc.element & ATTR_ELEMENT_IS_MOTION) && steps > 1 && sd->time >= 0.0f) {
+      const float time = saturatef(sd->time) * (steps - 1);
+      const int step = min(int(time), steps - 2);
+      const float factor = time - step;
+      const int centre = (steps - 1) / 2;
+      const int first = step == centre ? 0 : step < centre ? step + 1 : step;
+      const int next = step + 1;
+      const int second = next == centre ? 0 : next < centre ? next + 1 : next;
+      const auto object = kernel_data_fetch(objects, sd->object);
+      const int stride = (desc.element & ATTR_ELEMENT_VERTEX) ? object.numverts :
+                                                               object.numprims * 3;
+      BaseT other[3];
+      attribute_data_fetch_3<BaseT>(kg, desc.element, desc.offset + first * stride, i0, i1, i2, f);
+      attribute_data_fetch_3<BaseT>(kg, desc.element, desc.offset + second * stride, i0, i1, i2, other);
+      for (int i = 0; i < 3; i++) {
+        f[i] = (1.0f - factor) * f[i] + factor * other[i];
+      }
+    }
+    else {
+      attribute_data_fetch_3<BaseT>(kg, desc.element, desc.offset, i0, i1, i2, f);
+    }
 
     if constexpr (is_dual_v<T>) {
       T result;

+++ b/src/kernel/integrator/volume_shader.h
@@ -374,11 +374,12 @@ ccl_device_inline void volume_shader_motion_blur(KernelGlobals kg,
   kernel_assert(is_attribute_found(v_desc));
 
   const float3 P = sd->P;
-  const float velocity_scale =
-      kernel_data_fetch(objects, sd->object).mesh_volume.volume_velocity_scale;
-  const float time_offset = kernel_data.cam.motion_position == MOTION_POSITION_CENTER ? 0.5f :
+  const float velocity_scale = kernel_data_fetch(objects, sd->object).mesh_volume.volume_velocity_scale;
+  const float host_offset = kernel_data_fetch(objects, sd->object).velocity_time_offset;
+  const float time_offset = host_offset >= 0.0f ? host_offset :
+                           kernel_data.cam.motion_position == MOTION_POSITION_CENTER ? 0.5f :
                                                                                         0.0f;
-  const float time = kernel_data.cam.motion_position == MOTION_POSITION_END ?
+  const float time = host_offset < 0.0f && kernel_data.cam.motion_position == MOTION_POSITION_END ?
                          (1.0f - kernel_data.cam.shuttertime) + sd->time :
                          sd->time;
 

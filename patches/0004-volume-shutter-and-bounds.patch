 CCL_NAMESPACE_BEGIN
 
@@ -38,6 +41,8 @@ NODE_DEFINE(Volume)
   SOCKET_FLOAT(step_size, "Step Size", 0.0f);
   SOCKET_BOOLEAN(object_space, "Object Space", false);
   SOCKET_FLOAT(velocity_scale, "Velocity Scale", 1.0f);
+  SOCKET_FLOAT(velocity_time_offset, "Velocity Time Offset", -1.0f);
+  SOCKET_VECTOR(velocity_max_distance, "Velocity Maximum Distance", make_float3(-1.0f));
 
   return type;
 }
@@ -675,7 +680,9 @@ void GeometryManager::create_volume_mesh(const Scene *scene, Volume *volume, Pro
         nanovdb::HostBuffer::createFull(image->memory_size(), image->host_pointer));
 
     /* Add padding based on the maximum velocity vector. */
-    if (attr.std == ATTR_STD_VOLUME_VELOCITY && scene->need_motion() != Scene::MOTION_NONE) {
+    if (attr.std == ATTR_STD_VOLUME_VELOCITY && scene->need_motion() != Scene::MOTION_NONE &&
+        volume->get_velocity_max_distance().x < 0.0f)
+    {
       pad_size = max(pad_size,
                      estimate_required_velocity_padding(grid, volume->get_velocity_scale()));
     }
@@ -689,6 +696,29 @@ void GeometryManager::create_volume_mesh(const Scene *scene, Volume *volume, Pro
     return;
   }
 
+  /* Host bounds cover all stored velocities, including sparse outliers. Convert
+   * after merging grids: the final topology can have a different affine map. */
+  const float3 distance = volume->get_velocity_max_distance();
+  if (scene->need_motion() != Scene::MOTION_NONE && volume->get_velocity_scale() != 0.0f &&
+      distance.x >= 0.0f)
+  {
+    const auto &map = builder.topology_grid->transform();
+    const openvdb::Vec3d origin = map.worldToIndex(openvdb::Vec3d(0.0));
+    double padding = 0.0;
+    for (int corner = 0; corner < 8; ++corner) {
+      const openvdb::Vec3d displacement((corner & 1) ? distance.x : -distance.x,
+                                       (corner & 2) ? distance.y : -distance.y,
+                                       (corner & 4) ? distance.z : -distance.z);
+      const openvdb::Vec3d index_distance = map.worldToIndex(displacement) - origin;
+      padding = std::max({padding, std::fabs(index_distance[0]), std::fabs(index_distance[1]),
+                          std::fabs(index_distance[2])});
+    }
+    if (!std::isfinite(padding) || padding > double(std::numeric_limits<int>::max() - 2)) {
+      throw std::runtime_error("Volume velocity padding exceeds the supported index range");
+    }
+    /* Sum the interpolation support and motion envelope instead of taking max. */
+    pad_size += int(std::ceil(padding));
+  }
   builder.add_padding(pad_size);
 
   /* Create mesh. */

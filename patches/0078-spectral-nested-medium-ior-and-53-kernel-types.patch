 /* Attributes
  *
  * We support an arbitrary number of attributes on various mesh elements.
@@ -359,6 +373,16 @@ ccl_device_inline float4 attribute_object_lerp(const float4 a, const float4 b, c
                      attribute_object_lerp(a.w, b.w, factor));
 }
 
+ccl_device_inline Quaternion attribute_object_lerp(const Quaternion a,
+                                                   const Quaternion b,
+                                                   const float factor)
+{
+  return make_quaternion(attribute_object_lerp(a.w, b.w, factor),
+                         attribute_object_lerp(a.x, b.x, factor),
+                         attribute_object_lerp(a.y, b.y, factor),
+                         attribute_object_lerp(a.z, b.z, factor));
+}

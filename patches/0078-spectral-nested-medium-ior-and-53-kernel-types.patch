diff --git a/src/kernel/closure/dispersion.h b/src/kernel/closure/dispersion.h
new file mode 100644
index 0000000000000000000000000000000000000000..2a6ea948df31088d6e9c7dbb53e137585cc50ba2
--- /dev/null
+++ b/src/kernel/closure/dispersion.h
@@ -0,0 +1,31 @@
+/* SPDX-FileCopyrightText: 2026 Cycles for Houdini contributors
+ * SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+#include "util/math.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Absolute IOR at a wavelength in micrometres, from the d-line IOR and inverse
+ * Abbe number. Keep this shared by CPU/GPU closures and physical contract tests. */
+ccl_device_inline float bsdf_cauchy_ior(const float ior,
+                                       const float inv_abbe,
+                                       const float wavelength)
+{
+  constexpr float lambda_d = 0.5876f;
+  constexpr float lambda_C = 0.6563f;
+  constexpr float lambda_F = 0.4861f;
+  constexpr float fac = 1.0f / (1.0f / (lambda_F * lambda_F) - 1.0f / (lambda_C * lambda_C));
+  constexpr float inv_lambda_d_sq = 1.0f / (lambda_d * lambda_d);
+  const float B = (ior - 1.0f) * inv_abbe * fac;
+  const float A = ior - B * inv_lambda_d_sq;
+  return A + B / sqr(wavelength);
+}
+
+/* Every physical IOR is positive. The sign in a nested stack entry carries
+ * wavelength dependence without changing the CPU/GPU path-state layout. */
+ccl_device_inline float nested_ior_encode(const float ior, const bool dispersion)
+{
+  return dispersion ? -ior : ior;
+}
+
+CCL_NAMESPACE_END

diff --git a/src/scene/light_tree_cache.cpp b/src/scene/light_tree_cache.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..e1774a4d8e6a932216900962afa776b08b35ce14
--- /dev/null
+++ b/src/scene/light_tree_cache.cpp
@@ -0,0 +1,360 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "scene/light_tree_cache.h"
+#include "scene/light_tree.h"
+#include "scene/mesh.h"
+#include "scene/object.h"
+#include "scene/shader.h"
+#include "util/progress.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+
+CCL_NAMESPACE_BEGIN
+namespace {
+constexpr size_t cache_budget = 256ull * 1024 * 1024;
+constexpr size_t cache_entry_limit = 1024;
+
+bool environment_flag(const char *name)
+{
+  const char *value = std::getenv(name);
+  return value && std::strcmp(value, "1") == 0;
+}
+
+struct ShaderKey {
+  int sampling;
+  float x, y, z;
+  bool operator==(const ShaderKey &b) const
+  {
+    return sampling == b.sampling && x == b.x && y == b.y && z == b.z;
+  }
+};
+
+struct MeshKey {
+  uint64_t revision, membership;
+  size_t vertices, triangles;
+  bool transformed, negative;
+  vector<ShaderKey> shaders;
+  bool operator==(const MeshKey &b) const
+  {
+    return revision == b.revision && membership == b.membership && vertices == b.vertices &&
+           triangles == b.triangles && transformed == b.transformed && negative == b.negative &&
+           shaders == b.shaders;
+  }
+};
+
+MeshKey mesh_key(Scene *scene, Mesh *mesh, int object_id)
+{
+  const Object *object = scene->objects[object_id];
+  MeshKey key;
+  key.revision = mesh->light_tree_revision;
+  key.membership = object->get_light_set_membership();
+  key.vertices = mesh->num_verts();
+  key.triangles = mesh->num_triangles();
+  key.transformed = mesh->transform_applied;
+  key.negative = key.transformed && transform_negative_scale(object->get_tfm());
+  key.shaders.reserve(mesh->get_used_shaders().size());
+  for (Node *node : mesh->get_used_shaders()) {
+    const Shader *shader = static_cast<const Shader *>(node);
+    key.shaders.push_back({int(shader->emission_sampling), shader->emission_estimate.x,
+                           shader->emission_estimate.y, shader->emission_estimate.z});
+  }
+  return key;
+}
+
+struct CachedNode {
+  /* Store scalar components explicitly. float3 alignment and an untagged
+   * union's unused indices otherwise cost almost another node per node.
+   * This is exact float storage, not quantization of lighting bounds. */
+  float minimum[3], maximum[3], axis[3], theta_o, theta_e, energy;
+  uint bit_trail;
+  int type, first, second;
+
+  void set_measure(const LightTreeMeasure &measure)
+  {
+    for (int n = 0; n < 3; ++n) {
+      minimum[n] = measure.bbox.min[n];
+      maximum[n] = measure.bbox.max[n];
+      axis[n] = measure.bcone.axis[n];
+    }
+    theta_o = measure.bcone.theta_o;
+    theta_e = measure.bcone.theta_e;
+    energy = measure.energy;
+  }
+
+  LightTreeMeasure measure() const
+  {
+    LightTreeMeasure result;
+    result.bbox.min = make_float3(minimum[0], minimum[1], minimum[2]);
+    result.bbox.max = make_float3(maximum[0], maximum[1], maximum[2]);
+    result.bcone = OrientationBounds(make_float3(axis[0], axis[1], axis[2]), theta_o, theta_e);
+    result.energy = energy;
+    return result;
+  }
+};
+static_assert(sizeof(CachedNode) == 64);
+
+/* These are all triangle fields consumed by flattening after construction.
+ * Centroids/bounds are not rescanned on a hit. Nonuniform instance measures
+ * retain the upstream transformed-triangle recount. */
+struct CachedTriangle {
+  int primitive;
+  float energy, theta_o, theta_e;
+};
+}  // namespace
+
+struct LightTreeMeshCache::Entry {
+  MeshKey key;
+  vector<CachedNode> nodes;
+  vector<CachedTriangle> triangles;
+  uint64_t stamp = 0;
+  size_t bytes() const
+  {
+    return sizeof(*this) + key.shaders.capacity() * sizeof(ShaderKey) +
+           nodes.capacity() * sizeof(CachedNode) + triangles.capacity() * sizeof(CachedTriangle);
+  }
+};
+
+struct LightTreeMeshCache::Impl {
+  std::unordered_map<Mesh *, Entry> entries;
+  size_t bytes = 0, hits = 0, misses = 0, evictions = 0;
+  uint64_t stamp = 0, build = 0;
+  bool enabled = !environment_flag("CYCLES_HOUDINI_DISABLE_LIGHT_TREE_CACHE");
+  bool profiling = environment_flag("CYCLES_HOUDINI_PROFILE_LIGHT_TREE");
+
+  void erase(std::unordered_map<Mesh *, Entry>::iterator it)
+  {
+    bytes -= it->second.bytes();
+    entries.erase(it);
+  }
+};
+
+LightTreeMeshCache::LightTreeMeshCache() : impl_(make_unique<Impl>()) {}
+
+LightTreeMeshCache::~LightTreeMeshCache()
+{
+  const size_t released = impl_->bytes;
+  clear();
+  if (impl_->profiling) {
+    std::fprintf(stderr, "CH_LIGHT_TREE_CACHE {\"retired\":true,\"released_bytes\":%zu,\"bytes\":0}\n", released);
+  }
+}
+
+void LightTreeMeshCache::begin_build()
+{
+  ++impl_->build;
+  impl_->hits = impl_->misses = impl_->evictions = 0;
+}
+
+const LightTreeMeshCache::Entry *LightTreeMeshCache::find(Scene *scene, Mesh *mesh, int object_id)
+{
+  auto &i = *impl_;
+  if (!i.enabled) {
+    return nullptr;
+  }
+  auto found = i.entries.find(mesh);
+  if (found != i.entries.end()) {
+    if (found->second.key == mesh_key(scene, mesh, object_id)) {
+      found->second.stamp = ++i.stamp;
+      ++i.hits;
+      return &found->second;
+    }
+    i.erase(found);
+  }
+  ++i.misses;
+  return nullptr;
+}
+
+void LightTreeMeshCache::restore(const Entry &entry,
+                                 LightTree &builder,
+                                 LightTreeNode *root,
+                                 int object_id,
+                                 vector<LightTreeEmitter> &emitters,
+                                 Progress &progress) const
+{
+  const int start = emitters.size();
+  for (size_t n = 0; n < entry.triangles.size(); ++n) {
+    if ((n & 255) == 0 && progress.get_cancel()) {
+      return;
+    }
+    const auto &triangle = entry.triangles[n];
+    auto &emitter = emitters.emplace_back();
+    emitter.prim_id = triangle.primitive;
+    emitter.object_id = object_id;
+    emitter.light_set_membership = entry.key.membership;
+    emitter.measure = LightTreeMeasure::empty;
+    emitter.measure.energy = triangle.energy;
+    emitter.measure.bcone.theta_o = triangle.theta_o;
+    emitter.measure.bcone.theta_e = triangle.theta_e;
+    emitter.centroid = zero_float3();
+  }
+  const auto restore_node = [&](const auto &self, int index, LightTreeNode *target) -> void {
+    if (progress.get_cancel()) {
+      return;
+    }
+    const auto &node = entry.nodes[index];
+    target->measure = node.measure();
+    target->bit_trail = node.bit_trail;
+    target->object_id = object_id;
+    /* Local primitives currently share their representative object's mask.
+     * Store validates this invariant rather than dropping linking metadata. */
+    target->light_link = entry.triangles.empty() ? LightTreeLightLink() :
+                                                 LightTreeLightLink(entry.key.membership);
+    if (node.type & LIGHT_TREE_LEAF) {
+      target->make_leaf(start + node.first, node.second);
+    }
+    else {
+      target->variant_type = LightTreeNode::Inner();
+      target->get_inner().children[0] = builder.create_node(LightTreeMeasure::empty, 0);
+      target->get_inner().children[1] = builder.create_node(LightTreeMeasure::empty, 0);
+      self(self, node.first, target->get_inner().children[0].get());
+      self(self, node.second, target->get_inner().children[1].get());
+    }
+    target->type = node.type;
+  };
+  restore_node(restore_node, 0, root);
+}
+
+void LightTreeMeshCache::store(Scene *scene,
+                               Mesh *mesh,
+                               int object_id,
+                               const LightTreeNode *root,
+                               const vector<LightTreeEmitter> &emitters,
+                               int start,
+                               int end,
+                               Progress &progress)
+{
+  auto &i = *impl_;
+  if (!i.enabled || progress.get_cancel()) {
+    return;
+  }
+  const size_t primitives = size_t(end - start);
+  if (primitives > cache_budget / sizeof(CachedTriangle)) {
+    return;
+  }
+  Entry entry;
+  entry.key = mesh_key(scene, mesh, object_id);
+  const size_t fixed_bytes = sizeof(Entry) + entry.key.shaders.capacity() * sizeof(ShaderKey) +
+                             primitives * sizeof(CachedTriangle);
+  if (fixed_bytes >= cache_budget) {
+    return;
+  }
+  /* Count the actual nodes rather than reserving two per triangle. Leaves can
+   * contain several primitives; that upper bound would retain large unused
+   * capacities and unnecessarily exclude otherwise affordable meshes. */
+  const size_t node_limit = (cache_budget - fixed_bytes) / sizeof(CachedNode);
+  size_t node_count = 0;
+  bool valid = true;
+  const auto count_nodes = [&](const auto &self, const LightTreeNode *node) -> void {
+    if (!valid || progress.get_cancel() || ++node_count > node_limit ||
+        !node->light_link.shareable ||
+        node->light_link.set_membership != (primitives ? entry.key.membership : 0)) {
+      valid = false;
+      return;
+    }
+    if (!node->is_leaf()) {
+      self(self, node->get_inner().children[0].get());
+      self(self, node->get_inner().children[1].get());
+    }
+  };
+  count_nodes(count_nodes, root);
+  if (!valid) {
+    return;
+  }
+  const size_t estimate = fixed_bytes + node_count * sizeof(CachedNode);
+  /* Evict before reserving the candidate's large vectors, so retained cache
+   * capacity plus candidate capacity stays within the same bound. */
+  while (!i.entries.empty() &&
+         (i.bytes + estimate > cache_budget || i.entries.size() >= cache_entry_limit)) {
+    auto oldest = std::min_element(i.entries.begin(), i.entries.end(), [](const auto &a, const auto &b) {
+      return a.second.stamp < b.second.stamp;
+    });
+    i.erase(oldest);
+    ++i.evictions;
+  }
+  entry.nodes.reserve(node_count);
+  entry.triangles.reserve(primitives);
+  for (int n = start; n < end; ++n) {
+    if ((n & 255) == 0 && progress.get_cancel()) {
+      return;
+    }
+    const auto &emitter = emitters[n];
+    entry.triangles.push_back({emitter.prim_id, emitter.measure.energy,
+                               emitter.measure.bcone.theta_o, emitter.measure.bcone.theta_e});
+  }
+  const auto snapshot = [&](const auto &self, const LightTreeNode *node) -> int {
+    if (!valid || progress.get_cancel()) {
+      valid = false;
+      return -1;
+    }
+    const int index = entry.nodes.size();
+    entry.nodes.emplace_back();
+    CachedNode value;
+    value.set_measure(node->measure);
+    value.bit_trail = node->bit_trail;
+    value.type = node->type;
+    value.first = value.second = -1;
+    if (node->is_leaf()) {
+      value.first = node->get_leaf().first_emitter_index - start;
+      value.second = node->get_leaf().num_emitters;
+    }
+    else {
+      value.first = self(self, node->get_inner().children[0].get());
+      value.second = self(self, node->get_inner().children[1].get());
+    }
+    entry.nodes[index] = value;
+    return index;
+  };
+  snapshot(snapshot, root);
+  if (!valid || progress.get_cancel() || entry.bytes() > cache_budget) {
+    return;
+  }
+  entry.stamp = ++i.stamp;
+  const size_t bytes = entry.bytes();
+  const auto inserted = i.entries.emplace(mesh, std::move(entry));
+  if (inserted.second) {
+    i.bytes += bytes;
+  }
+}
+
+void LightTreeMeshCache::prune(const std::function<bool(Mesh *)> &is_live)
+{
+  auto &i = *impl_;
+  for (auto it = i.entries.begin(); it != i.entries.end();) {
+    if (!is_live(it->first)) {
+      auto stale = it++;
+      i.erase(stale);
+    }
+    else {
+      ++it;
+    }
+  }
+  if (i.entries.empty()) {
+    i.entries.rehash(0);
+  }
+}
+
+void LightTreeMeshCache::clear()
+{
+  impl_->entries.clear();
+  impl_->entries.rehash(0);
+  impl_->bytes = 0;
+}
+
+void LightTreeMeshCache::report(bool complete) const
+{
+  const auto &i = *impl_;
+  if (i.profiling) {
+    std::fprintf(stderr,
+                 "CH_LIGHT_TREE_CACHE {\"build\":%llu,\"enabled\":%s,\"complete\":%s,"
+                 "\"hits\":%zu,\"misses\":%zu,\"evictions\":%zu,\"entries\":%zu,"
+                 "\"bytes\":%zu,\"budget_bytes\":%zu}\n",
+                 static_cast<unsigned long long>(i.build), i.enabled ? "true" : "false",
+                 complete ? "true" : "false", i.hits, i.misses, i.evictions, i.entries.size(),
+                 i.bytes, cache_budget);
+  }
+}
+
+CCL_NAMESPACE_END

Rationale: Unsubdivided mesh shading can retain undisplaced positions/normals and a validated basis rather than recomputing true displacement on every field edit.
Contract: retained mesh shading
Tests: tests/houdini_shading_payload_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/scene/geometry.cpp b/src/scene/geometry.cpp
index ea2f8e8468f60d8adab5fea220ab5a3c2ec2787a..957c4aae0a7718854cd0f0277c94f9666203517f 100644
--- a/src/scene/geometry.cpp
+++ b/src/scene/geometry.cpp
@@ -990,7 +990,7 @@ void GeometryManager::device_update(Device *device,
 
     /* Apply tangents for generated and UVs (if any need them) or remove if not needed */
     mesh->update_tangents(scene, true, &progress);
-    if (!mesh->has_true_displacement()) {
+    if (!mesh->has_true_displacement() || mesh->can_reuse_displacement()) {
       mesh->update_tangents(scene, false, &progress);
     }
   });
@@ -1261,6 +1261,9 @@ void GeometryManager::device_update(Device *device,
     if (geom->is_mesh()) {
       Mesh *mesh = static_cast<Mesh *>(geom);
       mesh->subd_attributes.clear_modified();
+      if (mesh->geometry_update_completed) {
+        mesh->geometry_update_completed(*mesh);
+      }
     }
   }
 

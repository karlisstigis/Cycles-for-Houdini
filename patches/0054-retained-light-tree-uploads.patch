-static void light_tree_node_copy_to_device(KernelLightTreeNode &knode,
+template<typename T>
+static void light_tree_store(T &destination,
+                              const T &prepared,
+                              const bool compare,
+                              std::atomic<bool> &changed)
+{
+  static_assert(std::is_trivially_copyable_v<T>);
+  if (compare && std::memcmp(&destination, &prepared, sizeof(T)) == 0) {
+    return;
+  }
+  std::memcpy(&destination, &prepared, sizeof(T));
+  if (compare) {
+    changed.store(true, std::memory_order_relaxed);
+  }
+}

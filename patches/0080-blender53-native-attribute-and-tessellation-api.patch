Rationale: Explicit AttrKernelDataType indexing and the tessellation spelling adapt older retained-attribute/subdivision fork work to the pinned 5.3 API.
Contract: Use explicit indices for the Blender 5.3 attribute-buffer enum class and retain subdivision reuse with the corrected tessellation API spelling.
Tests: tests/core_subdivision_shading_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/scene/geometry.h b/src/scene/geometry.h
index f04f32f8bec68cc62885043d01951beee44b2e08..a166006537718657a2e2acae5d4ddc74c18d9b53 100644
--- a/src/scene/geometry.h
+++ b/src/scene/geometry.h
@@ -305,7 +305,7 @@ class GeometryManager {
              element == b.element && count == b.count && steps == b.steps;
     }
   };
-  vector<AttributeLayoutSpan> attribute_layout[AttrKernelDataType::NUM + 3];
+  vector<AttributeLayoutSpan> attribute_layout[int(AttrKernelDataType::NUM) + 3];
   bool attribute_layout_valid = false;
 
   bool displace(Device *device, Scene *scene, Mesh *mesh, Progress &progress);
diff --git a/src/scene/geometry_attributes.cpp b/src/scene/geometry_attributes.cpp
index 4e13ac6e643b78da8221308fdc132e9e8bbc2291..dbfb75a4d089010be24631c1da1263dbc77b55d5 100644
--- a/src/scene/geometry_attributes.cpp
+++ b/src/scene/geometry_attributes.cpp
@@ -740,13 +740,13 @@ void GeometryManager::device_update_attributes(Device *device,
    * take 2x of overall attribute memory usage.
    */
   AttributeTableBuilder builder(dscene);
-  vector<AttributeLayoutSpan> next_layout[AttrKernelDataType::NUM + 3];
+  vector<AttributeLayoutSpan> next_layout[int(AttrKernelDataType::NUM) + 3];
   const auto layout_index = [](const Geometry *geom, const Attribute *attr) -> int {
     if (attr->element & ATTR_ELEMENT_VOXEL) {
       return -1;
     }
     if (attr->std == ATTR_STD_POSITION) {
-      return AttrKernelDataType::NUM + (geom->is_hair() ? 1 : geom->is_pointcloud() ? 2 : 0);
+      return int(AttrKernelDataType::NUM) + (geom->is_hair() ? 1 : geom->is_pointcloud() ? 2 : 0);
     }
     return int(Attribute::kernel_type(*attr));
   };
@@ -803,8 +803,8 @@ void GeometryManager::device_update_attributes(Device *device,
     }
   }
 
-  bool layout_changed[AttrKernelDataType::NUM + 3];
-  for (int index = 0; index < AttrKernelDataType::NUM + 3; ++index) {
+  bool layout_changed[int(AttrKernelDataType::NUM) + 3];
+  for (int index = 0; index < int(AttrKernelDataType::NUM) + 3; ++index) {
     layout_changed[index] = !attribute_layout_valid || next_layout[index] != attribute_layout[index];
   }
   /* A cancelled upload cannot leave a partially rewritten table certified. */
@@ -842,7 +842,7 @@ void GeometryManager::device_update_attributes(Device *device,
       }
       return dscene->tri_verts.need_realloc();
     }
-    return attributes_need_realloc[Attribute::kernel_type(*attr)];
+    return attributes_need_realloc[int(Attribute::kernel_type(*attr))];
   };
 
   /* Fill in attributes. */
@@ -934,7 +934,7 @@ void GeometryManager::device_update_attributes(Device *device,
   if (progress.get_cancel()) {
     return;
   }
-  for (int index = 0; index < AttrKernelDataType::NUM + 3; ++index) {
+  for (int index = 0; index < int(AttrKernelDataType::NUM) + 3; ++index) {
     attribute_layout[index] = std::move(next_layout[index]);
   }
   attribute_layout_valid = true;

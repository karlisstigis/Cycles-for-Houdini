+  const int64_t inner_verts = sub.calc_num_inner_verts();
   if (params.triangle_limit &&
-      uint64_t(num_triangles) + sub.calc_num_triangles() > params.triangle_limit) {
+      uint64_t(num_triangles) + triangles > params.triangle_limit) {
     if (params.progress) {
       params.progress->set_error("Subdivision triangle budget exceeded for " +
                                  params.mesh->name.string());
     }
     return;
   }
+  if (triangles > std::numeric_limits<int>::max() - num_triangles ||
+      inner_verts > std::numeric_limits<int>::max() - num_verts) {
+    if (params.progress) {
+      params.progress->set_error("Subdivision tessellation indexing limit exceeded");
+      return;
+    }
+    throw std::overflow_error("Subdivision tessellation indexing limit exceeded");
+  }
   assert(sub.edges[0].edge->T >= 1);
   assert(sub.edges[1].edge->T >= 1);
   assert(sub.edges[2].edge->T >= 1);
@@ -85,9 +105,9 @@ void DiagSplit::alloc_subpatch(SubPatch &&sub)
     assert(sub.edges[3].edge->T >= 1);
   }
 
-  sub.inner_grid_vert_offset = alloc_verts(sub.calc_num_inner_verts());
+  sub.inner_grid_vert_offset = alloc_verts(int(inner_verts));
   sub.triangles_offset = num_triangles;
-  num_triangles += sub.calc_num_triangles();
+  num_triangles += int(triangles);
 
   subpatches.push_back(std::move(sub));
 }

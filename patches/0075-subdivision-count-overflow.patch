@@ -23,6 +26,13 @@ DiagSplit::DiagSplit(const SubdParams &params_) : params(params_) {}
 
 int DiagSplit::alloc_verts(int num)
 {
+  if (num < 0 || num > std::numeric_limits<int>::max() - num_verts) {
+    if (params.progress) {

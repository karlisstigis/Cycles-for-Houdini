diff --git a/src/cmake/Modules/FindUSDHoudini.cmake b/src/cmake/Modules/FindUSDHoudini.cmake
index 7c50030ae48b8c943cfa7811e311d10ee774a15a..a43246050a1ef94a69d1e3006f9f4fc8155efef8 100644

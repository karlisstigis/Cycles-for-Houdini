Rationale: Coverage alpha should survive arbitrary RGB color transforms, and obsolete derived textures must be invalidated after correcting that route.
Contract: Process RGB while preserving texture coverage through arbitrary OCIO transforms, and invalidate derivatives produced by the earlier alpha-changing route.
Tests: tests/houdini_texture_alpha_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/util/colorspace.cpp b/src/util/colorspace.cpp
index fa540c9d5171ac3e68b133fa7132bcd6752c25b2..57e6d026b23011b697d4e5568e4555371a8a9afe 100644
--- a/src/util/colorspace.cpp
+++ b/src/util/colorspace.cpp
@@ -567,7 +567,17 @@ inline void processor_apply_pixels_rgba(const OCIO::Processor *processor,
     }
 
     if (processor) {
-      const OCIO::PackedImageDesc desc((float *)float_pixels.data(), num_rows * width, 1, 4);
+      /* Texture coverage is separate from color. Give OCIO a three-channel
+       * view of the interleaved float4 buffer, preserving artist-authored
+       * alpha even when a colorspace contains an RGBA matrix transform. */
+      const OCIO::PackedImageDesc desc((float *)float_pixels.data(),
+                                       num_rows * width,
+                                       1,
+                                       3,
+                                       OCIO::BIT_DEPTH_F32,
+                                       sizeof(float),
+                                       sizeof(float4),
+                                       num_rows * width * sizeof(float4));
       device_processor->apply(desc);
     }
 
diff --git a/src/util/image_maketx.cpp b/src/util/image_maketx.cpp
index bf0d7edfca032590c98da54e1da68a85cc5f9836..a861e0e47d6c9ab39e396a5cedcab9b7c1ee8f0c 100644
--- a/src/util/image_maketx.cpp
+++ b/src/util/image_maketx.cpp
@@ -382,6 +382,10 @@ static std::string unique_filename_tx(const string &filepath,
 
   md5.append("alpha:" + alpha_type_string(alpha_type));
 
+  /* Older OCIO derivatives may contain transformed coverage. Never reuse
+   * those files after making input color conversion RGB-only. */
+  md5.append("color_conversion:rgb_only/1");
+
   md5.append("format:" + format_type_string(format_type));
 

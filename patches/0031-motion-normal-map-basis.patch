Rationale: Normal mapping must use the tangent basis at the same shutter time as geometry; otherwise animated UV/tangent inputs yield inconsistent shading.
Contract: motion normal map basis
Tests: tests/houdini_velocity_normal_smoke.py, scripts/verify-upstream-patches.py

diff --git a/src/kernel/svm/tex_coord.h b/src/kernel/svm/tex_coord.h
index 073b658a03b10d731b408fd0007e2f048eb56738..c6a697fe2a5b4805106d5b1f06844988cd3315b8 100644
--- a/src/kernel/svm/tex_coord.h
+++ b/src/kernel/svm/tex_coord.h
@@ -278,7 +278,21 @@ ccl_device_noinline void svm_node_normal_map(KernelGlobals kg,
         linear_interpolate_strength = true;
       }
       else {
-        normal = triangle_smooth_normal_unnormalized_object_space(kg, sd);
+#ifdef __OBJECT_MOTION__
+        if (sd->type & PRIMITIVE_MOTION_TRIANGLE) {
+          /* Match the displaced surface at ray time, rather than mixing its
+           * sampled tangent with a centre-frame normal. Avoid fetching positions. */
+          normal = motion_triangle_smooth_normal(
+              kg, sd->Ng, sd->object, sd->prim, sd->u, sd->v, sd->time);
+          if (sd->object_flag & SD_OBJECT_TRANSFORM_APPLIED) {
+            object_inverse_normal_transform(kg, sd, &normal);
+          }
+        }
+        else
+#endif
+        {
+          normal = triangle_smooth_normal_unnormalized_object_space(kg, sd);
+        }
       }
     }
     else {

cmake_minimum_required(VERSION 3.24)
get_filename_component(CH_TEST_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(WITH_CYCLES_EMBREE ON)
set(WITH_EMBREE OFF CACHE BOOL "Stale unrelated Blender cache value")
include("${CH_TEST_ROOT}/cmake/cycles-embree.cmake")
if(NOT WITH_CYCLES_EMBREE OR NOT WITH_EMBREE)
  message(FATAL_ERROR "Standalone enabled option did not activate engine Embree gates")
endif()
set(WITH_CYCLES_EMBREE OFF)
include("${CH_TEST_ROOT}/cmake/cycles-embree.cmake")
if(WITH_EMBREE)
  message(FATAL_ERROR "Explicit standalone disable did not deactivate engine Embree gates")
endif()
message(STATUS "Embree standalone/engine option mapping passed")

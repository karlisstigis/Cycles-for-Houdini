# One provider for the host, worker, native final and official Hydra delegate.
file(READ "${CH_SOURCE_ROOT}/source.lock.json" CH_SDK_LOCK)
string(JSON CH_EXPECTED_HOUDINI GET "${CH_SDK_LOCK}" sdk_dependencies openimagedenoise houdini)
string(JSON CH_EXPECTED_OIDN GET "${CH_SDK_LOCK}" sdk_dependencies openimagedenoise version)
file(READ "${HOUDINI_ROOT}/toolkit/include/SYS/SYS_Version.h" CH_HOUDINI_VERSION_HEADER)
file(READ "${HOUDINI_ROOT}/toolkit/include/OpenImageDenoise/config.h" CH_OIDN_VERSION_HEADER)
string(REGEX MATCH "#define SYS_VERSION_FULL \"([^\"]+)\"" CH_HOST_VERSION_MATCH "${CH_HOUDINI_VERSION_HEADER}")
set(CH_SELECTED_HOUDINI "${CMAKE_MATCH_1}")
string(REGEX MATCH "^([0-9]+\\.[0-9]+)\\.[0-9]+$" CH_EXPECTED_MAJOR_MINOR_MATCH "${CH_EXPECTED_HOUDINI}")
set(CH_EXPECTED_MAJOR_MINOR "${CMAKE_MATCH_1}")
string(REGEX MATCH "^([0-9]+\\.[0-9]+)\\.[0-9]+$" CH_SELECTED_MAJOR_MINOR_MATCH "${CH_SELECTED_HOUDINI}")
if(NOT CH_EXPECTED_MAJOR_MINOR_MATCH OR NOT CH_SELECTED_MAJOR_MINOR_MATCH OR NOT CMAKE_MATCH_1 STREQUAL CH_EXPECTED_MAJOR_MINOR)
  message(FATAL_ERROR "Unsupported Houdini SDK ${CH_SELECTED_HOUDINI}; expected ${CH_EXPECTED_MAJOR_MINOR}.x")
endif()
string(REGEX MATCH "#define OIDN_VERSION_STRING \"([^\"]+)\"" CH_OIDN_VERSION_MATCH "${CH_OIDN_VERSION_HEADER}")
if(NOT CMAKE_MATCH_1 STREQUAL CH_EXPECTED_OIDN)
  message(FATAL_ERROR "Unsupported SDK OIDN; expected ${CH_EXPECTED_OIDN}. Do not select vendor OIDN implicitly.")
endif()
set(CH_OIDN_PROVIDER "houdini-sdk" CACHE STRING "Pinned native denoiser provider" FORCE)
set(CH_OIDN_VERSION "${CH_EXPECTED_OIDN}" CACHE STRING "Pinned SDK denoiser version" FORCE)
set(OPENIMAGEDENOISE_ROOT_DIR "${HOUDINI_ROOT}" CACHE PATH "Pinned SDK OIDN root" FORCE)
set(OPENIMAGEDENOISE_INCLUDE_DIR "${HOUDINI_ROOT}/toolkit/include" CACHE PATH "Pinned SDK OIDN headers" FORCE)
set(OPENIMAGEDENOISE_LIBRARY "${HOUDINI_ROOT}/custom/houdini/dsolib/OpenImageDenoise.lib" CACHE FILEPATH "Pinned SDK OIDN import library" FORCE)
set(OPENIMAGEDENOISE_OPENIMAGEDENOISE_LIBRARY "${OPENIMAGEDENOISE_LIBRARY}" CACHE FILEPATH "Pinned SDK OIDN import library" FORCE)
# This is an import library. Retired static oneDNN components must never remain
# selected from an older CMake cache or an unrelated system installation.
foreach(CH_OIDN_STATIC_COMPONENT COMMON DNNL_CPU DNNL_COMMON MKLDNN DNNL)
  set(OPENIMAGEDENOISE_${CH_OIDN_STATIC_COMPONENT}_LIBRARY "" CACHE FILEPATH "Unused with the SDK OIDN shared runtime" FORCE)
endforeach()
if(NOT EXISTS "${OPENIMAGEDENOISE_LIBRARY}")
  message(FATAL_ERROR "The pinned Houdini SDK OIDN import library is missing")
endif()
message(STATUS "Cycles OIDN provider: Houdini SDK ${CH_SELECTED_HOUDINI} / OIDN ${CH_EXPECTED_OIDN}")

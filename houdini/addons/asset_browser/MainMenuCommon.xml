<!-- Optional Setup component "Asset browser": adds Asset Browser to the Cycles
     main menu that the host MainMenuCommon.xml defines (same subMenu id; Houdini
     merges both files). Collect, Relink and linked-material actions are host
     menus (houdini/NetworkViewMenu.xml, houdini/OPmenu.xml; blend-import.md: Host menus). -->
<mainMenu>
  <menuBar>
    <subMenu id="cycles_main_menu">
      <label>Cycles</label>
      <modifyItem>
        <insertBefore>help_menu</insertBefore>
      </modifyItem>
      <scriptItem id="cycles_main_asset_browser">
        <label>Asset Browser</label>
        <scriptCode><![CDATA[from cycles_houdini.assets import menus
menus.open_browser("cycles_houdini_assets")]]></scriptCode>
      </scriptItem>
    </subMenu>
  </menuBar>
</mainMenu>
